# 富士ヶ丘アクセス解析Worker
PUBLIC_FUJIGAOKA_ANALYTICS_ORIGIN=https://fujigaoka-analytics-worker.hiroyukio0122.workers.dev
PUBLIC_FUJIGAOKA_ANALYTICS_SITE_ID=atawi-temple
PUBLIC_FUJIGAOKA_ANALYTICS_ENABLED=true

# Google Maps Platform
# temple.atawi.link のHTTPリファラ制限と、Maps Embed API / Maps JavaScript API のAPI制限を設定してください。
PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
PUBLIC_GOOGLE_MAPS_MAP_ID=

# Maps JavaScript API paid-SKU safety guard. Set on Cloudflare Pages, not as PUBLIC_*.
GOOGLE_MAPS_DYNAMIC_MONTHLY_CAP=9000
GOOGLE_MAPS_DYNAMIC_DISABLED=false

# 一括ジオコーディング用。公開環境には設定しないでください。
GOOGLE_MAPS_GEOCODING_KEY=
