---
interface Props {
  variant?: "temple-top" | "temple-mid" | "temple-bottom" | "home" | "index-card" | "guide-bottom";
  compact?: boolean;
}

const { variant = "temple-top", compact = false } = Astro.props;
const isTopBridge = variant === "temple-top";
const isMidBridge = variant === "temple-mid";
const isBottomBridge = variant === "temple-bottom" || variant === "guide-bottom";
const isHomeBridge = variant === "home";
const isIndexCard = variant === "index-card";
const guideUrl = "/guide/houyou-kisei/";
const searchUrl = "/search/";
---

<section
  class:list={[
    "houyou-bridge",
    `houyou-bridge--${variant}`,
    { "houyou-bridge--compact": compact },
  ]}
  data-houyou-bridge={isTopBridge ? "true" : undefined}
>
  {isTopBridge && (
    <>
      <p class="eyebrow">法要・お墓参りで故郷へ帰る方へ</p>
      <h2>法要や墓参りで帰省される方へ</h2>
      <p>
        法要や墓参りは、離れて暮らすご家族が故郷へ帰る大切な機会です。
        もし時間があれば、実家の外観、庭木、郵便受け、仏壇、重要書類なども確認してみてください。
      </p>
      <p>結論を出す必要はありません。家族で現状を共有することが大切です。</p>
      <div class="houyou-bridge-actions">
        <a class="button-link" href="/topics/kisei/" data-track-click="houyou_bridge_click">法要帰省ガイド</a>
        <a class="button-link secondary-button" href="/topics/jikka/jikka-30/">実家確認チェックリスト</a>
        <a class="button-link secondary-button" href="/jikka-karute/" data-track-click="jikka_karute_click">実家カルテ（無料ツール）</a>
      </div>
      <p class="houyou-bridge-note">
        法要・供養、寺院ごとの作法や予定については、寺院の公式情報または寺院へ直接ご確認ください。
      </p>
    </>
  )}

  {isMidBridge && (
    <>
      <h2>法要・帰省の前に寺院へ確認すること</h2>
      <p>
        公開資料だけでは分からない項目があります。法要日時、参列人数、駐車場、持ち物、
        会食の有無は、過去の家の記録と寺院からの案内を優先してください。
      </p>
      <div class="houyou-bridge-actions">
        <a class="button-link" href={guideUrl} data-track-click="houyou_bridge_click">確認項目を読む</a>
      </div>
    </>
  )}

  {isBottomBridge && (
    <>
      <p class="eyebrow">編集方針</p>
      <h2>分からない項目は、推測せず未確認と表示します</h2>
      <p>
        寺院ごとの法要、檀家、駐車場、電話番号などは、確認できた情報に限って掲載します。
        未確認の項目は、寺院の公式情報または寺院へ直接確認してください。
      </p>
      <div class="houyou-bridge-actions">
        <a class="button-link" href="/editorial-policy/" data-track-click="editorial_policy_click">編集方針を見る</a>
        <a class="button-link secondary-button" href="/correction/">訂正・情報提供</a>
      </div>
      <p class="houyou-bridge-note">掲載寺院との提携・紹介関係を示すものではありません。</p>
    </>
  )}

  {isHomeBridge && (
    <>
      <p class="eyebrow">法要で磐田へ帰る方へ</p>
      <h2>菩提寺を確認したら、実家も一度だけ見ておく</h2>
      <p>
        法要やお墓参りで家族が集まる日は、菩提寺の名前や場所だけでなく、墓、仏壇、位牌、書類、
        実家の状態を確認できる機会でもあります。
      </p>
      <p>
        今すぐ家を売る、残すと決める必要はありません。写真を残し、親の考えを一言だけ聞いておくことで、
        次に家族で話すべきことが分かります。
      </p>
      <p>確認した内容は、当サイトの無料ツール「実家カルテ」に記録できます。入力内容は端末内だけに保存され、外部へ送信されません。</p>
      <ul class="houyou-bridge-icons" aria-label="確認するもの">
        <li><span aria-hidden="true">寺</span><strong>菩提寺</strong></li>
        <li><span aria-hidden="true">家</span><strong>実家</strong></li>
        <li><span aria-hidden="true">記</span><strong>家族メモ</strong></li>
      </ul>
      <div class="houyou-bridge-actions">
        <a class="button-link" href="/jikka-karute/" data-track-click="jikka_karute_click">実家カルテを開く（無料・端末内保存）</a>
        <a class="button-link secondary-button" href={guideUrl} data-track-click="houyou_bridge_click">法要と実家の確認メモを見る</a>
        <a class="button-link secondary-button" href={searchUrl} data-track-click="temple_search_refine">寺院名・宗派から探す</a>
      </div>
      <p class="houyou-bridge-note">掲載寺院との提携・紹介関係を示すものではありません。</p>
    </>
  )}

  {isIndexCard && (
    <>
      <p class="eyebrow">法要で磐田へ帰る方へ</p>
      <h2>菩提寺、墓、仏壇、実家を順番に確認する</h2>
      <p>寺院名、住所、宗派を確認したあと、同じ帰省で家族が見ておく項目を整理します。</p>
      <div class="houyou-bridge-actions">
        <a class="button-link" href={guideUrl} data-track-click="houyou_bridge_click">法要・帰省の確認メモ</a>
        <a class="button-link secondary-button" href="/jikka-karute/" data-track-click="jikka_karute_click">実家カルテ（無料ツール）を開く</a>
      </div>
    </>
  )}
</section>
