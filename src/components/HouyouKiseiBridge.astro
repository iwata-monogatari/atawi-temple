---
import { LINE_URL, karteUrl } from "../lib/editorial";

interface Props {
  variant?: "temple-top" | "temple-mid" | "temple-bottom" | "home" | "index-card" | "guide-bottom";
  compact?: boolean;
}

const { variant = "temple-top", compact = false } = Astro.props;
const isTopBridge = variant === "temple-top";
const isMidBridge = variant === "temple-mid";
const isBottomBridge = variant === "temple-bottom" || variant === "guide-bottom";
const isHomeBridge = variant === "home";
const isIndexCard = variant === "index-card";
const guideUrl = "/guide/houyou-kisei/";
const checkUrl = "/guide/kisei-check/";
const karteTopUrl = karteUrl("houyou-kisei", `${variant}_karte`);
const sampleUrl = `${karteTopUrl}#sample`;
---

<section
  class:list={[
    "houyou-bridge",
    `houyou-bridge--${variant}`,
    { "houyou-bridge--compact": compact },
  ]}
  data-houyou-bridge={isTopBridge ? "true" : undefined}
>
  {isTopBridge && (
    <>
      <p class="eyebrow">法要・帰省の準備</p>
      <h2>法要・お墓参りで磐田へ帰るご家族へ</h2>
      <p>
        菩提寺を調べる機会は、実家のことを家族で確認できる機会でもあります。
        法要や墓参りで帰省した際に、実家の外観、庭木、郵便物、仏壇・位牌、
        固定資産税の書類などを写真とメモで残しておくと、後から兄弟姉妹で話しやすくなります。
      </p>
      <p>売却を決める必要はありません。まずは、分かることだけ整理してください。</p>
      <div class="houyou-bridge-actions">
        <a class="button-link" href={guideUrl} data-track-click="houyou_bridge_click">法要・帰省前に確認する10項目</a>
        <a class="button-link secondary-button" href={karteTopUrl} data-track-click="jikka_cta_click">実家を住所から調べる</a>
      </div>
      <p class="houyou-bridge-note">査定ではありません／売却営業は行いません／入力約1分　運営元：富士ヶ丘サービス株式会社</p>
    </>
  )}

  {isMidBridge && (
    <>
      <h2>法要の予定が決まったら、実家についても一つだけ確認</h2>
      <p>
        帰省後は、気になったことがあっても日常に戻ってしまいます。
        家、庭、郵便物、仏壇、書類をスマートフォンで撮っておくだけでも、後から役立ちます。
      </p>
      <div class="houyou-bridge-actions">
        <a class="button-link" href={checkUrl} data-track-click="houyou_bridge_click">帰省チェックリストを見る</a>
      </div>
    </>
  )}

  {isBottomBridge && (
    <>
      <p class="eyebrow">ふじがおか実家カルテ</p>
      <h2>磐田の実家を、売る前に調べておく</h2>
      <p>
        住所から、名義、道路、法令制限、災害リスクなどを宅建士が整理します。
        価格査定ではなく、家族で確認するための整理です。
      </p>
      <div class="houyou-bridge-actions">
        <a class="button-link" href={karteTopUrl} data-track-click="jikka_cta_click">実家カルテを申し込む</a>
        <a class="button-link secondary-button" href={LINE_URL} target="_blank" rel="noopener" data-track-click="line_click">LINEで「親の家の相談」と送る</a>
      </div>
      <p class="houyou-bridge-note">掲載寺院との提携・紹介関係を示すものではありません。</p>
    </>
  )}

  {isHomeBridge && (
    <>
      <p class="eyebrow">法要で磐田へ帰る方へ</p>
      <h2>菩提寺の確認と、実家の確認を同じ流れで</h2>
      <p>
        菩提寺の場所や宗派を確認したら、帰省時に実家も一度だけ見ておいてください。
        全部を決める必要はありません。家、庭、郵便物、仏壇、書類を写真で残すだけでも、
        後から家族で話しやすくなります。
      </p>
      <div class="houyou-bridge-actions">
        <a class="button-link" href={guideUrl} data-track-click="houyou_bridge_click">帰省前チェックリスト</a>
        <a class="button-link secondary-button" href={karteTopUrl} data-track-click="jikka_cta_click">実家を住所から確認する</a>
      </div>
    </>
  )}

  {isIndexCard && (
    <>
      <p class="eyebrow">法要のためにお寺を探している方へ</p>
      <h2>帰省時に実家で見ておきたい項目も確認できます</h2>
      <p>菩提寺を確認したら、家・庭・郵便物・仏壇・書類を写真で残すだけでも、帰省後に家族で話しやすくなります。</p>
      <div class="houyou-bridge-actions">
        <a class="button-link" href={guideUrl} data-track-click="houyou_bridge_click">帰省時に見る10項目</a>
      </div>
    </>
  )}

  {variant === "guide-bottom" && (
    <div class="houyou-bridge-secondary">
      <a href={sampleUrl} data-track-click="karte_sample_view">カルテ見本を見る</a>
    </div>
  )}
</section>
