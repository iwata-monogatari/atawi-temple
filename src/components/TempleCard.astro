---
import type { Temple } from "../lib/temples";
import { getDistrictName, getTempleMediaBySlug, getTempleStatusLabel, hasDetailPage, isUnknownValue, knownValue } from "../lib/temples";

interface Props {
  temple: Temple;
  variant?: "default" | "area-result";
}

const { temple, variant = "default" } = Astro.props;
const districtName = getDistrictName(temple.district_id);
const showKana = !isUnknownValue(temple.name_kana);
const media = getTempleMediaBySlug(temple.slug);
const cardImage = media?.hero_image ?? media?.photos[0]?.src;
const hasCardImage = Boolean(cardImage);
const cardImageAlt = media?.photos.find((photo) => photo.src === cardImage)?.alt ?? temple.name + "の代表写真";
const detailPageAvailable = hasDetailPage(temple);
const isAreaResult = variant === "area-result";
const cardSummary = "page_summary" in temple && typeof temple.page_summary === "string" && temple.page_summary
  ? temple.page_summary
  : `${districtName}地区に所在する${temple.sect}の寺院です。公式名簿の基礎情報をもとに掲載しています。`;
const factItems = isAreaResult
  ? [
      { label: "住所", value: temple.address },
      { label: "宗派", value: temple.sect },
      { label: "小地域", value: temple.area },
    ]
  : [
      { label: "住所", value: temple.address },
      { label: "宗派", value: temple.sect },
      { label: "ご本尊", value: knownValue(temple.main_deity) },
      { label: "創建・年代", value: knownValue("founded_period" in temple ? temple.founded_period : null, "調査中") },
    ];
---

<article class:list={["temple-card", { "temple-card--area-result": isAreaResult, "temple-card--no-photo": !hasCardImage }]}>
  {
    cardImage ? (
      detailPageAvailable ? (
        <a
          class="temple-card-photo"
          href={"/temples/" + temple.slug + "/"}
          aria-label={temple.name + "の詳細を見る"}
          data-track-click={isAreaResult ? "temple_detail_click" : undefined}
        >
          <img src={cardImage} alt={cardImageAlt} loading="lazy" />
        </a>
      ) : (
        <div class="temple-card-photo" aria-label={temple.name + "の検索記録"}>
          <img src={cardImage} alt={cardImageAlt} loading="lazy" />
        </div>
      )
    ) : null
  }
  <div class="temple-card-body">
    <div class="card-topline">
      <span class={`status status-${temple.status}`}>{getTempleStatusLabel(temple)}</span>
      <span>{districtName}</span>
    </div>
    <h3>
      {detailPageAvailable ? (
        <a href={`/temples/${temple.slug}/`} data-track-click={isAreaResult ? "temple_detail_click" : undefined}>{temple.name}</a>
      ) : temple.name}
    </h3>
    {showKana && <p class="kana">{temple.name_kana}</p>}
    <dl class="compact-list">
      {factItems.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
    <p class="temple-card-summary">{cardSummary}</p>
    {detailPageAvailable && isAreaResult && (
      <a class="temple-card-action" href={`/temples/${temple.slug}/`} data-track-click="temple_detail_click">詳細を見る</a>
    )}
    {!detailPageAvailable && <p class="pending-text">個別ページは公開していません。検索記録として表示しています。</p>}
  </div>
</article>
