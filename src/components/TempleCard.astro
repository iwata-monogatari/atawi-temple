---
import type { Temple } from "../lib/temples";
import { getDistrictName, getTempleMediaBySlug, isUnknownValue, knownValue } from "../lib/temples";

interface Props {
  temple: Temple;
}

const { temple } = Astro.props;
const districtName = getDistrictName(temple.district_id);
const showKana = !isUnknownValue(temple.name_kana);
const media = getTempleMediaBySlug(temple.slug);
const cardImage = media?.hero_image ?? media?.photos[0]?.src;
const cardImageAlt = media?.photos.find((photo) => photo.src === cardImage)?.alt ?? temple.name + "の代表写真";
---

<article class="temple-card">
  {
    cardImage ? (
      <a class="temple-card-photo" href={"/temples/" + temple.slug + "/"} aria-label={temple.name + "の詳細を見る"}>
        <img src={cardImage} alt={cardImageAlt} loading="lazy" />
      </a>
    ) : null
  }
  <div class="card-topline">
    <span class={`status status-${temple.status}`}>{temple.status_label}</span>
    <span>{districtName}</span>
  </div>
  <h3><a href={`/temples/${temple.slug}/`}>{temple.name}</a></h3>
  {showKana && <p class="kana">{temple.name_kana}</p>}
  <dl class="compact-list">
    <div>
      <dt>住所</dt>
      <dd>{temple.address}</dd>
    </div>
    <div>
      <dt>宗派</dt>
      <dd>{temple.sect}</dd>
    </div>
    <div>
      <dt>ご本尊</dt>
      <dd>{knownValue(temple.main_deity)}</dd>
    </div>
    <div>
      <dt>創建・年代</dt>
      <dd>{knownValue("founded_period" in temple ? temple.founded_period : null, "調査中")}</dd>
    </div>
  </dl>
  <p>{districtName}地区に所在する{temple.sect}の寺院です。公式名簿の基礎情報をもとに掲載しています。</p>
</article>
