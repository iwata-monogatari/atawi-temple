---
import type { PortalArticle } from "../lib/portal-articles";

interface Props {
  actions: NonNullable<PortalArticle["nextActions"]>;
}

const { actions } = Astro.props;
---

<section class="article-section article-next-actions" aria-labelledby="article-next-actions-title">
  <h2 id="article-next-actions-title">読んだあとにできること</h2>
  <div class="next-actions-grid">
    {actions.map((action) => (
      <div class="next-action">
        <a class="button-link" href={action.href} data-track-click={action.trackingEvent}>
          <span>{action.label.map((part) => <span class="label-part">{part}</span>)}</span><span aria-hidden="true">→</span>
        </a>
        <p>{action.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .article-section.article-next-actions {
    padding: 24px;
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: 8px;
    background: var(--soft);
  }

  .next-actions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .next-action {
    min-width: 0;
  }

  .next-action .button-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 80px;
    padding: 16px;
    line-height: 1.6;
    white-space: normal;
    text-align: left;
  }

  .next-action .button-link:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .label-part {
    display: inline-block;
  }

  .next-action p {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: .9rem;
    line-height: 1.8;
  }

  @media (max-width: 600px) {
    .article-section.article-next-actions {
      padding: 20px 16px;
    }

    .next-actions-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .next-action .button-link {
      min-height: 56px;
    }
  }
</style>
