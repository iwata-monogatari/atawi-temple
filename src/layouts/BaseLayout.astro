---
import FujigaokaAnalytics from "../components/FujigaokaAnalytics.astro";
import SearchTrafficTempleLinks from "../components/SearchTrafficTempleLinks.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  hideSeasonalBanner?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "磐田市のお寺・寺院データベース｜ATAWI TEMPLE",
  description = "磐田市内の寺院、廃寺、寺院跡、霊場・札所情報を整理する地域寺院データベースです。",
  ogImage = "/assets/temples/kokubunji-mitsuke/hondo.webp",
  ogType = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  hideSeasonalBanner = false,
  structuredData = [],
} = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/+$/, "") || "https://temple.atawi.link";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const sharedStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "ATAWI TEMPLE",
    url: siteUrl,
    logo: new URL("/assets/brand/atawi-temple-mark.svg", siteUrl).toString(),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "ATAWI TEMPLE",
    url: siteUrl,
    description,
    potentialAction: {
      "@type": "SearchAction",
      target: `${siteUrl}/search/?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
];
const structuredDataItems = [...sharedStructuredData, ...pageStructuredData].filter((item) => Object.keys(item).length > 0);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#2f4b2b" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="ATAWI TEMPLE" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && <meta property="article:author" content={`${siteUrl}/about/`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="大石浩之のお寺ノート｜ATAWI TEMPLE" href="/feed.xml" />
    {structuredDataItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, "\\u003c")} />
    ))}
    <FujigaokaAnalytics />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/assets/brand/atawi-temple-mark.svg" alt="" width="48" height="48" />
        <span>
          <small>磐田市のお寺・寺院データベース</small>
          <strong>ATAWI TEMPLE</strong>
        </span>
      </a>
      <nav aria-label="主要ナビゲーション">
        <a href="/search/">お寺を探す</a>
        <a href="/topics/houyou/">法要</a>
        <a href="/topics/kisei/">帰省</a>
        <a href="/topics/jikka/">実家</a>
        <a href="/topics/">家族のためのガイド</a>
        <a href="/knowledge/">寺院の基礎資料</a>
        <a href="/blog/">ブログ</a>
        <a href="/about/">このサイトについて</a>
      </nav>
    </header>
    {!hideSeasonalBanner && (
      <aside class="seasonal-traffic-banner" data-obon-banner hidden aria-label="お盆・帰省の確認案内">
        <div>
          <span>8月31日まで</span>
          <p><strong>お盆の帰省で、菩提寺・墓・仏壇を確認</strong> 10項目を3分で見られます。</p>
          <a href="/obon/?utm_source=temple&utm_medium=internal&utm_campaign=obon_2026&utm_content=sitewide_banner" data-track-click="obon_banner_click">帰省チェックを見る</a>
          <button type="button" data-obon-banner-close aria-label="この案内を閉じる">×</button>
        </div>
      </aside>
    )}
    <main>
      <slot />
      <SearchTrafficTempleLinks path={Astro.url.pathname} />
    </main>
    <footer class="site-footer">
      <p>運営：富士ヶ丘サービス</p>
      <nav aria-label="フッターナビゲーション">
        <a href="/about/">運営者情報</a>
        <a href="/map/">住所一覧</a>
        <a href="/status/">調査状況</a>
        <a href="/sects/">宗派・関連法人</a>
        <a href="/guide/houyou-kisei/">法要・帰省の確認</a>
        <a href="/guide/">基礎ガイド</a>
        <a href="/knowledge/">寺院用語・制度</a>
        <a href="/tokushu/">特集・読みもの</a>
        <a href="/blog/">大石浩之のお寺ノート</a>
        <a href="/jikka-karute/">実家カルテ（無料ツール）</a>
        <a href="/editorial-policy/">編集方針</a>
        <a href="/correction/">情報提供掲示板</a>
        <a href="/privacy/">プライバシーポリシー</a>
        <a href="https://iwata-monogatari.net/">磐田物語</a>
        <a href="https://shrine.atawi.link/">ATAWI SHRINE</a>
        <a href="https://iwata.enshu-lifehack.com/">磐田ライフハック</a>
        <a href="https://fudosan.atawi.link/">ATAWI FUDOSAN</a>
      </nav>
      <p class="small">姉妹サイト：磐田物語 ─ 磐田の歴史読み物／ATAWI SHRINE ─ 磐田市の神社データベース／磐田ライフハック ─ 磐田市の暮らしと手続きの道しるべ／ATAWI FUDOSAN ─ 運営元（富士ヶ丘サービス）の不動産サービス</p>
      <p class="small">ATAWI TEMPLEは各寺院の公式サイトではありません。</p>
      <p class="small"><a href="/research/">研究論文一覧</a></p>
    </footer>
    <script is:inline>
      // @ts-nocheck
      (function () {
        var banner = document.querySelector("[data-obon-banner]");
        if (!banner) return;
        var storageKey = "atawi-temple-obon-banner-2026";
        var now = new Date();
        var jstParts = new Intl.DateTimeFormat("en-CA", {
          timeZone: "Asia/Tokyo",
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        }).formatToParts(now).reduce(function (acc, part) {
          if (part.type !== "literal") acc[part.type] = part.value;
          return acc;
        }, {});
        var today = jstParts.year + "-" + jstParts.month + "-" + jstParts.day;
        var inSeason = today >= "2026-07-15" && today <= "2026-08-31";
        try {
          if (inSeason && window.localStorage.getItem(storageKey) !== "closed") {
            banner.hidden = false;
          }
        } catch (_) {
          if (inSeason) banner.hidden = false;
        }
        var closeButton = document.querySelector("[data-obon-banner-close]");
        if (!closeButton) return;
        closeButton.addEventListener("click", function () {
          banner.hidden = true;
          try {
            window.localStorage.setItem(storageKey, "closed");
          } catch (_) {}
        });
      })();
    </script>
    <script is:inline>
      // @ts-nocheck
      (function () {
        function sendJourneyEvent(eventName) {
          var tracker = document.querySelector("script[data-fujigaoka-analytics]");
          if (!tracker || !tracker.src || location.hostname !== "temple.atawi.link") return;
          var payload = JSON.stringify({
            site_id: tracker.getAttribute("data-site") || "atawi-temple",
            path: location.pathname + location.search,
            url: location.href,
            referrer: document.referrer || "",
            event_name: eventName,
          });
          var endpoint = new URL("/api/click", tracker.src).href;
          if (navigator.sendBeacon) navigator.sendBeacon(endpoint, new Blob([payload], { type: "application/json" }));
          else if (window.fetch) fetch(endpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body: payload, mode: "cors", credentials: "omit", keepalive: true }).catch(function () {});
        }
        window.addEventListener("load", function () {
          var path = location.pathname;
          if (/^\/temples\/[^/]+\/$/.test(path)) sendJourneyEvent("temple_view");
          else if (/^\/topics\/[^/]+\/[^/]+\/$/.test(path) || /^\/guide\/[^/]+\/$/.test(path)) sendJourneyEvent("guide_view");
          else if (/^\/research\/[^/]+\/$/.test(path)) sendJourneyEvent("research_view");
          else if (/^\/blog\/[^/]+\/$/.test(path)) sendJourneyEvent("blog_view");
        });
      })();
    </script>
  </body>
</html>

