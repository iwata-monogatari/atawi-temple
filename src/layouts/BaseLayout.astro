---
import FujigaokaAnalytics from "../components/FujigaokaAnalytics.astro";
import { fromTempleUrl } from "../lib/editorial";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  hideSeasonalBanner?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "磐田市のお寺・寺院データベース｜ATAWI TEMPLE",
  description = "磐田市内の寺院、廃寺、寺院跡、霊場・札所情報を整理する地域寺院データベースです。",
  ogImage = "/assets/temples/kokubunji-mitsuke/hondo.webp",
  noindex = false,
  hideSeasonalBanner = false,
  structuredData = [],
} = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/+$/, "") || "https://temple.atawi.link";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const footerFudosanUrl = fromTempleUrl("site_footer");
const seasonalFudosanUrl = fromTempleUrl("seasonal_banner");
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const sharedStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "ATAWI TEMPLE",
    url: siteUrl,
    logo: new URL("/assets/brand/atawi-temple-mark.svg", siteUrl).toString(),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "ATAWI TEMPLE",
    url: siteUrl,
    description,
    potentialAction: {
      "@type": "SearchAction",
      target: `${siteUrl}/search/?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
];
const structuredDataItems = [...sharedStructuredData, ...pageStructuredData].filter((item) => Object.keys(item).length > 0);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#2f4b2b" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="ATAWI TEMPLE" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    {structuredDataItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, "\\u003c")} />
    ))}
    <FujigaokaAnalytics />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/assets/brand/atawi-temple-mark.svg" alt="" width="48" height="48" />
        <span>
          <small>磐田市のお寺・寺院データベース</small>
          <strong>ATAWI TEMPLE</strong>
        </span>
      </a>
      <nav aria-label="主要ナビゲーション">
        <a href="/search/">お寺を探す</a>
        <a href="/guide/houyou-kisei/">法要・帰省の確認</a>
        <a href="/guide/">檀家・法要の基礎知識</a>
        <a href="/about/">このサイトについて</a>
      </nav>
    </header>
    {!hideSeasonalBanner && (
      <aside class="seasonal-banner" data-obon-banner hidden>
        <a
          href={seasonalFudosanUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track-click="to_fudosan_click"
        >帰省時の実家確認を、必要な方だけ相談する →</a>
        <button type="button" data-obon-banner-close aria-label="お知らせを閉じる">×</button>
      </aside>
    )}
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>運営：富士ヶ丘サービス</p>
      <nav aria-label="フッターナビゲーション">
        <a href="/about/">運営者情報</a>
        <a href="/map/">住所一覧</a>
        <a href="/status/">調査状況</a>
        <a href="/sects/">宗派・関連法人</a>
        <a href="/guide/houyou-kisei/">法要・帰省の確認</a>
        <a href="/guide/">基礎ガイド</a>
        <a href="/tokushu/">特集・読みもの</a>
        <a
          href={footerFudosanUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track-click="to_fudosan_click"
        >実家確認の相談</a>
        <a href="/editorial-policy/">編集方針</a>
        <a href="/correction/">情報提供掲示板</a>
        <a href="/privacy/">プライバシーポリシー</a>
        <a href="https://iwata-monogatari.net/">磐田物語</a>
      </nav>
      <p class="small">姉妹サイト：磐田物語 ─ 磐田の歴史読み物</p>
      <p class="small">ATAWI TEMPLEは各寺院の公式サイトではありません。</p>
    </footer>
    <script is:inline>
      // @ts-nocheck
      (function () {
        var banner = document.querySelector("[data-obon-banner]");
        if (!banner) return;
        var storageKey = "atawi-temple-obon-banner-2026";
        var now = new Date();
        var jstParts = new Intl.DateTimeFormat("en-CA", {
          timeZone: "Asia/Tokyo",
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        }).formatToParts(now).reduce(function (acc, part) {
          if (part.type !== "literal") acc[part.type] = part.value;
          return acc;
        }, {});
        var today = jstParts.year + "-" + jstParts.month + "-" + jstParts.day;
        var inSeason = today >= "2026-07-15" && today <= "2026-08-31";
        try {
          if (inSeason && window.localStorage.getItem(storageKey) !== "closed") {
            banner.hidden = false;
          }
        } catch (_) {
          if (inSeason) banner.hidden = false;
        }
        var closeButton = document.querySelector("[data-obon-banner-close]");
        if (!closeButton) return;
        closeButton.addEventListener("click", function () {
          banner.hidden = true;
          try {
            window.localStorage.setItem(storageKey, "closed");
          } catch (_) {}
        });
      })();
    </script>
  </body>
</html>
