---
import FujigaokaAnalytics from "../components/FujigaokaAnalytics.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "磐田市のお寺・寺院データベース｜ATAWI temple",
  description = "磐田市内の寺院、廃寺、寺院跡、霊場・札所情報を整理する地域寺院データベースです。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <FujigaokaAnalytics />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span>磐田市のお寺・寺院データベース</span>
        <strong>ATAWI temple</strong>
      </a>
      <nav aria-label="主要ナビゲーション">
        <a href="/temples/">寺院一覧</a>
        <a href="/areas/">9地区</a>
        <a href="/sects/">宗派</a>
        <a href="/status/">調査状況</a>
        <a href="/search/">検索</a>
        <a href="/editorial-policy/">編集方針</a>
        <a href="/correction/">情報提供・訂正</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>運営：富士ヶ丘サービス</p>
      <nav aria-label="フッターナビゲーション">
        <a href="/about/">運営者情報</a>
        <a href="/status/">調査状況</a>
        <a href="/sects/">宗派</a>
        <a href="/editorial-policy/">編集方針</a>
        <a href="/correction/">情報提供・訂正</a>
        <a href="/privacy/">プライバシーポリシー</a>
      </nav>
      <p class="small">ATAWI templeは各寺院の公式サイトではありません。</p>
    </footer>
  </body>
</html>
