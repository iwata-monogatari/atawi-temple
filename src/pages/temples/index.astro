---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TempleCard from "../../components/TempleCard.astro";
import { allDistricts, allTemples, getDistrictName } from "../../lib/temples";
---

<BaseLayout
  title="磐田市の寺院一覧｜ATAWI TEMPLE"
  description="磐田市内の現存寺院、廃寺、寺院跡を検索できる一覧です。"
>
  <section class="page-title">
    <p class="eyebrow">Temple Index</p>
    <h1>磐田市の寺院一覧</h1>
    <p>寺院名、読み方、住所、地区、宗派、状態を確認できます。基礎情報は公式名簿をもとに掲載し、由緒・写真は調査にあわせて追加します。</p>
  </section>

  <section class="section">
    <h2>9地区分類</h2>
    <div class="filter-band">
      {allDistricts.map((district) => <a href={`/areas/${district.slug}/`}>{district.name}</a>)}
    </div>
  </section>

  <section class="section">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>寺院名</th>
            <th>読み方</th>
            <th>地区</th>
            <th>宗派</th>
            <th>状態</th>
            <th>詳細</th>
          </tr>
        </thead>
        <tbody>
          {
            allTemples.map((temple) => (
              <tr>
                <td>{temple.name}</td>
                <td>{temple.name_kana}</td>
                <td>{getDistrictName(temple.district_id)}</td>
                <td>{temple.sect}</td>
                <td>{temple.status_label}</td>
                <td><a href={`/temples/${temple.slug}/`}>開く</a></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <h2>カード表示</h2>
    <div class="card-grid">
      {allTemples.map((temple) => <TempleCard temple={temple} />)}
    </div>
  </section>
</BaseLayout>
