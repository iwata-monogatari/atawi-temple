---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HouyouKiseiBridge from "../../components/HouyouKiseiBridge.astro";
import {
  allSects,
  allTemples,
  getDistrictById,
  getDistrictName,
  getPhotoCategory,
  getSectGroupName,
  getTempleDisplaySummary,
  getTempleBySlug,
  getTempleLatLng,
  getTempleMediaBySlug,
  getTempleStatusLabel,
  getVisibleTempleMediaPhotos,
  googleMapsEmbedUrl,
  googleMapsUrl,
  googleMapsWebEmbedUrl,
  hasDetailPage,
  isCemeteryServiceInfo,
  isUnknownValue,
} from "../../lib/temples";
import {
  getMonogatariLinksBySlug,
  getMonogatariRelationLabel,
} from "../../lib/related-monogatari";
import { LINE_URL, karteUrl } from "../../lib/editorial";

export function getStaticPaths() {
  return allTemples.filter(hasDetailPage).map((temple) => ({ params: { slug: temple.slug } }));
}

const temple = getTempleBySlug(Astro.params.slug || "");
if (!temple || !hasDetailPage(temple)) return Astro.redirect("/temples/");

const districtName = getDistrictName(temple.district_id);
const district = getDistrictById(temple.district_id);
const districtUrl = district ? `/areas/${district.slug}/` : "/areas/";
const mapPageUrl = temple.district_id
  ? `/map/?district=${temple.district_id}&q=${encodeURIComponent(temple.name)}`
  : `/map/?q=${encodeURIComponent(temple.name)}`;
const mapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY;
const mapEmbedUrl = googleMapsEmbedUrl(temple, mapsApiKey);
const mapFallbackEmbedUrl = googleMapsWebEmbedUrl(temple);
const visibleMapEmbedUrl = mapEmbedUrl || mapFallbackEmbedUrl;
const mapUrl = googleMapsUrl(temple);
const showKana = !isUnknownValue(temple.name_kana);
const media = getTempleMediaBySlug(temple.slug);
const visibleMediaPhotos = getVisibleTempleMediaPhotos(temple.slug);
const coverPhoto = media
  ? visibleMediaPhotos.find((photo) => photo.src === media.hero_image) || visibleMediaPhotos[0] || null
  : null;
const galleryPhotos = coverPhoto ? visibleMediaPhotos.filter((photo) => photo.src !== coverPhoto.src) : [];
const historicalSections = "historical_sections" in temple && Array.isArray(temple.historical_sections)
  ? temple.historical_sections
  : [];
const visibleHistoricalSections = historicalSections.filter((item: any) =>
  !isCemeteryServiceInfo(`${item.heading || ""} ${item.body || ""}`)
);
const culturalAssets = "cultural_assets" in temple && Array.isArray(temple.cultural_assets)
  ? temple.cultural_assets
  : [];
const visibleCulturalAssets = culturalAssets.filter((asset: any) =>
  !isCemeteryServiceInfo(`${asset.designation || ""} ${asset.name || ""} ${asset.summary || ""}`)
);
const rawResearchTodos = "research_todos" in temple && Array.isArray(temple.research_todos)
  ? temple.research_todos
  : ["創建・沿革", "ご本尊", "参拝情報", "文化財・寺宝", "現地写真"];
const researchTodos = rawResearchTodos.filter((todo: any) => !isCemeteryServiceInfo(todo));
const visibleSources = temple.sources.filter((source: any) =>
  !isCemeteryServiceInfo(`${source.title || ""} ${source.note || ""} ${"url" in source ? source.url || "" : ""}`)
);
const visiblePageSummary = getTempleDisplaySummary(temple, districtName);
const visibleHistorySummary = isCemeteryServiceInfo(temple.history_summary)
  ? visiblePageSummary
  : temple.history_summary;
const foundedPeriod = "founded_period" in temple && temple.founded_period
  ? temple.founded_period
  : "調査中";
const heritageStatus = "heritage_status" in temple && temple.heritage_status
  ? temple.heritage_status
  : "調査中";
const visibleFoundedPeriod = isCemeteryServiceInfo(foundedPeriod) ? "調査中" : foundedPeriod;
const visibleHeritageStatus = isCemeteryServiceInfo(heritageStatus) ? "調査中" : heritageStatus;
const pilgrimageNote = "pilgrimage_note" in temple && temple.pilgrimage_note
  ? temple.pilgrimage_note
  : null;
const visiblePilgrimageNote = pilgrimageNote && !isCemeteryServiceInfo(pilgrimageNote) ? pilgrimageNote : null;
const publicationNotice: any = "publication_notice" in temple && temple.publication_notice
  ? temple.publication_notice
  : null;
const dankaInfo: any = "danka_info" in temple && temple.danka_info ? temple.danka_info : null;
const rawAnnualEvents = dankaInfo && Array.isArray(dankaInfo.annual_events) ? dankaInfo.annual_events : [];
const annualEvents = rawAnnualEvents.filter((event: any) =>
  !isCemeteryServiceInfo(`${event.name || ""} ${event.timing || ""} ${event.note || ""}`)
);
const dankaOrganization = dankaInfo?.organization && !isCemeteryServiceInfo(dankaInfo.organization)
  ? dankaInfo.organization
  : null;
const dankaCommunityRole = dankaInfo?.community_role && !isCemeteryServiceInfo(dankaInfo.community_role)
  ? dankaInfo.community_role
  : null;
const monogatariLinks = getMonogatariLinksBySlug(temple.slug);
const currentSectName = getSectGroupName(temple.sect);
const currentSectSlug = allSects.find((sect) => sect.name === currentSectName)?.slug || "";
const sameDistrictTemples = allTemples
  .filter((item) => item.slug !== temple.slug && item.district_id === temple.district_id && hasDetailPage(item))
  .sort((a, b) => (a.status === "existing" ? 0 : 1) - (b.status === "existing" ? 0 : 1))
  .slice(0, 5);
const sameSectTemples = allTemples
  .filter((item) => item.slug !== temple.slug && getSectGroupName(item.sect) === currentSectName && hasDetailPage(item))
  .sort((a, b) =>
    (a.district_id === temple.district_id ? 0 : 1) - (b.district_id === temple.district_id ? 0 : 1) ||
    a.name_kana.localeCompare(b.name_kana, "ja") ||
    a.name.localeCompare(b.name, "ja")
  )
  .slice(0, 5);
const currentLatLng = getTempleLatLng(temple);
const nearbyTemples = currentLatLng
  ? allTemples
      .filter((item) => item.slug !== temple.slug && hasDetailPage(item) && getTempleLatLng(item))
      .map((item) => {
        const latLng = getTempleLatLng(item)!;
        const distance = (latLng.lat - currentLatLng.lat) ** 2 + (latLng.lng - currentLatLng.lng) ** 2;
        return { temple: item, distance };
      })
      .sort((a, b) => a.distance - b.distance)
      .slice(0, 5)
      .map((item) => item.temple)
  : [];
const templeImage = coverPhoto?.src || "/assets/temples/kokubunji-mitsuke/hondo.webp";
const siteUrl = "https://temple.atawi.link";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ATAWI TEMPLE", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: "寺院一覧", item: `${siteUrl}/temples/` },
      { "@type": "ListItem", position: 3, name: `${districtName}地区`, item: `${siteUrl}${districtUrl}` },
      { "@type": "ListItem", position: 4, name: temple.name, item: `${siteUrl}/temples/${temple.slug}/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Place",
    name: temple.name,
    description: visiblePageSummary,
    url: `${siteUrl}/temples/${temple.slug}/`,
    image: new URL(templeImage, siteUrl).toString(),
    address: {
      "@type": "PostalAddress",
      addressCountry: "JP",
      addressRegion: "静岡県",
      addressLocality: "磐田市",
      streetAddress: temple.address.replace(/^静岡県磐田市/, ""),
    },
    ...(currentLatLng ? { geo: { "@type": "GeoCoordinates", latitude: currentLatLng.lat, longitude: currentLatLng.lng } } : {}),
  },
];

const field = (value: string | null | undefined, pending = "調査中") => ({
  text: isUnknownValue(value) ? pending : value,
  pending: isUnknownValue(value),
});
const deity = field(temple.main_deity, "調査中・加筆待ち");
const officialSite = dankaInfo?.official_site;
const officialSiteStatus = officialSite?.status || "未確認";
const officialSiteLabel = officialSite?.status === "あり" ? "公式サイトあり" : officialSiteStatus;
const phoneStatus = "未確認（公式情報または寺院へご確認ください）";
const houyouStatus = annualEvents.length > 0
  ? `${annualEvents.length}件の年中行事・法要情報を掲載`
  : "未確認（寺院へご確認ください）";
const parkingStatus = "未確認（現地・寺院へご確認ください）";
const templeDetailTitle = `${temple.name}（磐田市${districtName}）｜住所・宗派・法要前の確認事項｜ATAWI TEMPLE`;
const templeDetailDescription = `磐田市${districtName}の${temple.name}について、住所、読み方、宗派、由緒、確認できた現地写真を掲載。法要やお墓参りで磐田へ帰省する方に向け、菩提寺と実家で確認する項目も案内します。`;
const mobileKarteUrl = karteUrl("houyou-kisei", "temple_mobile_sticky");
const uploadedPhotoTempleDataJson = JSON.stringify({
  slug: temple.slug,
  name: temple.name,
}).replace(/</g, "\\u003c");
---

<BaseLayout
  title={templeDetailTitle}
  description={templeDetailDescription}
  ogImage={templeImage}
  structuredData={structuredData}
>
  <article class="temple-profile">
    {publicationNotice && (
      <section class="publication-notice publication-notice--top" aria-label={publicationNotice.label || "掲載に関するお知らせ"}>
        <div class="publication-notice__inner">
          <span>{publicationNotice.label || "掲載に関するお知らせ"}</span>
          <h2>{publicationNotice.title}</h2>
          {publicationNotice.body.map((paragraph: string) => <p>{paragraph}</p>)}
        </div>
      </section>
    )}
    <header class="temple-masthead">
      <nav class="breadcrumbs" aria-label="パンくず">
        <a href="/">ATAWI TEMPLE</a>
        <a href="/temples/">寺院一覧</a>
        <a href={districtUrl}>{districtName}地区</a>
        <span aria-current="page">{temple.name}</span>
      </nav>
      <div class="temple-heading">
        <div>
          <p class="eyebrow">{districtName}地区・{getTempleStatusLabel(temple)}</p>
          <h1>{temple.name}</h1>
          {showKana && <p class="temple-kana">{temple.name_kana}</p>}
        </div>
        <div class="research-badge">
          <span>ページ充実度</span>
          <strong>{media ? "現地写真・資料あり" : "基礎情報・調査中"}</strong>
          <small>最終確認 {temple.last_verified_at.replaceAll("-", ".")}</small>
        </div>
      </div>
      <p class="temple-lead">{visiblePageSummary}</p>
      {temple.aliases.length > 0 && (
        <p class="alias-line"><span>別称・関連名称</span>{temple.aliases.join("／")}</p>
      )}
      <dl class="temple-summary-strip" aria-label="寺院の基本情報">
        <div><dt>寺院名</dt><dd>{temple.name}</dd></div>
        <div><dt>地区</dt><dd>{districtName}</dd></div>
        <div><dt>住所</dt><dd>{temple.address}</dd></div>
        <div><dt>宗派</dt><dd>{temple.sect}</dd></div>
      </dl>
      <div class="temple-primary-actions" aria-label="寺院ページ上部の導線">
        <a class="button-link" href={districtUrl}>同じ地区の寺院を見る</a>
        <a class="button-link secondary-button" href={mapPageUrl} data-track-click="temple_map_click">地図で見る</a>
        <a class="button-link secondary-button" href="/temples/">寺院一覧へ戻る</a>
      </div>
    </header>

    <section class="temple-basic-panel" aria-label="寺院の基本情報と確認状況">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Basic Information</p>
          <h2>基本情報</h2>
        </div>
        <span class="small">ATAWI TEMPLEは各寺院の公式サイトではありません。</span>
      </div>
      <dl class="temple-basic-grid">
        <div><dt>寺院名</dt><dd>{temple.name}</dd></div>
        <div><dt>読み方</dt><dd class={!showKana ? "pending-text" : ""}>{showKana ? temple.name_kana : "未確認"}</dd></div>
        <div><dt>地区</dt><dd>{districtName}</dd></div>
        <div><dt>宗派</dt><dd>{temple.sect}</dd></div>
        <div><dt>住所</dt><dd>{temple.address}</dd></div>
        <div><dt>Googleマップ</dt><dd><a href={mapUrl} target="_blank" rel="noreferrer" data-track-click="temple_map_click">Googleマップで開く</a></dd></div>
        <div>
          <dt>寺院公式サイト</dt>
          <dd class={officialSite?.status === "あり" ? "" : "pending-text"}>
            {officialSite?.status === "あり" && officialSite.url ? (
              <a href={officialSite.url} target="_blank" rel="noreferrer">{officialSiteLabel}</a>
            ) : (
              officialSiteLabel
            )}
          </dd>
        </div>
        <div><dt>電話番号</dt><dd class="pending-text">{phoneStatus}</dd></div>
        <div><dt>法要・参拝情報</dt><dd class={annualEvents.length > 0 ? "" : "pending-text"}>{houyouStatus}</dd></div>
        <div><dt>駐車場情報</dt><dd class="pending-text">{parkingStatus}</dd></div>
        <div><dt>最終確認日</dt><dd>{temple.last_verified_at.replaceAll("-", ".")}</dd></div>
      </dl>
      <p class="temple-official-disclaimer">
        不明な項目は推測せず、未確認として表示しています。法要、参拝、駐車場、電話での連絡は、寺院の公式情報または寺院へ直接ご確認ください。
      </p>
    </section>

    <section class="temple-visual" aria-label={`${temple.name}の写真`}>
      {coverPhoto ? (
        <>
          <figure class="temple-cover">
            <img src={coverPhoto.src} alt={coverPhoto.alt || `${temple.name}の主写真`} loading="eager" />
            <figcaption>現地写真・{getPhotoCategory(coverPhoto.category_id)?.label || "寺院外観"}</figcaption>
          </figure>
          <div class="temple-photo-strip">
            {galleryPhotos.slice(0, 5).map((photo) => (
              <figure>
                <img src={photo.src} alt={photo.alt} loading="lazy" />
                <figcaption>{getPhotoCategory(photo.category_id)?.label || "現地写真"}</figcaption>
              </figure>
            ))}
          </div>
        </>
      ) : (
        <div class="pending-photo">
          {publicationNotice ? (
            <>
              <strong>写真掲載を見合わせています</strong>
              <span>関係者からの明確な意思表示を受け、当サイトでの写真掲載を行っていません。</span>
            </>
          ) : (
            <>
              <strong>写真を準備しています</strong>
              <span>現地訪問後に、本堂・境内・入口・説明板の写真を掲載します。</span>
            </>
          )}
        </div>
      )}
    </section>

    <section class="temple-fact-band" aria-label="寺院の要点">
      <div><span>宗派</span><strong>{temple.sect}</strong></div>
      <div><span>創建・年代</span><strong class={visibleFoundedPeriod === "調査中" ? "pending-text" : ""}>{visibleFoundedPeriod}</strong></div>
      <div><span>文化財・史跡</span><strong class={visibleHeritageStatus === "調査中" ? "pending-text" : ""}>{visibleHeritageStatus}</strong></div>
      <div><span>所在地</span><strong>{temple.area}・磐田市</strong></div>
    </section>

    <HouyouKiseiBridge variant="temple-top" />

    <section class="section uploaded-photo-section" data-uploaded-temple-photos hidden>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Uploaded Photos</p>
          <h2>保存済み写真</h2>
        </div>
        <span class="small" data-uploaded-temple-count></span>
      </div>
      <div class="photo-grid" data-uploaded-temple-grid></div>
    </section>
    <script is:inline type="application/json" id="temple-uploaded-photo-data" set:html={uploadedPhotoTempleDataJson} />
    <script is:inline>
      // @ts-nocheck
      (() => {
        const dataEl = document.getElementById("temple-uploaded-photo-data");
        const section = document.querySelector("[data-uploaded-temple-photos]");
        const grid = document.querySelector("[data-uploaded-temple-grid]");
        const count = document.querySelector("[data-uploaded-temple-count]");
        if (!dataEl || !section || !grid) return;

        let temple = null;
        try {
          temple = JSON.parse(dataEl.textContent || "null");
        } catch {
          temple = null;
        }
        if (!temple?.slug) return;

        fetch(`/api/photo-submissions?temple_slug=${encodeURIComponent(temple.slug)}`)
          .then((response) => response.ok ? response.json() : { photos: [] })
          .then((result) => {
            const photos = Array.isArray(result.photos) ? result.photos : [];
            if (photos.length === 0) return;
            section.hidden = false;
            if (count) count.textContent = `${photos.length}枚`;
            grid.innerHTML = photos.map((photo) => `
              <figure class="photo-card">
                <img src="${escapeHtml(photo.url)}" alt="${escapeHtml(temple.name)}の保存済み写真" loading="lazy">
                <figcaption>
                  <strong>${escapeHtml(temple.name)}</strong>
                  <span>${escapeHtml(photo.note || photo.file_name || "保存済み写真")}</span>
                </figcaption>
              </figure>
            `).join("");
          })
          .catch(() => {});

        function escapeHtml(value) {
          return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;");
        }
      })();
    </script>

    <div class="temple-content-grid">
      <main class="temple-main-content">
        <section class="detail-panel">
          <p class="section-number">01</p>
          <h2>この寺院について</h2>
          <p class="summary-copy">{visibleHistorySummary}</p>
          {deity.pending && (
            <div class="pending-inline">
              <span>ご本尊</span><strong>{deity.text}</strong><small>寺院資料・現地聞き取りで確認予定</small>
            </div>
          )}
        </section>

        <section class="detail-panel">
          <p class="section-number">02</p>
          <h2>歴史と背景</h2>
          {visibleHistoricalSections.length > 0 ? (
            <div class="history-timeline">
              {visibleHistoricalSections.map((item) => (
                <article>
                  <h3>{item.heading}</h3>
                  <p>{item.body}</p>
                </article>
              ))}
            </div>
          ) : (
            <div class="pending-block">
              <strong>沿革は調査中です</strong>
              <p>創建年代、開山・開基、移転・再建の履歴を、寺院資料と地域資料から確認して加筆します。</p>
            </div>
          )}
        </section>

        <section class="detail-panel">
          <p class="section-number">03</p>
          <h2>文化財・見どころ</h2>
          {visibleCulturalAssets.length > 0 ? (
            <div class="heritage-list">
              {visibleCulturalAssets.map((asset) => (
                <article>
                  <div><span>{asset.designation}</span><h3>{asset.name}</h3></div>
                  <p>{asset.summary}</p>
                </article>
              ))}
            </div>
          ) : (
            <div class="pending-block">
              <strong>文化財・寺宝は加筆待ちです</strong>
              <p>指定文化財、建築、仏像、石造物、古文書、境内の見どころを調査します。</p>
            </div>
          )}
        </section>

        {monogatariLinks.length > 0 && (
          <section class="detail-panel monogatari-panel">
            <p class="section-number">04</p>
            <h2>磐田物語で読む</h2>
            <p class="monogatari-lead">
              この寺院やゆかりの土地の歴史を、姉妹サイト「磐田物語」の読み物でご覧いただけます。
            </p>
            <ul class="monogatari-link-list">
              {monogatariLinks.map((link) => (
                <li>
                  <a href={link.url}>
                    {link.relation === "direct" && (
                      <span class="monogatari-relation-label">{getMonogatariRelationLabel(link.relation)}</span>
                    )}
                    <span class="monogatari-link-title">{link.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <section class="detail-panel">
          <p class="section-number">05</p>
          <h2>檀家の営み・行事</h2>
          {dankaInfo && (annualEvents.length > 0 || dankaOrganization || dankaCommunityRole) ? (
            <div class="danka-info-list">
              {annualEvents.length > 0 && (
                <article>
                  <h3>年中行事・法要</h3>
                  <ul>
                    {annualEvents.map((event: any) => (
                      <li><strong>{event.name}</strong>{event.timing && <span>（{event.timing}）</span>}{event.note && <p>{event.note}</p>}</li>
                    ))}
                  </ul>
                </article>
              )}
              {dankaOrganization && (
                <article>
                  <h3>檀家組織</h3>
                  <p>{dankaOrganization}</p>
                </article>
              )}
              {dankaCommunityRole && (
                <article>
                  <h3>地域との関わり</h3>
                  <p>{dankaCommunityRole}</p>
                </article>
              )}
            </div>
          ) : (
            <div class="pending-block">
              <strong>檀家向け情報は調査中です</strong>
              <p>年中行事・法要、檀家組織、地域との関わりを、寺院公式情報・公的資料から確認して加筆します。</p>
            </div>
          )}
        </section>

        <HouyouKiseiBridge variant="temple-mid" compact />

        <section class="detail-panel">
          <p class="section-number">06</p>
          <h2>写真で見る境内</h2>
          {visibleMediaPhotos.length > 0 ? (
            <div class="photo-record-list">
              {visibleMediaPhotos.map((photo) => (
                <figure>
                  <img src={photo.src} alt={photo.alt} loading="lazy" />
                  <figcaption>
                    <strong>{getPhotoCategory(photo.category_id)?.label || "現地写真"}</strong>
                    <span>{photo.caption}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <div class="pending-block">
              {publicationNotice ? (
                <>
                  <strong>写真掲載を見合わせています</strong>
                  <p>関係者からの明確な意思表示を受け、当サイトでの写真掲載を行っていません。</p>
                </>
              ) : (
                <>
                  <strong>現地写真を準備しています</strong>
                  <p>初回訪問後に掲載します。</p>
                </>
              )}
            </div>
          )}
        </section>

        <section class="detail-panel sources-panel">
          <p class="section-number">07</p>
          <h2>出典・参考資料</h2>
          <ol class="source-records">
            {visibleSources.map((source) => (
              <li>
                <span>{source.type}</span>
                {"url" in source && source.url ? (
                  <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
                ) : <strong>{source.title}</strong>}
                <p>{source.note}</p>
              </li>
            ))}
          </ol>
        </section>

        <HouyouKiseiBridge variant="temple-bottom" />
      </main>

      <aside class="temple-sidebar">
        <section class="side-panel">
          <h2>基本情報</h2>
          <dl class="side-info-list">
            <div><dt>正式名称</dt><dd>{temple.name}</dd></div>
            <div><dt>読み方</dt><dd>{showKana ? temple.name_kana : "調査中"}</dd></div>
            <div><dt>宗派</dt><dd>{temple.sect}</dd></div>
            <div><dt>ご本尊</dt><dd class={deity.pending ? "pending-text" : ""}>{deity.text}</dd></div>
            <div><dt>住所</dt><dd>{temple.address}</dd></div>
            <div><dt>地区</dt><dd>{districtName}</dd></div>
            {visiblePilgrimageNote && <div><dt>霊場・札所</dt><dd>{visiblePilgrimageNote}</dd></div>}
            <div>
              <dt>寺院公式サイト</dt>
              <dd class={officialSite?.status === "あり" ? "confirmed-pill" : "pending-pill"}>
                {officialSite?.status === "あり" && officialSite.url ? (
                  <a href={officialSite.url} target="_blank" rel="noreferrer">あり</a>
                ) : (
                  officialSite?.status || "未確認"
                )}
              </dd>
            </div>
          </dl>
        </section>

        <section class="side-panel temple-map-panel">
          <h2>地図・経路</h2>
          <iframe
            title={`${temple.name}のGoogleマップ`}
            src={visibleMapEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <a class="button-link" href={mapUrl} target="_blank" rel="noreferrer">Googleマップで開く</a>
        </section>

        <section class="side-panel research-panel">
          <h2>これから調べること</h2>
          <ul>
            {researchTodos.map((todo) => <li>{todo}</li>)}
          </ul>
        </section>

        <section class="side-panel editorial-note">
          <span>ATAWI TEMPLE編集部</span>
          <h2>情報を更新しています</h2>
          <p>公開資料と現地確認を照合し、確認できた情報から段階的に加筆します。</p>
          <a class="button-link" href="/correction/">情報提供掲示板</a>
        </section>
      </aside>
    </div>
    <nav class="mobile-sticky-cta" aria-label="法要・帰省の固定導線" data-mobile-sticky-cta hidden>
      <a href="/guide/houyou-kisei/" data-track-click="houyou_bridge_click">帰省チェック</a>
      <a href={mobileKarteUrl} data-track-click="jikka_cta_click">実家カルテ</a>
      <a href={LINE_URL} target="_blank" rel="noopener" data-track-click="line_click">LINE</a>
    </nav>
    <script is:inline>
      // @ts-nocheck
      (function () {
        function trackerEndpoint() {
          var tracker = document.querySelector("script[data-fujigaoka-analytics]");
          if (!tracker || !tracker.src || location.hostname !== "temple.atawi.link") return null;
          return {
            url: new URL("/api/click", tracker.src).href,
            siteId: tracker.getAttribute("data-site") || "atawi-temple",
          };
        }

        function sendEvent(eventName) {
          var endpoint = trackerEndpoint();
          if (!endpoint) return;
          var payload = JSON.stringify({
            site_id: endpoint.siteId,
            path: location.pathname + location.search,
            url: location.href,
            referrer: document.referrer || "",
            event_name: eventName,
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon(endpoint.url, new Blob([payload], { type: "application/json" }));
            return;
          }
          if (window.fetch) {
            fetch(endpoint.url, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: payload,
              mode: "cors",
              credentials: "omit",
              keepalive: true,
            }).catch(function () {});
          }
        }

        window.addEventListener("load", function () {
          sendEvent("temple_landing");
        });

        var bridge = document.querySelector("[data-houyou-bridge]");
        if (bridge && "IntersectionObserver" in window) {
          var bridgeSeen = false;
          var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (bridgeSeen || !entry.isIntersecting) return;
              bridgeSeen = true;
              sendEvent("houyou_bridge_view");
              observer.disconnect();
            });
          }, { threshold: 0.35 });
          observer.observe(bridge);
        }

        var sticky = document.querySelector("[data-mobile-sticky-cta]");
        if (!sticky) return;
        function updateSticky() {
          var doc = document.documentElement;
          var scrollable = Math.max(1, doc.scrollHeight - window.innerHeight);
          var progress = window.scrollY / scrollable;
          var shouldShow = window.matchMedia("(max-width: 820px)").matches && progress >= 0.25;
          sticky.hidden = !shouldShow;
        }
        window.addEventListener("scroll", updateSticky, { passive: true });
        window.addEventListener("resize", updateSticky);
        updateSticky();
      })();
    </script>
    {sameDistrictTemples.length > 0 && (
      <section class="same-district-temples">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Same Area</p>
            <h2>同じ地区の寺院</h2>
          </div>
          <a href={districtUrl}>同じ地区をすべて見る</a>
        </div>
        <div class="same-district-grid">
          {sameDistrictTemples.map((item) => (
            <a href={`/temples/${item.slug}/`} data-track-click="temple_related_temple_click">
              <span>{getTempleStatusLabel(item)}</span>
              <strong>{item.name}</strong>
              <em>{item.area} / {item.sect}</em>
            </a>
          ))}
        </div>
      </section>
    )}
    {sameSectTemples.length > 0 && (
      <section class="same-district-temples">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Same Sect</p>
            <h2>同じ宗派・関連法人の寺院</h2>
          </div>
          {currentSectSlug && <a href={`/sects/${currentSectSlug}/`}>宗派別一覧を見る</a>}
        </div>
        <div class="same-district-grid">
          {sameSectTemples.map((item) => (
            <a href={`/temples/${item.slug}/`} data-track-click="temple_related_temple_click">
              <span>{getTempleStatusLabel(item)}</span>
              <strong>{item.name}</strong>
              <em>{getDistrictName(item.district_id)} / {item.sect}</em>
            </a>
          ))}
        </div>
      </section>
    )}
    {nearbyTemples.length > 0 && (
      <section class="same-district-temples">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Nearby</p>
            <h2>近隣の寺院</h2>
          </div>
          <a href={mapPageUrl} data-track-click="temple_map_click">地図で見る</a>
        </div>
        <div class="same-district-grid">
          {nearbyTemples.map((item) => (
            <a href={`/temples/${item.slug}/`} data-track-click="temple_related_temple_click">
              <span>{getTempleStatusLabel(item)}</span>
              <strong>{item.name}</strong>
              <em>{getDistrictName(item.district_id)} / {item.sect}</em>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
