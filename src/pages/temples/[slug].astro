---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  allTemples,
  getDistrictById,
  getDistrictName,
  getPhotoCategory,
  getTempleBySlug,
  getTempleMediaBySlug,
  getTempleStatusLabel,
  googleMapsEmbedUrl,
  googleMapsUrl,
  googleMapsWebEmbedUrl,
  hasDetailPage,
  isUnknownValue,
} from "../../lib/temples";
import {
  getMonogatariLinksBySlug,
  getMonogatariRelationLabel,
  realEstateFunnel,
} from "../../lib/related-monogatari";

export function getStaticPaths() {
  return allTemples.filter(hasDetailPage).map((temple) => ({ params: { slug: temple.slug } }));
}

const temple = getTempleBySlug(Astro.params.slug || "");
if (!temple || !hasDetailPage(temple)) return Astro.redirect("/temples/");

const districtName = getDistrictName(temple.district_id);
const district = getDistrictById(temple.district_id);
const districtUrl = district ? `/areas/${district.slug}/` : "/areas/";
const mapPageUrl = temple.district_id
  ? `/map/?district=${temple.district_id}&q=${encodeURIComponent(temple.name)}`
  : `/map/?q=${encodeURIComponent(temple.name)}`;
const mapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY;
const mapEmbedUrl = googleMapsEmbedUrl(temple, mapsApiKey);
const mapFallbackEmbedUrl = googleMapsWebEmbedUrl(temple);
const visibleMapEmbedUrl = mapEmbedUrl || mapFallbackEmbedUrl;
const mapUrl = googleMapsUrl(temple);
const showKana = !isUnknownValue(temple.name_kana);
const media = getTempleMediaBySlug(temple.slug);
const galleryPhotos = media?.photos.filter((photo) => photo.src !== media.hero_image) || [];
const historicalSections = "historical_sections" in temple && Array.isArray(temple.historical_sections)
  ? temple.historical_sections
  : [];
const culturalAssets = "cultural_assets" in temple && Array.isArray(temple.cultural_assets)
  ? temple.cultural_assets
  : [];
const researchTodos = "research_todos" in temple && Array.isArray(temple.research_todos)
  ? temple.research_todos
  : ["創建・沿革", "ご本尊", "参拝情報", "文化財・寺宝", "現地写真"];
const pageSummary = "page_summary" in temple && temple.page_summary
  ? temple.page_summary
  : temple.history_summary;
const foundedPeriod = "founded_period" in temple && temple.founded_period
  ? temple.founded_period
  : "調査中";
const heritageStatus = "heritage_status" in temple && temple.heritage_status
  ? temple.heritage_status
  : "調査中";
const pilgrimageNote = "pilgrimage_note" in temple && temple.pilgrimage_note
  ? temple.pilgrimage_note
  : null;
const publicationNotice: any = "publication_notice" in temple && temple.publication_notice
  ? temple.publication_notice
  : null;
const dankaInfo: any = "danka_info" in temple && temple.danka_info ? temple.danka_info : null;
const annualEvents = dankaInfo && Array.isArray(dankaInfo.annual_events) ? dankaInfo.annual_events : [];
const monogatariLinks = getMonogatariLinksBySlug(temple.slug);
const sameDistrictTemples = allTemples
  .filter((item) => item.slug !== temple.slug && item.district_id === temple.district_id && hasDetailPage(item))
  .sort((a, b) => (a.status === "existing" ? 0 : 1) - (b.status === "existing" ? 0 : 1))
  .slice(0, 5);

const field = (value: string | null | undefined, pending = "調査中") => ({
  text: isUnknownValue(value) ? pending : value,
  pending: isUnknownValue(value),
});
const deity = field(temple.main_deity, "調査中・加筆待ち");
const officialSite = dankaInfo?.official_site;
---

<BaseLayout
  title={`${temple.name}｜${districtName}・${temple.address}・${temple.sect}｜ATAWI TEMPLE`}
  description={`${temple.name}の住所、宗派、歴史、文化財、写真、調査状況を整理するATAWI TEMPLEの寺院情報ページです。`}
>
  <article class="temple-profile">
    {publicationNotice && (
      <section class="publication-notice publication-notice--top" aria-label={publicationNotice.label || "掲載に関するお知らせ"}>
        <div class="publication-notice__inner">
          <span>{publicationNotice.label || "掲載に関するお知らせ"}</span>
          <h2>{publicationNotice.title}</h2>
          {publicationNotice.body.map((paragraph: string) => <p>{paragraph}</p>)}
        </div>
      </section>
    )}
    <header class="temple-masthead">
      <nav class="breadcrumbs" aria-label="パンくず">
        <a href="/">ATAWI TEMPLE</a>
        <a href="/temples/">寺院一覧</a>
        <a href={districtUrl}>{districtName}地区</a>
        <span aria-current="page">{temple.name}</span>
      </nav>
      <div class="temple-heading">
        <div>
          <p class="eyebrow">{districtName}地区・{getTempleStatusLabel(temple)}</p>
          <h1>{temple.name}</h1>
          {showKana && <p class="temple-kana">{temple.name_kana}</p>}
        </div>
        <div class="research-badge">
          <span>ページ充実度</span>
          <strong>{media ? "現地写真・資料あり" : "基礎情報・調査中"}</strong>
          <small>最終確認 {temple.last_verified_at.replaceAll("-", ".")}</small>
        </div>
      </div>
      <p class="temple-lead">{pageSummary}</p>
      {temple.aliases.length > 0 && (
        <p class="alias-line"><span>別称・関連名称</span>{temple.aliases.join("／")}</p>
      )}
      <dl class="temple-summary-strip" aria-label="寺院の基本情報">
        <div><dt>寺院名</dt><dd>{temple.name}</dd></div>
        <div><dt>地区</dt><dd>{districtName}</dd></div>
        <div><dt>住所</dt><dd>{temple.address}</dd></div>
        <div><dt>宗派</dt><dd>{temple.sect}</dd></div>
      </dl>
      <div class="temple-primary-actions" aria-label="寺院ページ上部の導線">
        <a class="button-link" href={districtUrl}>同じ地区の寺院を見る</a>
        <a class="button-link secondary-button" href={mapPageUrl} data-track-click="temple_map_click">地図で見る</a>
        <a class="button-link secondary-button" href="/temples/">寺院一覧へ戻る</a>
      </div>
    </header>

    <section class="temple-visual" aria-label={`${temple.name}の写真`}>
      {media ? (
        <>
          <figure class="temple-cover">
            <img src={media.hero_image} alt={`${temple.name}の主写真`} loading="eager" />
            <figcaption>現地写真・{getPhotoCategory(media.photos[0]?.category_id)?.label || "寺院外観"}</figcaption>
          </figure>
          <div class="temple-photo-strip">
            {galleryPhotos.slice(0, 5).map((photo) => (
              <figure>
                <img src={photo.src} alt={photo.alt} loading="lazy" />
                <figcaption>{getPhotoCategory(photo.category_id)?.label || "現地写真"}</figcaption>
              </figure>
            ))}
          </div>
        </>
      ) : (
        <div class="pending-photo">
          {publicationNotice ? (
            <>
              <strong>写真掲載を見合わせています</strong>
              <span>関係者からの明確な意思表示を受け、当サイトでの写真掲載を行っていません。</span>
            </>
          ) : (
            <>
              <strong>写真を準備しています</strong>
              <span>現地訪問後に、本堂・境内・入口・説明板の写真を掲載します。</span>
            </>
          )}
        </div>
      )}
    </section>

    <section class="temple-fact-band" aria-label="寺院の要点">
      <div><span>宗派</span><strong>{temple.sect}</strong></div>
      <div><span>創建・年代</span><strong class={foundedPeriod === "調査中" ? "pending-text" : ""}>{foundedPeriod}</strong></div>
      <div><span>文化財・史跡</span><strong class={heritageStatus === "調査中" ? "pending-text" : ""}>{heritageStatus}</strong></div>
      <div><span>所在地</span><strong>{temple.area}・磐田市</strong></div>
    </section>

    <div class="temple-content-grid">
      <main class="temple-main-content">
        <section class="detail-panel">
          <p class="section-number">01</p>
          <h2>この寺院について</h2>
          <p class="summary-copy">{temple.history_summary}</p>
          {deity.pending && (
            <div class="pending-inline">
              <span>ご本尊</span><strong>{deity.text}</strong><small>寺院資料・現地聞き取りで確認予定</small>
            </div>
          )}
        </section>

        <section class="detail-panel">
          <p class="section-number">02</p>
          <h2>歴史と背景</h2>
          {historicalSections.length > 0 ? (
            <div class="history-timeline">
              {historicalSections.map((item) => (
                <article>
                  <h3>{item.heading}</h3>
                  <p>{item.body}</p>
                </article>
              ))}
            </div>
          ) : (
            <div class="pending-block">
              <strong>沿革は調査中です</strong>
              <p>創建年代、開山・開基、移転・再建の履歴を、寺院資料と地域資料から確認して加筆します。</p>
            </div>
          )}
        </section>

        <section class="detail-panel">
          <p class="section-number">03</p>
          <h2>文化財・見どころ</h2>
          {culturalAssets.length > 0 ? (
            <div class="heritage-list">
              {culturalAssets.map((asset) => (
                <article>
                  <div><span>{asset.designation}</span><h3>{asset.name}</h3></div>
                  <p>{asset.summary}</p>
                </article>
              ))}
            </div>
          ) : (
            <div class="pending-block">
              <strong>文化財・寺宝は加筆待ちです</strong>
              <p>指定文化財、建築、仏像、石造物、古文書、境内の見どころを調査します。</p>
            </div>
          )}
        </section>

        {monogatariLinks.length > 0 && (
          <section class="detail-panel monogatari-panel">
            <p class="section-number">04</p>
            <h2>磐田物語で読む</h2>
            <p class="monogatari-lead">
              この寺院やゆかりの土地の歴史を、姉妹サイト「磐田物語」の読み物でご覧いただけます。
            </p>
            <ul class="monogatari-link-list">
              {monogatariLinks.map((link) => (
                <li>
                  <a href={link.url}>
                    {link.relation === "direct" && (
                      <span class="monogatari-relation-label">{getMonogatariRelationLabel(link.relation)}</span>
                    )}
                    <span class="monogatari-link-title">{link.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        {realEstateFunnel.enabled && (
          <section class="detail-panel real-estate-note">
            <p class="section-number">Estate</p>
            <h2>お墓・実家の整理もあわせて考える</h2>
            <p>
              {temple.name}や地域のお墓を調べる中で、実家の名義、相続登記、空き家の管理が気になった場合は、
              <a href={realEstateFunnel.link_url} target="_blank" rel="noopener noreferrer">ATAWI FUDOSAN</a>
              の売却前カルテで、売る前に支障になりそうな点を整理できます。
            </p>
            {realEstateFunnel.link_url && (
              <a class="button-link" href={realEstateFunnel.link_url} target="_blank" rel="noopener noreferrer">{realEstateFunnel.link_label}</a>
            )}
          </section>
        )}

        <section class="detail-panel">
          <p class="section-number">05</p>
          <h2>檀家の営み・行事</h2>
          {dankaInfo && (annualEvents.length > 0 || dankaInfo.cemetery || dankaInfo.organization || dankaInfo.community_role) ? (
            <div class="danka-info-list">
              {annualEvents.length > 0 && (
                <article>
                  <h3>年中行事・法要</h3>
                  <ul>
                    {annualEvents.map((event: any) => (
                      <li><strong>{event.name}</strong>{event.timing && <span>（{event.timing}）</span>}{event.note && <p>{event.note}</p>}</li>
                    ))}
                  </ul>
                </article>
              )}
              {dankaInfo.cemetery && (
                <article>
                  <h3>供養・墓地</h3>
                  <p>{dankaInfo.cemetery}</p>
                </article>
              )}
              {dankaInfo.organization && (
                <article>
                  <h3>檀家組織</h3>
                  <p>{dankaInfo.organization}</p>
                </article>
              )}
              {dankaInfo.community_role && (
                <article>
                  <h3>地域との関わり</h3>
                  <p>{dankaInfo.community_role}</p>
                </article>
              )}
            </div>
          ) : (
            <div class="pending-block">
              <strong>檀家向け情報は調査中です</strong>
              <p>年中行事・法要、供養・墓地、檀家組織、地域との関わりを、寺院公式情報・公的資料から確認して加筆します。</p>
            </div>
          )}
        </section>

        <section class="detail-panel">
          <p class="section-number">06</p>
          <h2>写真で見る境内</h2>
          {media ? (
            <div class="photo-record-list">
              {media.photos.map((photo) => (
                <figure>
                  <img src={photo.src} alt={photo.alt} loading="lazy" />
                  <figcaption>
                    <strong>{getPhotoCategory(photo.category_id)?.label || "現地写真"}</strong>
                    <span>{photo.caption}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <div class="pending-block">
              {publicationNotice ? (
                <>
                  <strong>写真掲載を見合わせています</strong>
                  <p>関係者からの明確な意思表示を受け、当サイトでの写真掲載を行っていません。</p>
                </>
              ) : (
                <>
                  <strong>現地写真を準備しています</strong>
                  <p>初回訪問後に掲載します。</p>
                </>
              )}
            </div>
          )}
        </section>

        <section class="detail-panel sources-panel">
          <p class="section-number">07</p>
          <h2>出典・参考資料</h2>
          <ol class="source-records">
            {temple.sources.map((source) => (
              <li>
                <span>{source.type}</span>
                {"url" in source && source.url ? (
                  <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
                ) : <strong>{source.title}</strong>}
                <p>{source.note}</p>
              </li>
            ))}
          </ol>
        </section>
      </main>

      <aside class="temple-sidebar">
        <section class="side-panel">
          <h2>基本情報</h2>
          <dl class="side-info-list">
            <div><dt>正式名称</dt><dd>{temple.name}</dd></div>
            <div><dt>読み方</dt><dd>{showKana ? temple.name_kana : "調査中"}</dd></div>
            <div><dt>宗派</dt><dd>{temple.sect}</dd></div>
            <div><dt>ご本尊</dt><dd class={deity.pending ? "pending-text" : ""}>{deity.text}</dd></div>
            <div><dt>住所</dt><dd>{temple.address}</dd></div>
            <div><dt>地区</dt><dd>{districtName}</dd></div>
            {pilgrimageNote && <div><dt>霊場・札所</dt><dd>{pilgrimageNote}</dd></div>}
            <div>
              <dt>寺院公式サイト</dt>
              <dd class={officialSite?.status === "あり" ? "confirmed-pill" : "pending-pill"}>
                {officialSite?.status === "あり" && officialSite.url ? (
                  <a href={officialSite.url} target="_blank" rel="noreferrer">あり</a>
                ) : (
                  officialSite?.status || "未確認"
                )}
              </dd>
            </div>
          </dl>
        </section>

        <section class="side-panel temple-map-panel">
          <h2>地図・経路</h2>
          <iframe
            title={`${temple.name}のGoogleマップ`}
            src={visibleMapEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <a class="button-link" href={mapUrl} target="_blank" rel="noreferrer">Googleマップで開く</a>
        </section>

        <section class="side-panel research-panel">
          <h2>これから調べること</h2>
          <ul>
            {researchTodos.map((todo) => <li>{todo}</li>)}
          </ul>
        </section>

        {realEstateFunnel.enabled && (
          <section class="side-panel fudosan-side-panel">
            <span>運営元の相談窓口</span>
            <h2>実家・相続・空き家</h2>
            <p>寺院や墓地の確認とあわせて、実家の土地・建物の整理が必要になったときの入口です。</p>
            <a href={realEstateFunnel.link_url} target="_blank" rel="noopener noreferrer">ATAWI FUDOSANへ</a>
          </section>
        )}
        <section class="side-panel editorial-note">
          <span>ATAWI TEMPLE編集部</span>
          <h2>情報を更新しています</h2>
          <p>公開資料と現地確認を照合し、確認できた情報から段階的に加筆します。</p>
          <a class="button-link" href="/correction/">情報提供掲示板</a>
        </section>
      </aside>
    </div>
    {sameDistrictTemples.length > 0 && (
      <section class="same-district-temples">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Same Area</p>
            <h2>同じ地区の寺院</h2>
          </div>
          <a href={districtUrl}>同じ地区をすべて見る</a>
        </div>
        <div class="same-district-grid">
          {sameDistrictTemples.map((item) => (
            <a href={`/temples/${item.slug}/`} data-track-click="temple_related_temple_click">
              <span>{getTempleStatusLabel(item)}</span>
              <strong>{item.name}</strong>
              <em>{item.area} / {item.sect}</em>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
