---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  allTemples,
  getDistrictName,
  getTempleBySlug,
  isUnknownValue,
  knownValue,
} from "../../lib/temples";

export function getStaticPaths() {
  return allTemples.map((temple) => ({
    params: { slug: temple.slug },
  }));
}

const temple = getTempleBySlug(Astro.params.slug || "");
const districtName = getDistrictName(temple?.district_id);
const showKana = temple ? !isUnknownValue(temple.name_kana) : false;

if (!temple) {
  return Astro.redirect("/temples/");
}
---

<BaseLayout
  title={`${temple.name}｜住所・宗派・地区｜ATAWI temple`}
  description={`${temple.name}の住所、宗派、地区、出典を整理するATAWI templeの寺院情報ページです。`}
>
  <article class="detail">
    <header class="page-title">
      <p class="eyebrow">{districtName} / {temple.status_label}</p>
      <h1>{temple.name}</h1>
      {showKana && <p class="kana">{temple.name_kana}</p>}
    </header>

    <section class="section">
      <h2>基本情報</h2>
      <dl class="info-list">
        <div><dt>寺院名</dt><dd>{temple.name}</dd></div>
        {showKana && <div><dt>読み方</dt><dd>{temple.name_kana}</dd></div>}
        <div><dt>住所</dt><dd>{temple.address}</dd></div>
        <div><dt>地区</dt><dd>{districtName}</dd></div>
        <div><dt>宗派</dt><dd>{temple.sect}</dd></div>
        <div><dt>状態</dt><dd>{temple.status_label}</dd></div>
        <div><dt>有人・無人</dt><dd>{knownValue(temple.manned_status)}</dd></div>
        <div><dt>御朱印</dt><dd>{knownValue(temple.goshuin_status)}</dd></div>
        <div><dt>現地訪問</dt><dd>{knownValue(temple.visit_status, "未訪問")}</dd></div>
        <div><dt>最終確認日</dt><dd>{temple.last_verified_at}</dd></div>
      </dl>
    </section>

    <section class="section">
      <h2>掲載内容</h2>
      <p>{temple.history_summary}</p>
      <p class="notice">現在は公式名簿に基づく基礎情報を掲載しています。由緒、文化財、写真、現地確認情報は、資料確認ができたものから追記します。</p>
    </section>

    <section class="section">
      <h2>ご本尊</h2>
      <p>{knownValue(temple.main_deity, "現在確認中です。")}</p>
    </section>

    <section class="section">
      <h2>出典・参考資料</h2>
      <ul class="source-list">
        {
          temple.sources.map((source) => (
            <li>
              {"url" in source && source.url ? (
                <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
              ) : (
                source.title
              )}
              （{source.type}） {source.note}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section notice">
      <h2>非公式サイトである旨</h2>
      <p>
        ATAWI templeは各寺院の公式サイトではありません。寺院から監修・確認を受けている場合を除き、
        公開情報および現地訪問をもとに、ATAWI temple編集部が独自に調査・整理しています。
      </p>
      <a class="button-link" href="/correction/">このページの情報を提供・訂正する</a>
    </section>
  </article>
</BaseLayout>
