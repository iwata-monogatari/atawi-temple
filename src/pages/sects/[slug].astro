---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TempleCard from "../../components/TempleCard.astro";
import { allSects, getSectBySlug, getTemplesBySect } from "../../lib/temples";

export function getStaticPaths() {
  return allSects.map((sect) => ({
    params: { slug: sect.slug },
  }));
}

const sect = getSectBySlug(Astro.params.slug || "");

if (!sect) {
  return Astro.redirect("/sects/");
}

const temples = getTemplesBySect(sect.name);
---

<BaseLayout
  title={`${sect.name}の登録一覧｜ATAWI TEMPLE`}
  description={`${sect.name}として整理している磐田市内の寺院・関連宗教法人一覧です。`}
>
  <section class="page-title">
    <p class="eyebrow">Sect / {sect.slug}</p>
    <h1>{sect.name}の登録一覧</h1>
    <p>{sect.name}として整理している登録を、地区・住所とあわせて確認できます。</p>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>登録寺院</h2>
      <a href={`/search/?sect=${encodeURIComponent(sect.name)}`}>この宗派で検索する</a>
    </div>
    <div class="card-grid">
      {temples.map((temple) => <TempleCard temple={temple} />)}
    </div>
  </section>

  <section class="section">
    <a class="button-link" href="/sects/">宗派・関連法人一覧へ戻る</a>
  </section>
</BaseLayout>
