---
import BaseLayout from "../layouts/BaseLayout.astro";
import TempleCard from "../components/TempleCard.astro";
import type { Temple } from "../lib/temples";
import {
  countTemplesByDistrict,
  countTemplesBySect,
  getTempleBySlug,
} from "../lib/temples";

const districtCounts = countTemplesByDistrict();
const sectCounts = countTemplesBySect().slice(0, 6);
const featured = [
  "kokubunji-mitsuke",
  "gyokoji-ikeda",
  "senkoji-mitsuke",
  "kokuseiji-kaketsuka",
  "shokoji-miyanoshiki",
  "myohoji-ikeda",
]
  .map((slug) => getTempleBySlug(slug))
  .filter((temple): temple is Temple => Boolean(temple));
---

<BaseLayout>
  <section class="hero">
    <div>
      <p class="eyebrow">公開資料と現地訪問で整理する地域寺院情報</p>
      <h1>磐田市のお寺・寺院データベース</h1>
      <p class="brand-name">ATAWI temple</p>
      <form class="hero-search" action="/search/" method="get">
        <label for="q">寺院名・住所・宗派・ご本尊・札所名から検索</label>
        <div>
          <input
            id="q"
            name="q"
            type="search"
            placeholder="宣光寺 / 見付 / 曹洞宗 / 薬師如来 / 廃寺"
          />
          <button type="submit">検索</button>
        </div>
      </form>
    </div>
  </section>

  <section class="filter-band" aria-label="主要な絞り込み">
    <a href="/search/?district=mitsuke">見付</a>
    <a href="/search/?district=nakaizumi">中泉</a>
    <a href="/search/?status=existing">現存寺院</a>
    <a href="/search/?status=ruin">廃寺・寺院跡</a>
    <a href="/search/?sect=曹洞宗">曹洞宗</a>
    <a href="/sects/">宗派から探す</a>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>9地区から探す</h2>
      <a href="/search/">検索へ</a>
    </div>
    <div class="district-grid">
      {
        districtCounts.map((district) => (
          <a class="district-card" href={`/areas/${district.slug}/`}>
            <strong>{district.name}</strong>
            <span>{district.summary}</span>
            <em>{district.count}件登録</em>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>宗派から探す</h2>
      <a href="/sects/">宗派一覧へ</a>
    </div>
    <div class="filter-band">
      {sectCounts.map((sect) => <a href={`/sects/${sect.slug}/`}>{sect.name} {sect.count}件</a>)}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>調査優先の寺院</h2>
      <a href="/temples/">すべて見る</a>
    </div>
    <div class="card-grid">
      {featured.map((temple) => <TempleCard temple={temple} />)}
    </div>
  </section>

  <section class="section two-column">
    <div>
      <h2>現在の掲載範囲</h2>
      <p>
        静岡県知事所轄宗教法人名簿に掲載された磐田市内の寺院・関連宗教法人を基礎データとして公開しています。
        地区分類、宗派分類、検索から、調べたい寺院へすばやく移動できます。
      </p>
    </div>
    <div>
      <h2>情報提供について</h2>
      <p>
        名称、住所、宗派、由緒、写真非掲載などの訂正・情報提供を受け付けます。
        投稿内容は自動公開せず、公開資料や現地確認と照合して反映します。
      </p>
      <a class="button-link" href="/correction/">情報提供・訂正へ</a>
    </div>
  </section>
</BaseLayout>
