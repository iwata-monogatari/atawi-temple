---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  allTemples,
  allTempleUpdates,
  countTemplesByStatus,
  countUnassignedDistrictTemples,
  countTemplesByDistrict,
  countTemplesBySect,
  getDistrictName,
  getTempleDisplaySummary,
  getTempleStatusLabel,
  getTempleBySlug,
  getTempleMediaBySlug,
  getVisibleTempleMediaPhotos,
  hasDetailPage,
  isCemeteryServiceInfo,
  isUnknownValue,
} from "../lib/temples";

const districtDisplayOrder = [
  "mitsuke",
  "nakaizumi",
  "toyoda",
  "mikuriya",
  "nanbu",
  "koyo",
  "ryuyo",
  "fukude",
  "toyooka",
];
const districtCounts = countTemplesByDistrict().sort(
  (a, b) => districtDisplayOrder.indexOf(a.district_id) - districtDisplayOrder.indexOf(b.district_id),
);
const districtCards = districtCounts.map((district) => ({
  ...district,
  representatives: allTemples
    .filter((temple) => temple.district_id === district.district_id && hasDetailPage(temple))
    .slice(0, 2)
    .map((temple) => temple.name),
}));
const allSectCounts = countTemplesBySect();
const statusCounts = countTemplesByStatus();
const unknownDistrictCount = countUnassignedDistrictTemples();
const recentUpdates = allTempleUpdates.slice(0, 5).map((update) => ({
  ...update,
  summary: isCemeteryServiceInfo(update.summary) ? "現地写真と基礎情報を更新しました。" : update.summary,
  temple: getTempleBySlug(update.temple_slug),
}));

const pickupExcludedSlugs = new Set(["shinshinkyo-honbu-mitsuke"]);
const pinnedPickupSlugs = ["myosenji-araide"];
const pickupPool = allTemples
  .filter((temple) => hasDetailPage(temple) && temple.status === "existing" && !pickupExcludedSlugs.has(temple.slug))
  .map((temple) => {
    const districtName = getDistrictName(temple.district_id);
    const media = getTempleMediaBySlug(temple.slug);
    const visiblePhotos = getVisibleTempleMediaPhotos(temple.slug);
    const photo = media
      ? visiblePhotos.find((item) => item.src === media.hero_image) || visiblePhotos[0] || null
      : null;
    const image = photo?.src ?? null;
    const imageAlt = photo?.alt ?? `${temple.name}の代表写真`;
    const summary = getTempleDisplaySummary(temple, districtName);
    return {
      slug: temple.slug,
      name: temple.name,
      nameKana: isUnknownValue(temple.name_kana) ? null : temple.name_kana,
      area: districtName,
      status: temple.status,
      statusLabel: getTempleStatusLabel(temple),
      summary,
      image,
      imageAlt,
    };
  })
  .filter((temple) => Boolean(temple.image));
const pickupPoolJson = JSON.stringify(pickupPool).replace(/</g, "\\u003c");
const pinnedPickupSlugsJson = JSON.stringify(pinnedPickupSlugs).replace(/</g, "\\u003c");

function photoAt(slug: string, index: number) {
  const photos = getVisibleTempleMediaPhotos(slug);
  const photo = photos[index] ?? photos[0];
  return photo ? { src: photo.src, alt: photo.alt } : null;
}

type HeroSlide = {
  src: string;
  alt: string;
  templeName: string;
  districtName: string;
  meta: string;
  href: string;
  objectPosition: string;
};

const heroSlideSeeds = [
  { slug: "ioji-kamada", index: 10, objectPosition: "center center" },
  { slug: "jurinji-kamiohnogo", index: 9, objectPosition: "center center" },
  { slug: "gyokoji-ikeda", index: 3, objectPosition: "center center" },
  { slug: "daijoin-nakaizumi", index: 7, objectPosition: "center center" },
  { slug: "kokubunji-mitsuke", index: 0, objectPosition: "center center" },
  { slug: "shinpoin-mukasa", index: 12, objectPosition: "center center" },
  { slug: "sojiji-minamijima", index: 3, objectPosition: "center center" },
];

const heroSlides = heroSlideSeeds
  .map((seed) => {
    const temple = getTempleBySlug(seed.slug);
    const photo = photoAt(seed.slug, seed.index);
    if (!temple || !photo) return null;
    const districtName = getDistrictName(temple.district_id);
    return {
      src: photo.src,
      alt: photo.alt,
      templeName: temple.name,
      districtName,
      meta: `${districtName}地区 / ${photo.alt}`,
      href: `/temples/${temple.slug}/`,
      objectPosition: seed.objectPosition,
    };
  })
  .filter((slide): slide is HeroSlide => Boolean(slide));
const firstHeroSlide = heroSlides[0];
const heroSlidesJson = JSON.stringify(heroSlides).replace(/</g, "\\u003c");
const iwataMonogatariBannerImage = "/assets/temples/kokubunji-mitsuke/hondo.webp";

---

<BaseLayout
  title="磐田市の菩提寺・お寺を調べる｜ATAWI TEMPLE"
  description="磐田市の菩提寺・お寺を寺院名、読み方、住所、地区、宗派から検索できます。法要やお墓参りの前に確認したい寺院情報を整理しています。"
>
  <section class="hero hero--slideshow" data-hero-slideshow>
    <div class="hero-slides" aria-hidden="true">
      {heroSlides.map((slide, index) => (
        <img
          class={index === 0 ? "hero-slide is-active" : "hero-slide"}
          src={slide.src}
          alt=""
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "auto"}
          decoding="async"
          style={`object-position: ${slide.objectPosition};`}
          data-hero-slide
        />
      ))}
    </div>
    <div class="hero-content">
      <p class="eyebrow">公開資料と現地確認をもとに整理しています</p>
      <span class="hero-rule" aria-hidden="true"></span>
      <h1>磐田市の菩提寺・お寺を調べる</h1>
      <p class="brand-name">ATAWI TEMPLE</p>
      <p class="hero-support-copy">寺院名、読み方、住所、地区、宗派から検索できます。運営：磐田市の富士ヶ丘サービス株式会社</p>
      {firstHeroSlide && (
        <div class="hero-photo-meta" aria-live="polite">
          <a id="hero-slide-link" href={firstHeroSlide.href} data-track-click="temple_detail_click">
            {firstHeroSlide.templeName}
          </a>
          <span id="hero-slide-location">{firstHeroSlide.meta}</span>
        </div>
      )}
      {heroSlides.length > 1 && (
        <div class="hero-slide-dots" aria-label="ヒーロー写真">
          {heroSlides.map((slide, index) => (
            <button
              class={index === 0 ? "hero-slide-dot is-active" : "hero-slide-dot"}
              type="button"
              aria-label={`${slide.templeName}の写真を表示`}
              aria-current={index === 0 ? "true" : undefined}
              data-hero-dot={index}
            />
          ))}
        </div>
      )}
      <form class="hero-search" action="/search/" method="get">
        <label for="q">寺院名・読み方・住所・宗派・ご本尊・札所名から検索</label>
        <div>
          <input
            id="q"
            name="q"
            type="search"
            placeholder="せんこうじ / 宣光寺 / 見付 / 曹洞宗 / 廃寺"
          />
          <button type="submit" data-track-click="temple_search_refine">検索</button>
        </div>
      </form>
    </div>
    <script is:inline type="application/json" id="hero-slide-data" set:html={heroSlidesJson} />
    <script>
      (() => {
        const root = document.querySelector("[data-hero-slideshow]");
        const dataEl = document.getElementById("hero-slide-data");
        if (!root || !dataEl) return;

        let slideData: any[] = [];
        try {
          slideData = JSON.parse(dataEl.textContent || "[]");
        } catch {
          slideData = [];
        }

        const slides = Array.from(root.querySelectorAll("[data-hero-slide]"));
        const dots = Array.from(root.querySelectorAll("[data-hero-dot]"));
        const link = document.getElementById("hero-slide-link");
        const location = document.getElementById("hero-slide-location");
        if (slides.length === 0 || slideData.length === 0) return;

        let activeIndex = 0;
        let timer: number | null = null;
        const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

        function setActiveSlide(nextIndex: number) {
          activeIndex = (nextIndex + slides.length) % slides.length;
          slides.forEach((slide, index) => {
            slide.classList.toggle("is-active", index === activeIndex);
          });
          dots.forEach((dot, index) => {
            dot.classList.toggle("is-active", index === activeIndex);
            if (index === activeIndex) {
              dot.setAttribute("aria-current", "true");
            } else {
              dot.removeAttribute("aria-current");
            }
          });

          const current = slideData[activeIndex];
          if (current && link && location) {
            link.setAttribute("href", current.href);
            link.textContent = current.templeName;
            location.textContent = current.meta;
          }
        }

        function stop() {
          if (timer) window.clearInterval(timer);
          timer = null;
        }

        function start() {
          stop();
          if (slides.length < 2 || motionQuery.matches || document.hidden) return;
          timer = window.setInterval(() => {
            setActiveSlide(activeIndex + 1);
          }, 5600);
        }

        dots.forEach((dot, index) => {
          dot.addEventListener("click", () => {
            setActiveSlide(index);
            start();
          });
        });
        root.addEventListener("mouseenter", stop);
        root.addEventListener("mouseleave", start);
        document.addEventListener("visibilitychange", start);
        motionQuery.addEventListener?.("change", start);
        start();
      })();
    </script>
  </section>

  <section class="proof-band" aria-label="登録状況">
    <article>
      <strong>{allTemples.length}</strong>
      <span>件登録</span>
    </article>
    <article>
      <strong>{districtCounts.length}</strong>
      <span>地区分類</span>
    </article>
    <article>
      <strong>{allSectCounts.length}</strong>
      <span>宗派分類</span>
    </article>
  </section>

  <section class="discovery-actions" aria-label="基本の探し方">
    <a class="discovery-card" href="/research/" data-track-click="research_index_click">
      <span>研究論文を読む</span>
      <strong>ATAWI TEMPLE 研究論文一覧</strong>
      <em>磐田の寺院史・文化財・地域社会を、出典に基づく論文で読む</em>
    </a>
    <a class="discovery-card" href="/map/" data-track-click="temple_map_click">
      <span>住所一覧・Googleマップ</span>
      <strong>住所と外部地図で確認</strong>
      <em>地区フィルタとGoogleマップリンクを一覧で確認</em>
    </a>
    <form class="discovery-card discovery-search" action="/search/" method="get">
      <label for="home-q">寺院名で探す</label>
      <div>
        <input id="home-q" name="q" type="search" placeholder="寺院名・読み方・住所" />
        <button type="submit" data-track-click="temple_search_refine">検索</button>
      </div>
    </form>
  </section>

  <nav class="top-primary-links" aria-label="上部の主要リンク">
    <a href="/temples/">全寺院一覧を見る</a>
    <a href="/map/" data-track-click="temple_map_click">住所一覧を見る</a>
    <a href="/search/">条件検索へ</a>
    <a href="/guide/houyou-kisei/" data-track-click="houyou_bridge_click">法要・帰省の確認</a>
  </nav>

  <section class="filter-band" aria-label="主要な絞り込み">
    <a href="/search/?district=mitsuke">見付</a>
    <a href="/search/?district=nakaizumi">中泉</a>
    <a href="/search/?status=existing">現存寺院</a>
    {statusCounts.ruin ? <a href="/search/?status=ruin">廃寺・寺院跡</a> : <span class="filter-chip-disabled">廃寺・寺院跡 準備中</span>}
    <a href="/search/?sect=曹洞宗">曹洞宗</a>
    <a href="/map/" data-track-click="temple_map_click">住所一覧を見る</a>
    <a href="/sects/">宗派から探す</a>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>ピックアップ寺院</h2>
      <a href="/temples/">ATAWI TEMPLEに登録されている寺院をすべて見る</a>
    </div>
    <div id="pickup-temples" class="pickup-grid" data-pickup-count="6">
      <p class="small">読み込み中...</p>
    </div>
    <script is:inline type="application/json" id="pickup-temple-data" set:html={pickupPoolJson} />
    <script is:inline type="application/json" id="pinned-pickup-slugs" set:html={pinnedPickupSlugsJson} />
    <script>
      function createPickupCard(temple: any) {
        const article = document.createElement("article");
        article.className = temple.pinned ? "pickup-card pickup-card--pinned" : "pickup-card";

        const link = document.createElement("a");
        link.className = "pickup-card-photo";
        link.href = `/temples/${temple.slug}/`;
        link.setAttribute("aria-label", `${temple.name}の詳細を見る`);
        link.setAttribute("data-track-click", "temple_detail_click");
        const img = document.createElement("img");
        img.src = temple.image;
        img.alt = temple.imageAlt;
        img.loading = "lazy";
        link.appendChild(img);
        const badge = document.createElement("span");
        badge.className = `pickup-card-badge status-${temple.status}`;
        badge.textContent = temple.statusLabel;
        link.appendChild(badge);
        article.appendChild(link);

        const body = document.createElement("div");
        body.className = "pickup-card-body";

        const areaSpan = document.createElement("span");
        areaSpan.className = "pickup-card-area";
        areaSpan.textContent = `${temple.area}地区`;
        body.appendChild(areaSpan);

        const heading = document.createElement("h3");
        const nameLink = document.createElement("a");
        nameLink.href = `/temples/${temple.slug}/`;
        nameLink.setAttribute("data-track-click", "temple_detail_click");
        nameLink.textContent = temple.name;
        heading.appendChild(nameLink);
        body.appendChild(heading);

        if (temple.nameKana) {
          const kana = document.createElement("p");
          kana.className = "kana";
          kana.textContent = temple.nameKana;
          body.appendChild(kana);
        }

        article.appendChild(body);

        return article;
      }

      function renderPickupTemples() {
        const dataEl = document.getElementById("pickup-temple-data");
        const pinnedEl = document.getElementById("pinned-pickup-slugs");
        const container = document.getElementById("pickup-temples");
        if (!dataEl || !container) return;

        let pool: any[] = [];
        let pinnedSlugs: string[] = [];
        try {
          pool = JSON.parse(dataEl.textContent || "[]");
          pinnedSlugs = JSON.parse(pinnedEl?.textContent || "[]");
        } catch {
          pool = [];
          pinnedSlugs = [];
        }
        if (!Array.isArray(pool) || pool.length === 0) {
          container.innerHTML = "";
          return;
        }
        if (!Array.isArray(pinnedSlugs)) pinnedSlugs = [];

        const count = Math.min(6, pool.length);
        const pinned = pinnedSlugs
          .map((slug) => pool.find((temple) => temple.slug === slug))
          .filter(Boolean)
          .map((temple) => ({ ...temple, pinned: true }));
        const pinnedSlugSet = new Set(pinned.map((temple) => temple.slug));
        const randomPool = pool.filter((temple) => !pinnedSlugSet.has(temple.slug));
        const usedIndexes = new Set<number>();
        const picked: any[] = [];
        const randomCount = Math.max(0, count - pinned.length);
        while (picked.length < randomCount && usedIndexes.size < randomPool.length) {
          const index = Math.floor(Math.random() * randomPool.length);
          if (usedIndexes.has(index)) continue;
          usedIndexes.add(index);
          picked.push(randomPool[index]);
        }

        container.innerHTML = "";
        for (const temple of [...pinned, ...picked].slice(0, count)) {
          container.appendChild(createPickupCard(temple));
        }
      }

      renderPickupTemples();
    </script>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>9地区から探す</h2>
      <a href="/search/">検索へ</a>
    </div>
    <div class="district-grid">
      {
        districtCards.map((district) => {
          const photo = district.hero_image
            ? { src: district.hero_image, alt: district.hero_image_alt || `${district.name}地区の代表写真` }
            : null;
          return (
            <a
              class={photo ? "district-card district-card--photo" : "district-card"}
              href={`/areas/${district.slug}/`}
              style={photo ? `background-image: linear-gradient(180deg, rgba(20,26,18,.15) 0%, rgba(20,26,18,.78) 100%), url(${photo.src})` : undefined}
              data-track-click="temple_area_click"
            >
              <strong>{district.name}</strong>
              <span>{district.summary}</span>
              <em>{district.count}件登録</em>
              {district.representatives.length > 0 && (
                <small>寺院例：{district.representatives.join("・")}</small>
              )}
            </a>
          );
        })
      }
    </div>
    {unknownDistrictCount > 0 && (
      <p class="count-note">
        地区未確定の登録が{unknownDistrictCount}件あります。9地区分類の合計にこの未確定分を加えたものが全登録件数です。
        <a href="/search/?district=__unassigned">地区未確定の寺院を見る</a>
      </p>
    )}
  </section>

  <section class="section updates-section">
    <div class="section-heading">
      <div>
        <h2>更新情報</h2>
        <span class="small" data-latest-updates-status>寺院ページの追加・更新 / 新着5件</span>
      </div>
      <a href="/updates/">6件目以降を見る</a>
    </div>
    <div class="update-list" data-latest-updates-list>
      {
        recentUpdates.map((update) => (
          <article class="update-item">
            <time datetime={update.date}>{update.date.replaceAll("-", ".")}</time>
            <div>
              <h3>
                <a href={"href" in update && update.href ? update.href : `/temples/${update.temple_slug}/`}>{update.title}</a>
              </h3>
              <p>{update.summary}</p>
              {update.temple && <span class="small">{update.temple.name} / {update.temple.area}</span>}
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <script>
    (() => {
      type LatestUpdate = {
        date?: string;
        title?: string;
        summary?: string;
        href?: string;
        temple_slug?: string;
        temple_name?: string;
        temple_area?: string;
      };

      const list = document.querySelector("[data-latest-updates-list]");
      const status = document.querySelector("[data-latest-updates-status]");
      if (!(list instanceof HTMLElement)) return;
      const updateList = list;

      function text(value: unknown) {
        return String(value || "");
      }

      function templeHref(update: LatestUpdate) {
        return update.href || (update.temple_slug ? `/temples/${encodeURIComponent(update.temple_slug)}/` : "/updates/");
      }

      function renderLatestUpdates(updates: LatestUpdate[]) {
        if (!Array.isArray(updates) || updates.length === 0) return;

        const fragment = document.createDocumentFragment();
        for (const update of updates.slice(0, 5)) {
          const item = document.createElement("article");
          item.className = "update-item";

          const time = document.createElement("time");
          time.dateTime = text(update.date);
          time.textContent = text(update.date).split("-").join(".");
          item.appendChild(time);

          const body = document.createElement("div");
          const heading = document.createElement("h3");
          const link = document.createElement("a");
          link.href = templeHref(update);
          link.textContent = text(update.title);
          heading.appendChild(link);
          body.appendChild(heading);

          const summary = document.createElement("p");
          summary.textContent = text(update.summary);
          body.appendChild(summary);

          const metaParts = [update.temple_name, update.temple_area].filter(Boolean);
          if (metaParts.length > 0) {
            const meta = document.createElement("span");
            meta.className = "small";
            meta.textContent = metaParts.join(" / ");
            body.appendChild(meta);
          }

          item.appendChild(body);
          fragment.appendChild(item);
        }

        updateList.replaceChildren(fragment);
        if (status instanceof HTMLElement) {
          const latestDate = text(updates[0]?.date).split("-").join(".");
          status.textContent = latestDate
            ? `寺院ページの追加・更新 / ${latestDate}時点`
            : "寺院ページの追加・更新 / 自動取得";
        }
      }

      fetch(`/updates/latest.json?ts=${Date.now()}`, {
        cache: "no-store",
        headers: { Accept: "application/json" },
      })
        .then((response) => (response.ok ? response.json() : null))
        .then((data) => renderLatestUpdates(data?.updates))
        .catch(() => {
          // Static markup remains as the fallback if the latest feed cannot be loaded.
        });
    })();
  </script>

  <section class="section">
    <div class="info-grid">
      <div class="info-box">
        <h2>現在の掲載範囲</h2>
        <p>
          静岡県知事所轄宗教法人名簿に掲載された磐田市内の寺院・関連宗教法人を基礎データとして公開しています。
          地区分類、宗派分類、検索から、調べたい寺院へすばやく移動できます。
        </p>
        <div class="plain-actions">
          <a href="/tokushu/">特集・読みもの</a>
          <a href="/guide/">檀家・法要の基礎ガイド</a>
          <a href="/temples/">写真のある寺院を見る</a>
        </div>
      </div>
      <div class="info-box">
        <h2>情報提供について</h2>
        <p>
          名称、住所、宗派、由緒、写真非掲載などの訂正・情報提供を受け付けます。
          投稿内容は自動公開せず、公開資料や現地確認と照合して反映します。
        </p>
        <a class="button-link" href="/correction/">情報提供掲示板へ</a>
      </div>
      <a
        class="info-box image-info-box image-info-box-link monogatari-index-box"
        href="https://iwata-monogatari.net/"
        style={`background-image: linear-gradient(135deg, rgba(255, 253, 244, 0.18) 0%, rgba(255, 249, 225, 0.26) 100%), url(${iwataMonogatariBannerImage})`}
      >
        <span>IWATA MONOGATARI</span>
        <h2>姉妹サイト「磐田物語」</h2>
        <p>
          ATAWI TEMPLEが整理する寺院の基礎データに対し、姉妹サイト「磐田物語」は磐田の歴史・伝承を読み物として伝えるサイトです。
          寺院にゆかりの人物や祭礼、地区の歴史をより深く知りたいときにご覧ください。
        </p>
        <span class="banner-link">磐田物語を読む</span>
      </a>
    </div>
  </section>
</BaseLayout>
