---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { allPhotoCategories, allTemples } from "../../../lib/temples";

const temples = [...allTemples].sort((a, b) => a.name_kana.localeCompare(b.name_kana, "ja"));
const categories = JSON.stringify(allPhotoCategories);
---

<BaseLayout
  title="写真管理｜ATAWI temple"
  description="ATAWI temple管理者専用の寺院写真アップロード画面です。"
  noindex={true}
>
  <section class="page-title admin-page-title">
    <p class="eyebrow">Administrator</p>
    <h1>寺院写真を登録する</h1>
    <p>管理者専用です。全寺院から掲載先を選び、写真と分類情報を保存します。</p>
  </section>

  <section class="search-panel photo-submit-panel" data-categories={categories}>
    <form id="photo-submit-form" class="stack-form" enctype="multipart/form-data">
      <label>
        寺院を検索
        <input id="temple-filter" type="search" placeholder="寺院名・読み方・住所で絞り込み" autocomplete="off" />
      </label>

      <label>
        掲載先の寺院
        <select id="temple-select" name="temple_slug" required>
          <option value="">寺院を選んでください（全{temples.length}件）</option>
          {
            temples.map((temple) => (
              <option
                value={temple.slug}
                data-search={`${temple.name} ${temple.name_kana} ${temple.area} ${temple.address}`}
              >
                {temple.name}（{temple.name_kana} / {temple.area}）
              </option>
            ))
          }
        </select>
      </label>

      <p id="temple-count" class="small">全{temples.length}件から選択できます。</p>

      <label>
        写真（1回につき12枚まで、1枚12MBまで）
        <input name="photos" type="file" accept="image/*" multiple required />
      </label>

      <label>
        管理メモ
        <textarea name="note" rows="4" placeholder="撮影日、場所、写真の説明、掲載時の注意など"></textarea>
      </label>

      <div class="notice">
        <strong>掲載前の確認</strong>
        <p>人の顔、車のナンバー、墓石の個人名、寺院関係者の許可が必要な箇所を確認してください。</p>
      </div>

      <div><button type="submit">管理用ストレージへ保存</button></div>
    </form>

    <section class="section preview-section" aria-live="polite">
      <div class="section-heading">
        <h2>写真分類</h2>
        <span class="small">候補を確認してから保存します</span>
      </div>
      <div id="photo-preview" class="photo-grid"></div>
      <div id="submission-output" class="submission-output" hidden></div>
    </section>
  </section>

  <script is:inline>
    // @ts-nocheck
    const panel = document.querySelector("[data-categories]");
    const form = document.querySelector("#photo-submit-form");
    const preview = document.querySelector("#photo-preview");
    const output = document.querySelector("#submission-output");
    const filter = document.querySelector("#temple-filter");
    const templeSelect = document.querySelector("#temple-select");
    const templeCount = document.querySelector("#temple-count");
    const categories = JSON.parse(panel.dataset.categories || "[]");
    const fallbackCategory = categories.find((category) => category.category_id === "other") || categories[0];
    const categoryOptions = categories
      .map((category) => `<option value="${category.category_id}">${category.label}</option>`)
      .join("");

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function classifyByName(file) {
      const name = file.name.toLowerCase().normalize("NFKC");
      if (/map|案内|地図|霊場|札所/.test(name)) return "map-pilgrimage";
      if (/sign|board|説明|由緒/.test(name)) return "signboard";
      if (/stone|碑|標|入口|門/.test(name)) return "entrance-marker";
      if (/手水|chozu|石|灯籠/.test(name)) return "stonework";
      if (/本堂|堂|hondo|main/.test(name)) return "main-building";
      if (/境内|keidai|全景/.test(name)) return "grounds";
      return fallbackCategory.category_id;
    }

    function filterTemples() {
      const query = filter.value.normalize("NFKC").toLowerCase().trim();
      let visible = 0;
      Array.from(templeSelect.options).slice(1).forEach((option) => {
        const matches = !query || option.dataset.search.normalize("NFKC").toLowerCase().includes(query);
        option.hidden = !matches;
        if (matches) visible += 1;
      });
      if (templeSelect.selectedOptions[0]?.hidden) templeSelect.value = "";
      templeCount.textContent = query ? `${visible}件に絞り込みました。` : `全${visible}件から選択できます。`;
    }

    function renderPreview() {
      const files = Array.from(form.photos.files || []);
      preview.innerHTML = files.map((file, index) => {
        const url = URL.createObjectURL(file);
        const categoryId = classifyByName(file);
        return `
          <article class="photo-card upload-card">
            <img src="${url}" alt="${escapeHtml(file.name)}">
            <div>
              <strong>${escapeHtml(file.name)}</strong>
              <label>分類
                <select data-photo-category data-file-name="${escapeHtml(file.name)}">
                  ${categoryOptions}
                </select>
              </label>
            </div>
          </article>
        `.replace(`value="${categoryId}"`, `value="${categoryId}" selected`);
      }).join("");
    }

    filter.addEventListener("input", filterTemples);
    form.photos.addEventListener("change", renderPreview);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      output.hidden = false;
      output.className = "submission-output";
      output.textContent = "保存しています...";

      const formData = new FormData(form);
      const photoCategories = Array.from(preview.querySelectorAll("[data-photo-category]")).map((select) => ({
        file_name: select.dataset.fileName,
        category_id: select.value,
      }));
      formData.set("photo_categories", JSON.stringify(photoCategories));

      try {
        const response = await fetch("/admin/api/photo-submissions", { method: "POST", body: formData });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.message || "保存できませんでした。");
        output.classList.add("success");
        output.textContent = `${templeSelect.selectedOptions[0].textContent.trim()}へ${result.photos}枚を保存しました。\n受付ID: ${result.submission_id}`;
        form.reset();
        preview.innerHTML = "";
        filterTemples();
      } catch (error) {
        output.classList.add("error");
        output.textContent = `保存できませんでした。${error.message || error}`;
      }
    });
  </script>
</BaseLayout>
