---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  allDistricts,
  allTemples,
  countTemplesBySect,
  countTemplesByStatus,
  getDistrictName,
  getSectGroupName,
  getStatusLabel,
  getTempleDisplaySummary,
  getTempleStatusLabel,
  hasDetailPage,
  isCemeteryServiceInfo,
  normalizeSearchText,
} from "../../lib/temples";

const sects = countTemplesBySect();
const statusCounts = countTemplesByStatus();
const statuses = Object.keys(statusCounts).map((status) => ({
  status,
  label: getStatusLabel(status),
  count: statusCounts[status],
}));
const data = JSON.stringify(allTemples.map((temple) => {
  const districtName = getDistrictName(temple.district_id);
  const sectGroup = getSectGroupName(temple.sect);
  const displayStatusLabel = getTempleStatusLabel(temple);
  const mainDeity = isCemeteryServiceInfo(temple.main_deity) ? "" : temple.main_deity;
  const foundedPeriod = "founded_period" in temple && !isCemeteryServiceInfo(temple.founded_period)
    ? temple.founded_period
    : "";
  const pageSummary = getTempleDisplaySummary(temple, districtName);
  const aliases = temple.aliases.filter((alias) => !isCemeteryServiceInfo(alias));
  const searchText = normalizeSearchText([
    temple.name,
    temple.name_kana,
    aliases.join(" "),
    temple.address,
    temple.area,
    districtName,
    temple.sect,
    sectGroup,
    displayStatusLabel,
    mainDeity,
    foundedPeriod,
    pageSummary,
  ].join(" "));
  return {
    slug: temple.slug,
    name: temple.name,
    name_kana: temple.name_kana,
    aliases,
    address: temple.address,
    area: temple.area,
    district_id: temple.district_id,
    sect: temple.sect,
    sect_group: sectGroup,
    status: temple.status,
    display_status_label: displayStatusLabel,
    main_deity: mainDeity,
    founded_period: foundedPeriod,
    page_summary: pageSummary,
    detail_page: hasDetailPage(temple),
    search_text: searchText,
  };
})).replace(/</g, "\\u003c");
const districts = JSON.stringify(allDistricts);
---

<BaseLayout
  title="寺院検索｜ATAWI TEMPLE"
  description="寺院名、読み方、住所、地区、宗派、状態から磐田市のお寺を検索できます。"
>
  <section class="page-title">
    <p class="eyebrow">Search</p>
    <h1>寺院検索</h1>
    <p>検索条件はURLに残るため、そのまま共有できます。</p>
  </section>

  <section class="search-panel" data-temples={data} data-districts={districts}>
    <form id="search-form" class="search-form">
      <label>
        キーワード
        <input name="q" type="search" placeholder="寺院名・読み方・住所・宗派・ご本尊" data-track-click="temple_search_refine" />
      </label>
      <label>
        地区
        <select name="district" data-track-click="temple_search_refine">
          <option value="">すべて</option>
          {allDistricts.map((district) => <option value={district.district_id}>{district.name}</option>)}
          <option value="__unassigned">地区未確定</option>
        </select>
      </label>
      <label>
        宗派
        <select name="sect" data-track-click="temple_search_refine">
          <option value="">すべて</option>
          {sects.map((sect) => <option value={sect.name}>{sect.name}（{sect.count}）</option>)}
        </select>
      </label>
      <label>
        状態
        <select name="status" data-track-click="temple_search_refine">
          <option value="">すべて</option>
          {statuses.map((item) => <option value={item.status}>{item.label}（{item.count}）</option>)}
        </select>
      </label>
      <button type="submit" data-track-click="temple_search_refine">検索</button>
    </form>
    <p id="result-count" class="result-count" aria-live="polite"></p>
    <div class="search-return-links" aria-label="検索から戻るリンク">
      <span id="active-district-return"></span>
      <a href="/areas/" data-track-click="temple_area_click">地区一覧へ戻る</a>
      <a href="/temples/">全寺院一覧へ戻る</a>
      <a href="/map/" data-track-click="temple_map_click">地図から探す</a>
      <a href="/search/" data-track-click="temple_search_refine">条件を変更する</a>
    </div>
    <div id="results" class="card-grid"></div>
  </section>

  <script is:inline>
    // @ts-nocheck
    const panel = document.querySelector("[data-temples]");
    const form = document.querySelector("#search-form");
    const results = document.querySelector("#results");
    const resultCount = document.querySelector("#result-count");
    const activeDistrictReturn = document.querySelector("#active-district-return");

    if (!panel || !form || !results || !resultCount || !panel.dataset.temples || !panel.dataset.districts) {
      throw new Error("Search UI failed to initialize.");
    }

    const temples = JSON.parse(panel.dataset.temples);
    const districts = JSON.parse(panel.dataset.districts);
    const districtNames = new Map(districts.map((district) => [district.district_id, district.name]));
    const districtById = new Map(districts.map((district) => [district.district_id, district]));

    function districtNameOf(temple) {
      return districtNames.get(temple.district_id) || "地区未確定";
    }

    function normalize(value) {
      return String(value || "").toLowerCase().normalize("NFKC").replace(/\s+/g, "");
    }

    function isUnknownValue(value) {
      return ["未確認", "調査中", "対象外"].includes(value);
    }

    function knownValue(value, fallback = "確認中") {
      return isUnknownValue(value) ? fallback : value;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function textOf(temple) {
      if (temple.search_text) return temple.search_text;
      return normalize([
        temple.name,
        temple.name_kana,
        temple.aliases.join(" "),
        temple.address,
        temple.area,
        districtNameOf(temple),
        temple.sect,
        temple.sect_group,
        temple.display_status_label,
        temple.main_deity,
        temple.history_summary,
        temple.page_summary,
        temple.visit_notes,
        temple.detail_status,
        temple.sources.map((source) => source.title).join(" "),
      ].join(" "));
    }

    function readParams() {
      const params = new URLSearchParams(window.location.search);
      for (const element of form.elements) {
        if (element instanceof HTMLInputElement || element instanceof HTMLSelectElement) {
          if (element.name) element.value = params.get(element.name) || "";
        }
      }
    }

    function writeParams(values) {
      const params = new URLSearchParams();
      for (const [key, value] of Object.entries(values)) {
        if (typeof value === "string" && value) params.set(key, value);
      }
      const query = params.toString();
      history.replaceState(null, "", query ? `?${query}` : window.location.pathname);
    }

    function card(temple) {
      const kana = isUnknownValue(temple.name_kana) ? "" : `<p class="kana">${escapeHtml(temple.name_kana)}</p>`;
      const districtName = districtNameOf(temple);
      const detailPageAvailable = temple.detail_page !== false;
      const title = detailPageAvailable
        ? `<a href="/temples/${escapeHtml(temple.slug)}/" data-track-click="temple_detail_click">${escapeHtml(temple.name)}</a>`
        : escapeHtml(temple.name);
      const summary = temple.page_summary || `${districtName}地区に所在する${temple.sect}の寺院です。公式名簿の基礎情報をもとに掲載しています。`;
      const detailNotice = detailPageAvailable
        ? ""
        : `<p class="pending-text">個別ページは公開していません。検索記録として表示しています。</p>`;

      return `
        <article class="temple-card">
          <div class="card-topline">
            <span class="status status-${escapeHtml(temple.status)}">${escapeHtml(temple.display_status_label)}</span>
            <span>${escapeHtml(districtName)}</span>
          </div>
          <h3>${title}</h3>
          ${kana}
          <dl class="compact-list">
            <div><dt>住所</dt><dd>${escapeHtml(temple.address)}</dd></div>
            <div><dt>地区</dt><dd>${escapeHtml(districtName)}</dd></div>
            <div><dt>宗派</dt><dd>${escapeHtml(temple.sect)}</dd></div>
            <div><dt>ご本尊</dt><dd>${escapeHtml(knownValue(temple.main_deity))}</dd></div>
            <div><dt>創建・年代</dt><dd>${escapeHtml(knownValue(temple.founded_period, "調査中"))}</dd></div>
          </dl>
          <p>${escapeHtml(summary)}</p>` + detailNotice + `
        </article>
      `;
    }

    function emptyMessage(values) {
      if (values.district === "__unassigned") {
        return `
          <div class="empty">
            <strong>地区未分類の寺院は現在この条件では見つかりませんでした。</strong>
            <p>地区条件を外すか、寺院名・宗派・状態の条件を変更してください。</p>
            <div class="plain-actions">
              <a href="/search/" data-track-click="temple_search_refine">条件を変更する</a>
              <a href="/areas/" data-track-click="temple_area_click">地区一覧へ戻る</a>
              <a href="/temples/">全寺院一覧へ戻る</a>
            </div>
          </div>
        `;
      }
      return `
        <div class="empty">
          <strong>該当する寺院が見つかりませんでした。</strong>
          <p>地区や宗派の条件を外して再検索してください。</p>
          <div class="plain-actions">
            <a href="/search/" data-track-click="temple_search_refine">条件を変更する</a>
            <a href="/areas/" data-track-click="temple_area_click">地区一覧へ戻る</a>
            <a href="/map/" data-track-click="temple_map_click">地図から探す</a>
          </div>
        </div>
      `;
    }

    function updateReturnLinks(values) {
      if (!activeDistrictReturn) return;
      const selectedDistrict = districtById.get(values.district);
      activeDistrictReturn.innerHTML = selectedDistrict
        ? `<a href="/areas/${escapeHtml(selectedDistrict.slug)}/" data-track-click="temple_area_click">${escapeHtml(selectedDistrict.name)}地区へ戻る</a>`
        : "";
    }

    function render() {
      const values = Object.fromEntries(new FormData(form).entries());
      const keyword = normalize(values.q || "");
      const filtered = temples.filter((temple) => {
        if (keyword && !textOf(temple).includes(keyword)) return false;
        if (values.district === "__unassigned" && temple.district_id) return false;
        if (values.district && values.district !== "__unassigned" && temple.district_id !== String(values.district)) return false;
        if (values.sect && temple.sect_group !== String(values.sect)) return false;
        if (values.status && temple.status !== String(values.status)) return false;
        return true;
      });

      writeParams(values);
      updateReturnLinks(values);
      resultCount.textContent = values.district === "__unassigned"
        ? `地区未分類の寺院：${filtered.length}件`
        : `${filtered.length}件見つかりました`;
      results.innerHTML = filtered.length
        ? filtered.map((temple) => card(temple)).join("")
        : emptyMessage(values);
    }

    readParams();
    render();
    form.addEventListener("input", render);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      render();
    });
  </script>
</BaseLayout>
