---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  allDistricts,
  allTemples,
  countTemplesBySect,
  countTemplesByStatus,
  getDistrictName,
  getSectGroupName,
  getStatusLabel,
  getTempleMediaBySlug,
  getTempleStatusLabel,
  googleMapsUrl,
  hasDetailPage,
} from "../lib/temples";

const sects = countTemplesBySect();
const statusCounts = countTemplesByStatus();
const statuses = Object.keys(statusCounts).map((status) => ({
  status,
  label: getStatusLabel(status),
  count: statusCounts[status],
}));
const quickMapDistrictIds = ["koyo", "mikuriya", "toyoda", "mitsuke", "nanbu"];
const quickMapDistricts = quickMapDistrictIds
  .map((districtId) => allDistricts.find((district) => district.district_id === districtId))
  .filter((district): district is (typeof allDistricts)[number] => Boolean(district));
const mapItems = allTemples.map((temple) => {
  const media = getTempleMediaBySlug(temple.slug);
  return {
    slug: temple.slug,
    name: temple.name,
    kana: temple.name_kana,
    address: temple.address,
    districtId: temple.district_id || "__unassigned",
    districtName: getDistrictName(temple.district_id),
    sect: temple.sect,
    sectGroup: getSectGroupName(temple.sect),
    status: temple.status,
    statusLabel: getTempleStatusLabel(temple),
    detailUrl: hasDetailPage(temple) ? `/temples/${temple.slug}/` : null,
    mapUrl: googleMapsUrl(temple),
    image: media?.hero_image ?? media?.photos?.[0]?.src ?? null,
    imageAlt: media?.photos?.[0]?.alt ?? `${temple.name}の写真`,
  };
});
const addressCount = allTemples.filter((temple) => temple.address).length;
const googleMapsLinkCount = mapItems.filter((item) => item.mapUrl).length;
const mapItemsJson = JSON.stringify(mapItems).replace(/</g, "\\u003c");
---

<BaseLayout
  title="住所一覧・Googleマップで開く｜ATAWI TEMPLE"
  description="磐田市内の寺院を地区、宗派、状態で絞り込み、住所一覧とGoogleマップリンクから確認できるATAWI TEMPLEの一覧ページです。"
>
  <section class="page-title">
    <p class="eyebrow">Address List</p>
    <h1>住所一覧・Googleマップで開く</h1>
    <p>地区・宗派・状態で絞り込み、各寺院の住所とGoogleマップリンクを一覧で確認できます。</p>
  </section>

  <section class="section">
    <div class="stats-grid">
      <article class="stat-card">
        <span>登録件数</span>
        <strong>{allTemples.length}</strong>
        <small>寺院・関連宗教法人の総数</small>
      </article>
      <article class="stat-card">
        <span>住所掲載</span>
        <strong>{addressCount}</strong>
        <small>所在地を確認できる件数</small>
      </article>
      <article class="stat-card">
        <span>地区分類</span>
        <strong>{allDistricts.length}</strong>
        <small>9地区の分類で絞り込み</small>
      </article>
      <article class="stat-card">
        <span>Googleマップリンク</span>
        <strong>{googleMapsLinkCount}</strong>
        <small>各寺院を外部地図で開く</small>
      </article>
    </div>
  </section>

  <section
    class="section temple-map-shell"
  >
    <div class="map-quick-filter" aria-label="主要地区フィルタ">
      <span>地区フィルタ</span>
      {quickMapDistricts.map((district) => (
        <button type="button" data-map-district={district.district_id} data-track-click="temple_map_click">{district.name}</button>
      ))}
      <button type="button" data-map-district="" data-track-click="temple_map_click">すべて</button>
    </div>

    <form id="map-filter-form" class="search-form map-filter-form">
      <label>
        キーワード
        <input name="q" type="search" placeholder="寺院名・住所・宗派" />
      </label>
      <label>
        地区
        <select name="district">
          <option value="">すべて</option>
          {allDistricts.map((district) => <option value={district.district_id}>{district.name}</option>)}
          <option value="__unassigned">地区未確定</option>
        </select>
      </label>
      <label>
        宗派・関連法人
        <select name="sect">
          <option value="">すべて</option>
          {sects.map((sect) => <option value={sect.name}>{sect.name}（{sect.count}）</option>)}
        </select>
      </label>
      <label>
        状態
        <select name="status">
          <option value="">すべて</option>
          {statuses.map((item) => <option value={item.status}>{item.label}（{item.count}）</option>)}
        </select>
      </label>
      <button type="submit" data-track-click="temple_search_refine">絞り込み</button>
    </form>

    <div class="map-list-heading">
      <h2>住所一覧</h2>
      <span id="map-result-count" class="small" aria-live="polite"></span>
    </div>
    <div id="map-results" class="map-result-grid"></div>
    <script is:inline type="application/json" id="map-temple-data" set:html={mapItemsJson} />
  </section>

  <script is:inline>
    // @ts-nocheck
    const mapForm = document.querySelector("#map-filter-form");
    const mapResults = document.querySelector("#map-results");
    const mapResultCount = document.querySelector("#map-result-count");
    const mapQuickButtons = document.querySelectorAll("[data-map-district]");
    const mapDataEl = document.querySelector("#map-temple-data");
    const mapItems = JSON.parse(mapDataEl?.textContent || "[]");

    function escapeHtml(value) {
      return String(value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function normalize(value) {
      return String(value || "").toLowerCase().normalize("NFKC").replace(/\s+/g, "");
    }

    function valuesFromForm() {
      return Object.fromEntries(new FormData(mapForm).entries());
    }

    function readMapParams() {
      const params = new URLSearchParams(window.location.search);
      for (const element of mapForm.elements) {
        if (element instanceof HTMLInputElement || element instanceof HTMLSelectElement) {
          if (element.name) element.value = params.get(element.name) || "";
        }
      }
    }

    function writeMapParams(values) {
      const params = new URLSearchParams();
      for (const [key, value] of Object.entries(values)) {
        if (typeof value === "string" && value) params.set(key, value);
      }
      const query = params.toString();
      history.replaceState(null, "", query ? `?${query}` : window.location.pathname);
    }

    function updateQuickDistrictState(districtId) {
      mapQuickButtons.forEach((button) => {
        button.classList.toggle("is-active", (button.dataset.mapDistrict || "") === (districtId || ""));
      });
    }

    function filteredItems() {
      const values = valuesFromForm();
      const keyword = normalize(values.q || "");
      return mapItems.filter((item) => {
        if (keyword && !normalize([item.name, item.kana, item.address, item.districtName, item.sect, item.sectGroup, item.statusLabel].join(" ")).includes(keyword)) return false;
        if (values.district && item.districtId !== values.district) return false;
        if (values.sect && item.sectGroup !== values.sect) return false;
        if (values.status && item.status !== values.status) return false;
        return true;
      });
    }

    function renderList(items) {
      mapResultCount.textContent = `${items.length}件表示`;
      mapResults.innerHTML = items.map((item) => {
        const title = item.detailUrl
          ? `<a href="${escapeHtml(item.detailUrl)}" data-track-click="temple_detail_click">${escapeHtml(item.name)}</a>`
          : escapeHtml(item.name);
        const image = item.image
          ? `<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.imageAlt)}" loading="lazy" />`
          : `<span class="map-result-noimage">写真準備中</span>`;
        return `
          <article class="map-result-card">
            <a class="map-result-image" href="${escapeHtml(item.detailUrl || item.mapUrl)}" ${item.detailUrl ? `data-track-click="temple_detail_click"` : ""}>${image}</a>
            <div>
              <div class="card-topline">
                <span class="status status-${escapeHtml(item.status)}">${escapeHtml(item.statusLabel)}</span>
                <span>${escapeHtml(item.districtName)}</span>
              </div>
              <h3>${title}</h3>
              <dl class="compact-list">
                <div><dt>住所</dt><dd>${escapeHtml(item.address)}</dd></div>
                <div><dt>宗派</dt><dd>${escapeHtml(item.sectGroup)}</dd></div>
              </dl>
              <div class="map-card-actions">
                ${item.detailUrl ? `<a href="${escapeHtml(item.detailUrl)}" data-track-click="temple_detail_click">詳細ページ</a>` : ""}
                <a href="${escapeHtml(item.mapUrl)}" target="_blank" rel="noreferrer">Googleマップ</a>
              </div>
            </div>
          </article>
        `;
      }).join("");
    }

    function applyFilters() {
      const items = filteredItems();
      const values = valuesFromForm();
      writeMapParams(values);
      updateQuickDistrictState(values.district);
      renderList(items);
    }

    if (mapForm) {
      mapForm.addEventListener("input", applyFilters);
      mapForm.addEventListener("submit", (event) => {
        event.preventDefault();
        applyFilters();
      });
    }
    mapQuickButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const districtSelect = mapForm.elements.namedItem("district");
        if (districtSelect) districtSelect.value = button.dataset.mapDistrict || "";
        applyFilters();
      });
    });
    readMapParams();
    applyFilters();
  </script>
</BaseLayout>
