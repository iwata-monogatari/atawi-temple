---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  allDistricts,
  allTemples,
  countTemplesBySect,
  countTemplesByStatus,
  countTemplesWithPhotos,
  getDistrictColor,
  getDistrictName,
  getSectGroupName,
  getStatusLabel,
  getTempleLatLng,
  getTempleMediaBySlug,
  getTempleStatusLabel,
  googleMapsUrl,
  googleMapsWebEmbedUrl,
  hasDetailPage,
} from "../lib/temples";

const mapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY || "";
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID || "DEMO_MAP_ID";
const sects = countTemplesBySect();
const statusCounts = countTemplesByStatus();
const statuses = Object.keys(statusCounts).map((status) => ({
  status,
  label: getStatusLabel(status),
  count: statusCounts[status],
}));
const mapItems = allTemples.map((temple) => {
  const latLng = getTempleLatLng(temple);
  const media = getTempleMediaBySlug(temple.slug);
  return {
    slug: temple.slug,
    name: temple.name,
    kana: temple.name_kana,
    address: temple.address,
    districtId: temple.district_id || "__unassigned",
    districtName: getDistrictName(temple.district_id),
    districtColor: getDistrictColor(temple.district_id),
    sect: temple.sect,
    sectGroup: getSectGroupName(temple.sect),
    status: temple.status,
    statusLabel: getTempleStatusLabel(temple),
    lat: latLng?.lat ?? null,
    lng: latLng?.lng ?? null,
    detailUrl: hasDetailPage(temple) ? `/temples/${temple.slug}/` : null,
    mapUrl: googleMapsUrl(temple),
    image: media?.hero_image ?? media?.photos?.[0]?.src ?? null,
    imageAlt: media?.photos?.[0]?.alt ?? `${temple.name}の写真`,
  };
});
const markerCount = mapItems.filter((item) => item.lat !== null && item.lng !== null).length;
const fallbackMapEmbedUrl = googleMapsWebEmbedUrl();
const mapRuntimeNote = markerCount > 0 && mapsApiKey
  ? "座標登録済みの寺院を地区カラーのピンで表示します。"
  : "現在はGoogle Mapsの広域地図を表示しています。APIキーとlat/lng登録後、寺院ごとのピン表示に切り替わります。";
const mapItemsJson = JSON.stringify(mapItems).replace(/</g, "\\u003c");
---

<BaseLayout
  title="地図から探す｜ATAWI TEMPLE"
  description="磐田市内の寺院を地区、宗派、状態で絞り込み、地図と一覧から探せるATAWI TEMPLEの地図ページです。"
>
  <section class="page-title">
    <p class="eyebrow">Map</p>
    <h1>地図から探す</h1>
    <p>地区カラーで寺院の位置を確認し、近くのお寺や現地確認ルートを探せるページです。</p>
  </section>

  <section class="section">
    <div class="stats-grid">
      <article class="stat-card">
        <span>登録件数</span>
        <strong>{allTemples.length}</strong>
        <small>寺院・関連宗教法人の総数</small>
      </article>
      <article class="stat-card">
        <span>地図座標登録</span>
        <strong>{markerCount}</strong>
        <small>lat/lng登録済みの件数</small>
      </article>
      <article class="stat-card">
        <span>座標登録待ち</span>
        <strong>{allTemples.length - markerCount}</strong>
        <small>ジオコーディング後に地図へ反映</small>
      </article>
      <article class="stat-card">
        <span>現地写真掲載</span>
        <strong>{countTemplesWithPhotos()}</strong>
        <small>写真データから自動集計</small>
      </article>
    </div>
  </section>

  <section
    class="section temple-map-shell"
    data-map-api-key={mapsApiKey}
    data-map-id={mapId}
  >
    <form id="map-filter-form" class="search-form map-filter-form">
      <label>
        キーワード
        <input name="q" type="search" placeholder="寺院名・住所・宗派" />
      </label>
      <label>
        地区
        <select name="district">
          <option value="">すべて</option>
          {allDistricts.map((district) => <option value={district.district_id}>{district.name}</option>)}
          <option value="__unassigned">地区未確定</option>
        </select>
      </label>
      <label>
        宗派・関連法人
        <select name="sect">
          <option value="">すべて</option>
          {sects.map((sect) => <option value={sect.name}>{sect.name}（{sect.count}）</option>)}
        </select>
      </label>
      <label>
        状態
        <select name="status">
          <option value="">すべて</option>
          {statuses.map((item) => <option value={item.status}>{item.label}（{item.count}）</option>)}
        </select>
      </label>
      <button type="submit">絞り込み</button>
    </form>

    <div id="temple-map-canvas" class="temple-map-canvas" data-fallback-map-src={fallbackMapEmbedUrl}>
      <iframe
        class="map-fallback-frame"
        title="磐田市寺院のGoogleマップ"
        src={fallbackMapEmbedUrl}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
    <p class="map-runtime-note">{mapRuntimeNote}</p>

    <div class="map-list-heading">
      <h2>寺院リスト</h2>
      <span id="map-result-count" class="small" aria-live="polite"></span>
    </div>
    <div id="map-results" class="map-result-grid"></div>
    <script is:inline type="application/json" id="map-temple-data" set:html={mapItemsJson} />
  </section>

  <script is:inline>
    // @ts-nocheck
    const mapShell = document.querySelector("[data-map-api-key]");
    const mapForm = document.querySelector("#map-filter-form");
    const mapCanvas = document.querySelector("#temple-map-canvas");
    const mapResults = document.querySelector("#map-results");
    const mapResultCount = document.querySelector("#map-result-count");
    const mapRuntimeNoteEl = document.querySelector(".map-runtime-note");
    const mapDataEl = document.querySelector("#map-temple-data");
    const mapItems = JSON.parse(mapDataEl?.textContent || "[]");
    const apiKey = mapShell?.dataset.mapApiKey || "";
    const mapId = mapShell?.dataset.mapId || "DEMO_MAP_ID";
    const hasCoordinates = mapItems.some((item) => Number.isFinite(item.lat) && Number.isFinite(item.lng));
    let googleMap = null;
    let infoWindow = null;
    const markerRecords = [];

    function escapeHtml(value) {
      return String(value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function normalize(value) {
      return String(value || "").toLowerCase().normalize("NFKC").replace(/\s+/g, "");
    }

    function valuesFromForm() {
      return Object.fromEntries(new FormData(mapForm).entries());
    }

    function filteredItems() {
      const values = valuesFromForm();
      const keyword = normalize(values.q || "");
      return mapItems.filter((item) => {
        if (keyword && !normalize([item.name, item.kana, item.address, item.districtName, item.sect, item.sectGroup, item.statusLabel].join(" ")).includes(keyword)) return false;
        if (values.district && item.districtId !== values.district) return false;
        if (values.sect && item.sectGroup !== values.sect) return false;
        if (values.status && item.status !== values.status) return false;
        return true;
      });
    }

    function renderList(items) {
      mapResultCount.textContent = `${items.length}件表示`;
      mapResults.innerHTML = items.map((item) => {
        const title = item.detailUrl
          ? `<a href="${escapeHtml(item.detailUrl)}">${escapeHtml(item.name)}</a>`
          : escapeHtml(item.name);
        const image = item.image
          ? `<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.imageAlt)}" loading="lazy" />`
          : `<span class="map-result-noimage">写真準備中</span>`;
        return `
          <article class="map-result-card">
            <a class="map-result-image" href="${escapeHtml(item.detailUrl || item.mapUrl)}">${image}</a>
            <div>
              <div class="card-topline">
                <span class="status status-${escapeHtml(item.status)}">${escapeHtml(item.statusLabel)}</span>
                <span>${escapeHtml(item.districtName)}</span>
              </div>
              <h3>${title}</h3>
              <dl class="compact-list">
                <div><dt>住所</dt><dd>${escapeHtml(item.address)}</dd></div>
                <div><dt>宗派</dt><dd>${escapeHtml(item.sectGroup)}</dd></div>
              </dl>
              <div class="map-card-actions">
                ${item.detailUrl ? `<a href="${escapeHtml(item.detailUrl)}">詳細ページ</a>` : ""}
                <a href="${escapeHtml(item.mapUrl)}" target="_blank" rel="noreferrer">Googleマップ</a>
              </div>
            </div>
          </article>
        `;
      }).join("");
    }

    function markerContent(item) {
      const pin = document.createElement("button");
      pin.type = "button";
      pin.className = item.status === "unknown" ? "temple-map-marker temple-map-marker--hollow" : "temple-map-marker";
      pin.style.setProperty("--pin-color", item.districtColor);
      pin.setAttribute("aria-label", item.name);
      return pin;
    }

    function updateMarkers(items) {
      if (!googleMap) return;
      const visible = new Set(items.map((item) => item.slug));
      const bounds = new google.maps.LatLngBounds();
      let visibleCount = 0;
      for (const record of markerRecords) {
        const shouldShow = visible.has(record.item.slug);
        record.marker.map = shouldShow ? googleMap : null;
        if (shouldShow) {
          bounds.extend(record.marker.position);
          visibleCount += 1;
        }
      }
      if (visibleCount > 0) {
        googleMap.fitBounds(bounds, 72);
      }
    }

    function applyFilters() {
      const items = filteredItems();
      renderList(items);
      updateMarkers(items);
    }

    function setMapRuntimeNote(message) {
      if (mapRuntimeNoteEl && message) mapRuntimeNoteEl.textContent = message;
    }

    function quotaBlockedMessage(reason) {
      if (reason === "monthly_cap_reached") return "ピン付き地図は月間無料枠の安全上限に達したため停止中です。無料の広域地図とGoogleマップリンクは利用できます。";
      if (reason === "disabled" || reason === "cap_not_configured") return "ピン付き地図は費用抑制のため停止中です。無料の広域地図を表示しています。";
      return "ピン付き地図の利用状況を確認できないため、無料の広域地図を表示しています。";
    }

    async function reserveDynamicMapLoad() {
      try {
        const response = await fetch("/api/maps-quota", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ feature: "dynamic-map" }),
          cache: "no-store",
        });
        if (!response.ok) return { allowed: false, reason: "quota_request_failed" };
        return response.json();
      } catch {
        return { allowed: false, reason: "quota_request_failed" };
      }
    }

    async function loadGoogleMap() {
      if (!apiKey || !hasCoordinates || !mapCanvas) return;
      const quota = await reserveDynamicMapLoad();
      if (!quota.allowed) {
        setMapRuntimeNote(quotaBlockedMessage(quota.reason));
        return;
      }
      if (Number.isFinite(quota.used) && Number.isFinite(quota.cap)) {
        setMapRuntimeNote(`ピン付き地図を表示しています（月間安全上限 ${quota.used}/${quota.cap}）。`);
      }
      await new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(apiKey)}&v=weekly&loading=async`;
        script.async = true;
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
      const { Map, InfoWindow } = await google.maps.importLibrary("maps");
      const { AdvancedMarkerElement } = await google.maps.importLibrary("marker");
      mapCanvas.innerHTML = "";
      googleMap = new Map(mapCanvas, {
        center: { lat: 34.717, lng: 137.851 },
        zoom: 12,
        mapId,
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: true,
      });
      infoWindow = new InfoWindow();
      for (const item of mapItems.filter((entry) => Number.isFinite(entry.lat) && Number.isFinite(entry.lng))) {
        const marker = new AdvancedMarkerElement({
          map: googleMap,
          position: { lat: item.lat, lng: item.lng },
          title: item.name,
          content: markerContent(item),
        });
        marker.addListener("click", () => {
          infoWindow.setContent(`
            <div class="map-info-window">
              <strong>${escapeHtml(item.name)}</strong>
              <span>${escapeHtml(item.districtName)} / ${escapeHtml(item.sectGroup)}</span>
              <a href="${escapeHtml(item.detailUrl || item.mapUrl)}">${item.detailUrl ? "詳細ページ" : "Googleマップ"}</a>
            </div>
          `);
          infoWindow.open({ map: googleMap, anchor: marker });
        });
        markerRecords.push({ item, marker });
      }
      applyFilters();
    }

    if (mapForm) {
      mapForm.addEventListener("input", applyFilters);
      mapForm.addEventListener("submit", (event) => {
        event.preventDefault();
        applyFilters();
      });
    }
    renderList(mapItems);
    loadGoogleMap().catch(() => {
      if (mapCanvas) {
        const fallbackMapSrc = mapCanvas.dataset.fallbackMapSrc || "";
        mapCanvas.innerHTML = fallbackMapSrc
          ? `<iframe class="map-fallback-frame" title="磐田市寺院のGoogleマップ" src="${escapeHtml(fallbackMapSrc)}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`
          : `<div class="map-placeholder"><strong>地図を読み込めませんでした</strong><span>APIキー、リファラ制限、Maps JavaScript APIの有効化を確認してください。</span></div>`;
      }
    });
  </script>
</BaseLayout>
