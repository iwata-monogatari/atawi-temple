---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogAuthorBox from "../../components/BlogAuthorBox.astro";
import {
  BLOG_TITLE,
  blogPosts,
  blogPostUrl,
  formatBlogDate,
  getBlogBody,
  getBlogPost,
} from "../../lib/blog";

export function getStaticPaths() {
  return blogPosts.map((post) => ({ params: { slug: post.slug } }));
}

const siteUrl = "https://temple.atawi.link";
const slug = Astro.params.slug || "";
const post = getBlogPost(slug);
if (!post) return Astro.redirect("/blog/");

const body = getBlogBody(post.slug);
const url = `${siteUrl}${blogPostUrl(post.slug)}`;
const index = blogPosts.findIndex((item) => item.slug === post.slug);
const newer = index > 0 ? blogPosts[index - 1] : undefined;
const older = index < blogPosts.length - 1 ? blogPosts[index + 1] : undefined;

// 憲章§5.3 の必須4種。author は Person ノードを @id で参照し、3サイトで同一人物として扱う。
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${url}#article`,
    headline: post.title,
    description: post.description,
    url,
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    ...(post.cover ? { image: new URL(post.cover.src.replace(/-cover\.png$/, "-cover.webp"), siteUrl).toString() } : {}),
    datePublished: `${post.published}T09:00:00+09:00`,
    dateModified: `${post.updated}T09:00:00+09:00`,
    inLanguage: "ja",
    keywords: [post.query, ...post.tags].join(","),
    author: { "@id": `${siteUrl}/#oishi` },
    publisher: {
      "@type": "Organization",
      name: "富士ヶ丘サービス株式会社",
      alternateName: "ATAWI TEMPLE",
      url: siteUrl,
    },
    isPartOf: { "@type": "Blog", "@id": `${siteUrl}/blog/#blog`, name: BLOG_TITLE },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${siteUrl}/#oishi`,
    name: "大石浩之",
    jobTitle: "代表取締役・宅地建物取引士",
    worksFor: { "@type": "Organization", name: "富士ヶ丘サービス株式会社" },
    address: {
      "@type": "PostalAddress",
      addressCountry: "JP",
      addressRegion: "静岡県",
      addressLocality: "袋井市",
    },
    image: `${siteUrl}/assets/author-oishi.jpg`,
    url: `${siteUrl}/about/`,
    sameAs: [
      "https://oishi-hiroyuki.org/profile",
      "https://fudosan.atawi.link/",
      "https://morimachi.enshu-lifehack.com/",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ホーム", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: BLOG_TITLE, item: `${siteUrl}/blog/` },
      { "@type": "ListItem", position: 3, name: post.title, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: post.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout
  title={`${post.title}｜${BLOG_TITLE}｜ATAWI TEMPLE`}
  description={post.description}
  ogType="article"
  ogImage={post.cover?.src.replace(/-cover\.png$/, "-cover.webp")}
  publishedTime={`${post.published}T09:00:00+09:00`}
  modifiedTime={`${post.updated}T09:00:00+09:00`}
  structuredData={structuredData}
>
  <article class="article-page">
    <header class="article-hero">
      <p class="eyebrow"><a href="/blog/">{BLOG_TITLE}</a></p>
      <h1>{post.title}</h1>
      <p class="small">
        公開 {formatBlogDate(post.published)}
        {post.updated !== post.published && <span>／更新 {formatBlogDate(post.updated)}</span>}
        ／文：大石浩之（磐田市／不動産業・宅地建物取引士）
      </p>
      {post.tags.length > 0 && <p class="small blog-tags">{post.tags.map((tag) => <span>{tag}</span>)}</p>}
    </header>

    <div class="article-layout">
      <main class="article-body">
        {
          post.cover && (
            <figure class="article-figure">
              <img src={post.cover.src.replace(/-cover\.png$/, "-cover.webp")} alt={`記事内容をもとに生成したイメージ：${post.title}`} width="1200" height="675" decoding="async" />
              <figcaption>記事内容をもとに生成したイメージです。実在の場所・人物を撮影したものではありません。</figcaption>
            </figure>
          )
        }

        <section class="article-section blog-lead">
          <p class="section-number">結論</p>
          <h2>{post.leadQuestion}</h2>
          <p>{post.lead}</p>
        </section>

        <section class="article-section blog-body" set:html={body} />

        <section class="article-section">
          <p class="section-number">FAQ</p>
          <h2>よくある確認</h2>
          <div class="faq-list">
            {
              post.faq.map((item) => (
                <article>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </article>
              ))
            }
          </div>
        </section>

        {
          post.related.length > 0 && (
            <section class="article-section">
              <p class="section-number">Links</p>
              <h2>あわせて読む</h2>
              <ul class="check-list">
                {post.related.map((link) => (
                  <li><a href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="article-section sources-panel">
          <p class="section-number">Sources</p>
          <h2>出典・確認先</h2>
          <ol class="source-records">
            {
              post.sources.map((source) => (
                <li>
                  <span>参考</span>
                  {source.url ? <a href={source.url}>{source.title}</a> : <strong>{source.title}</strong>}
                  <p>{source.note}</p>
                </li>
              ))
            }
          </ol>
          <p class="small">
            制度・金額・期限は変わります。相続、税、登記にかかわる個別の判断は、税理士・司法書士などの専門家と菩提寺にご確認ください。
            本記事は一般的な情報であり、特定の寺院・家・土地についての判断ではありません。
          </p>
        </section>

        <BlogAuthorBox />

        {
          (newer || older) && (
            <nav class="blog-prevnext" aria-label="前後の記事">
              {older && <a href={blogPostUrl(older.slug)}>← {older.title}</a>}
              {newer && <a href={blogPostUrl(newer.slug)}>{newer.title} →</a>}
            </nav>
          )
        }
      </main>

      <aside class="article-aside">
        <section class="side-panel">
          <h2>お寺を調べる</h2>
          <div class="side-link-list">
            <a href="/search/">寺院名・宗派で検索する</a>
            <a href="/areas/">9地区から探す</a>
            <a href="/sects/">宗派から探す</a>
          </div>
        </section>
        <section class="side-panel">
          <h2>読みもの</h2>
          <div class="side-link-list">
            <a href="/blog/">{BLOG_TITLE}（全{blogPosts.length}本）</a>
            <a href="/knowledge/">寺院の基礎資料</a>
            <a href="/topics/">家族のためのガイド</a>
          </div>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
