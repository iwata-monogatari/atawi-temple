---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogAuthorBox from "../../components/BlogAuthorBox.astro";
import {
  BLOG_DESCRIPTION,
  BLOG_TITLE,
  blogPosts,
  blogPostUrl,
  formatBlogDate,
  groupBlogPostsByMonth,
} from "../../lib/blog";

const siteUrl = "https://temple.atawi.link";
const months = groupBlogPostsByMonth();

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": `${siteUrl}/blog/#blog`,
    name: BLOG_TITLE,
    description: BLOG_DESCRIPTION,
    url: `${siteUrl}/blog/`,
    inLanguage: "ja",
    author: { "@id": `${siteUrl}/#oishi` },
    publisher: {
      "@type": "Organization",
      name: "富士ヶ丘サービス株式会社",
      alternateName: "ATAWI TEMPLE",
      url: siteUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "ホーム", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: BLOG_TITLE, item: `${siteUrl}/blog/` },
    ],
  },
];
---

<BaseLayout
  title={`${BLOG_TITLE}｜ATAWI TEMPLE`}
  description={BLOG_DESCRIPTION}
  structuredData={structuredData}
>
  <section class="article-hero">
    <p class="eyebrow">Blog</p>
    <h1>{BLOG_TITLE}</h1>
    <p class="article-subtitle">{BLOG_DESCRIPTION}</p>
    <p class="small">
      全{blogPosts.length}本
      ／<a href="/feed.xml">RSS（feed.xml）</a>
      ／データベース本体は<a href="/temples/">寺院一覧</a>、制度の解説は<a href="/knowledge/">寺院の基礎資料</a>にあります。
    </p>
  </section>

  <div class="article-layout">
    <main class="article-body">
      {
        months.length === 0 ? (
          <section class="article-section">
            <h2>準備中です</h2>
            <p>記事の公開準備を進めています。公開後はこの一覧と <a href="/feed.xml">RSS</a> に順次追加されます。</p>
          </section>
        ) : (
          months.map((group) => (
            <section class="article-section">
              <p class="section-number">{group.month.replace("-", ".")}</p>
              <h2>{group.label}</h2>
              <ul class="blog-list">
                {group.posts.map((post) => (
                  <li>
                    {post.cover && (
                      <img
                        class="blog-list-thumb"
                        src={post.cover.src}
                        alt={post.cover.alt}
                        width="160"
                        height="160"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <div>
                      <p class="small">{formatBlogDate(post.published)}</p>
                      <h3><a href={blogPostUrl(post.slug)}>{post.title}</a></h3>
                      <p>{post.description}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        )
      }

      <BlogAuthorBox />
    </main>

    <aside class="article-aside">
      <section class="side-panel">
        <h2>お寺を調べる</h2>
        <div class="side-link-list">
          <a href="/search/">寺院名・宗派で検索する</a>
          <a href="/areas/">9地区から探す</a>
          <a href="/sects/">宗派から探す</a>
        </div>
      </section>
      <section class="side-panel">
        <h2>読みもの</h2>
        <div class="side-link-list">
          <a href="/knowledge/">寺院の基礎資料</a>
          <a href="/topics/">家族のためのガイド</a>
          <a href="/tokushu/">特集・読みもの</a>
          <a href="/research/">研究論文一覧</a>
        </div>
      </section>
    </aside>
  </div>
</BaseLayout>
