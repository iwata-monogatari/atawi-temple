---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TempleCard from "../../components/TempleCard.astro";
import {
  allDistricts,
  getDistrictBySlug,
  getTempleMediaBySlug,
  getTemplesByDistrictId,
  hasDetailPage,
} from "../../lib/temples";
import { getMonogatariDistrictUrl } from "../../lib/related-monogatari";

export function getStaticPaths() {
  return allDistricts.map((district) => ({
    params: { slug: district.slug },
  }));
}

const district = getDistrictBySlug(Astro.params.slug || "");

if (!district) {
  return Astro.redirect("/areas/");
}

function templeHasPhoto(temple: (typeof temples)[number]) {
  const media = getTempleMediaBySlug(temple.slug);
  return Boolean(media?.hero_image ?? media?.photos?.[0]?.src);
}

const temples = getTemplesByDistrictId(district.district_id);
const detailedTemples = temples.filter((temple) => hasDetailPage(temple));
const templesWithPhoto = detailedTemples.filter((temple) => templeHasPhoto(temple));
const templesWithoutPhoto = detailedTemples.filter((temple) => !templeHasPhoto(temple));
const unresearchedTemples = temples.filter((temple) => !hasDetailPage(temple));
const monogatariDistrictUrl = getMonogatariDistrictUrl(district.district_id);

const templeGroups = [
  { heading: "写真掲載あり", note: "現地写真を掲載している寺院です。", temples: templesWithPhoto },
  { heading: "写真準備中", note: "基礎情報は掲載済みで、現地写真は今後追加予定です。", temples: templesWithoutPhoto },
  { heading: "現地確認待ち", note: "現地での痕跡確認ができておらず、検索記録として掲載しています。", temples: unresearchedTemples },
].filter((group) => group.temples.length > 0);
---

<BaseLayout
  title={`${district.name}地区のお寺・寺院一覧｜ATAWI TEMPLE`}
  description={`${district.name}地区にある寺院、廃寺、寺院跡を整理するATAWI TEMPLEの地区別一覧です。`}
>
  <section class="page-title">
    <p class="eyebrow">Area / {district.slug}</p>
    <h1>{district.name}地区のお寺・寺院一覧</h1>
    <p>{district.summary}</p>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>登録寺院</h2>
      <a href={`/search/?district=${district.district_id}`}>この地区で検索する</a>
    </div>
    {
      temples.length ? (
        <>
          <p class="small area-count-summary">
            {temples.length}件登録（写真掲載あり{templesWithPhoto.length}件・写真準備中{templesWithoutPhoto.length}件・現地確認待ち{unresearchedTemples.length}件）
          </p>
          {templeGroups.map((group) => (
            <div class="area-temple-group">
              <div class="area-group-heading">
                <h3>{group.heading}</h3>
                <span class="small">{group.note} / {group.temples.length}件</span>
              </div>
              <div class="card-grid">
                {group.temples.map((temple) => <TempleCard temple={temple} />)}
              </div>
            </div>
          ))}
        </>
      ) : (
        <div class="empty">
          この地区の寺院データは現在登録されていません。追加確認できた寺院から掲載します。
        </div>
      )
    }
  </section>

  {monogatariDistrictUrl && (
    <section class="section">
      <div class="district-monogatari-block">
        <h2>この地区の歴史を磐田物語で読む</h2>
        <a class="button-link" href={monogatariDistrictUrl}>{district.name}地区の記事へ ── 磐田物語</a>
      </div>
    </section>
  )}

  <section class="section">
    <a class="button-link" href="/areas/">9地区一覧へ戻る</a>
  </section>
</BaseLayout>
