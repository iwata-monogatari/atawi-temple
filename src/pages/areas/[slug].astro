---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TempleCard from "../../components/TempleCard.astro";
import type { Temple } from "../../lib/temples";
import {
  allDistricts,
  districtColors,
  getDistrictBySlug,
  getTempleMediaBySlug,
  getTemplesByDistrictId,
  hasDetailPage,
} from "../../lib/temples";
import { getMonogatariDistrictUrl, realEstateFunnel } from "../../lib/related-monogatari";

export function getStaticPaths() {
  return allDistricts.map((district) => ({
    params: { slug: district.slug },
  }));
}

const district = getDistrictBySlug(Astro.params.slug || "");

if (!district) {
  return Astro.redirect("/areas/");
}

function getTempleCardImage(temple: Temple) {
  const media = getTempleMediaBySlug(temple.slug);
  return media?.hero_image ?? media?.photos?.[0]?.src ?? "";
}

function templeHasPhoto(temple: Temple) {
  return Boolean(getTempleCardImage(temple));
}

function compareAreaTemples(a: Temple, b: Temple) {
  const rankA = a.status === "existing" ? 0 : 1;
  const rankB = b.status === "existing" ? 0 : 1;
  return rankA - rankB;
}

const bottomListedTempleSlugs = district.district_id === "koyo" ? new Set(["senshoji-iwai"]) : new Set<string>();
const isBottomListedTemple = (temple: Temple) => bottomListedTempleSlugs.has(temple.slug);

const temples = [...getTemplesByDistrictId(district.district_id)].sort(compareAreaTemples);
const detailedTemples = temples.filter((temple) => hasDetailPage(temple));
const bottomListedTemples = detailedTemples.filter(isBottomListedTemple);
const standardDetailedTemples = detailedTemples.filter((temple) => !isBottomListedTemple(temple));
const templesWithPhoto = standardDetailedTemples.filter((temple) => templeHasPhoto(temple));
const templesWithoutPhoto = standardDetailedTemples.filter((temple) => !templeHasPhoto(temple));
const unresearchedTemples = temples.filter((temple) => !hasDetailPage(temple));
const monogatariDistrictUrl = getMonogatariDistrictUrl(district.district_id);
const districtColor = districtColors[district.district_id] || districtColors.unassigned;
const fallbackAreaHeroImage = templesWithPhoto.map((temple) => getTempleCardImage(temple)).find(Boolean);
const areaHeroImage = district.hero_image || fallbackAreaHeroImage;
const sectCount = new Set(detailedTemples.map((temple) => temple.sect)).size;
const searchUrl = `/search/?district=${district.district_id}`;
const mapUrl = `/map/?district=${district.district_id}`;
const heroStyle = `--district-color: ${districtColor};${areaHeroImage ? ` --area-hero-image: url("${areaHeroImage}");` : ""}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${district.name}地区のお寺・寺院一覧`,
  description: district.description,
  url: `https://temple.atawi.link/areas/${district.slug}/`,
  numberOfItems: temples.length,
};
const relatedDistrictIdsByDistrictId: Record<string, string[]> = {
  mitsuke: ["nakaizumi", "koyo", "mikuriya"],
  nakaizumi: ["mitsuke", "toyoda", "nanbu"],
  toyoda: ["nakaizumi", "mitsuke", "toyooka"],
  mikuriya: ["mitsuke", "koyo", "nanbu"],
  nanbu: ["nakaizumi", "mikuriya", "fukude"],
  koyo: ["mitsuke", "mikuriya", "toyooka"],
  ryuyo: ["fukude", "nanbu"],
  fukude: ["ryuyo", "nanbu"],
  toyooka: ["toyoda", "koyo"],
};
const relatedDistricts = (relatedDistrictIdsByDistrictId[district.district_id] || [])
  .map((districtId) => allDistricts.find((item) => item.district_id === districtId))
  .filter((item): item is (typeof allDistricts)[number] => Boolean(item));
const uploadedPhotoTempleData = temples.map((temple) => ({
  slug: temple.slug,
  name: temple.name,
  detail_url: hasDetailPage(temple) ? `/temples/${temple.slug}/` : "",
}));
const uploadedPhotoTempleDataJson = JSON.stringify(uploadedPhotoTempleData).replace(/</g, "\\u003c");

const templeGroups = [
  { kind: "photo", heading: "写真掲載あり", note: "現地写真を掲載している寺院です。", temples: templesWithPhoto },
  { kind: "plain", heading: "写真準備中", note: "基礎情報は掲載済みで、現地写真は今後追加予定です。", temples: templesWithoutPhoto },
  { kind: "pending", heading: "現地確認待ち", note: "現地での痕跡確認ができておらず、検索記録として掲載しています。", temples: unresearchedTemples },
  { kind: "withheld", heading: "掲載見合わせ", note: "関係者からの意思表示を受け、写真掲載を見合わせている寺院です。", temples: bottomListedTemples },
].filter((group) => group.temples.length > 0);
---

<BaseLayout
  title={`${district.name}地区のお寺・寺院一覧｜ATAWI TEMPLE`}
  description={`${district.name}地区にある寺院、廃寺、寺院跡を整理するATAWI TEMPLEの地区別一覧です。`}
  ogImage={areaHeroImage || undefined}
  structuredData={structuredData}
>
  <section class:list={["area-hero", { "area-hero--photo": areaHeroImage }]} style={heroStyle}>
    <div class="area-hero-copy">
      <p class="eyebrow">Area Results / {district.slug}</p>
      <h1>{district.name}の寺院検索結果</h1>
      <p>{district.summary}</p>
      <div class="area-actions">
        <a class="button-link" href={searchUrl} data-track-click="temple_search_refine">この地区で検索する</a>
        <a class="area-text-link" href={mapUrl} data-track-click="temple_map_click">地図で見る</a>
        <a class="area-text-link" href="/areas/">9地区一覧へ戻る</a>
      </div>
    </div>
    <div class="area-hero-visual" aria-hidden="true">
      <strong>{temples.length}</strong>
      <span>registered temples</span>
    </div>
    <div class="area-stat-strip" aria-label={`${district.name}地区の登録状況`}>
      <div>
        <strong>{temples.length}</strong>
        <span>登録</span>
      </div>
      <div>
        <strong>{templesWithPhoto.length}</strong>
        <span>写真掲載</span>
      </div>
      <div>
        <strong>{templesWithoutPhoto.length}</strong>
        <span>写真準備中</span>
      </div>
      <div>
        <strong>{unresearchedTemples.length}</strong>
        <span>現地確認待ち</span>
      </div>
      {bottomListedTemples.length > 0 && (
        <div>
          <strong>{bottomListedTemples.length}</strong>
          <span>掲載見合わせ</span>
        </div>
      )}
      <div>
        <strong>{sectCount}</strong>
        <span>宗派・法人</span>
      </div>
    </div>
  </section>

  <section class="section area-intro-section" aria-labelledby="area-intro-title">
    <p class="eyebrow">Area Guide</p>
    <h2 id="area-intro-title">{district.name}地区の寺院と地域史</h2>
    <p>{district.description}</p>
  </section>

  <nav class="area-switcher" style={`--district-color: ${districtColor};`} aria-label="地区を切り替える">
    {allDistricts.map((item) => (
      <a
        class:list={["area-switcher-link", { "is-current": item.district_id === district.district_id }]}
        href={`/areas/${item.slug}/`}
        aria-current={item.district_id === district.district_id ? "page" : undefined}
      >
        {item.name}
      </a>
    ))}
  </nav>

  <section class="section uploaded-photo-section" data-uploaded-area-photos hidden>
    <div class="section-heading">
      <div>
        <p class="eyebrow">Uploaded Photos</p>
        <h2>保存済み写真</h2>
      </div>
      <span class="small" data-uploaded-area-count></span>
    </div>
    <div class="photo-grid" data-uploaded-area-grid></div>
  </section>
  <script is:inline type="application/json" id="area-uploaded-photo-temples" set:html={uploadedPhotoTempleDataJson} />
  <script is:inline>
    // @ts-nocheck
    (() => {
      const dataEl = document.getElementById("area-uploaded-photo-temples");
      const section = document.querySelector("[data-uploaded-area-photos]");
      const grid = document.querySelector("[data-uploaded-area-grid]");
      const count = document.querySelector("[data-uploaded-area-count]");
      if (!dataEl || !section || !grid) return;

      let temples = [];
      try {
        temples = JSON.parse(dataEl.textContent || "[]");
      } catch {
        temples = [];
      }

      const templeBySlug = new Map(temples.map((temple) => [temple.slug, temple]));
      const slugs = temples.map((temple) => temple.slug).filter(Boolean);
      if (slugs.length === 0) return;

      fetch(`/api/photo-submissions?temple_slugs=${encodeURIComponent(slugs.join(","))}`)
        .then((response) => response.ok ? response.json() : { photos: [] })
        .then((result) => {
          const photos = Array.isArray(result.photos) ? result.photos : [];
          if (photos.length === 0) return;
          section.hidden = false;
          if (count) count.textContent = `${photos.length}枚`;
          grid.innerHTML = photos.map((photo) => photoCardHtml(photo)).join("");
          hydratePhotoCards(photos);
        })
        .catch(() => {});

      function photoCardHtml(photo) {
        const temple = templeBySlug.get(photo.temple_slug) || { name: photo.temple_slug, detail_url: "" };
        const title = temple.detail_url
          ? `<a href="${escapeHtml(temple.detail_url)}">${escapeHtml(temple.name)}</a>`
          : escapeHtml(temple.name);
        return `
          <figure class="photo-card">
            <img src="${escapeHtml(photo.url)}" alt="${escapeHtml(temple.name)}の保存済み写真" loading="lazy">
            <figcaption>
              <strong>${title}</strong>
              <span>${escapeHtml(photo.note || photo.file_name || "保存済み写真")}</span>
            </figcaption>
          </figure>
        `;
      }

      function hydratePhotoCards(photos) {
        const firstByTemple = new Map();
        photos.forEach((photo) => {
          if (!firstByTemple.has(photo.temple_slug)) firstByTemple.set(photo.temple_slug, photo);
        });
        firstByTemple.forEach((photo, slug) => {
          const card = document.querySelector(`[data-temple-card="${escapeSelector(slug)}"]`);
          if (!card || card.querySelector(".temple-card-photo")) return;
          const body = card.querySelector(".temple-card-body");
          if (!body) return;
          const temple = templeBySlug.get(slug) || { name: slug, detail_url: "" };
          const wrapper = document.createElement(temple.detail_url ? "a" : "div");
          wrapper.className = "temple-card-photo";
          if (temple.detail_url) {
            wrapper.href = temple.detail_url;
            wrapper.dataset.trackClick = "temple_detail_click";
          }
          wrapper.setAttribute("aria-label", `${temple.name}の保存済み写真`);
          wrapper.innerHTML = `<img src="${escapeHtml(photo.url)}" alt="${escapeHtml(temple.name)}の保存済み写真" loading="lazy">`;
          card.insertBefore(wrapper, body);
          card.classList.remove("temple-card--no-photo");
        });
      }

      function escapeSelector(value) {
        return window.CSS && CSS.escape ? CSS.escape(value) : String(value).replace(/["\\]/g, "\\$&");
      }

      function escapeHtml(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;");
      }
    })();
  </script>

  <section class="section area-capabilities" aria-labelledby="area-capabilities-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Area Navigation</p>
        <h2 id="area-capabilities-title">この地区でできること</h2>
      </div>
    </div>
    <div class="area-capability-grid">
      <a href="#area-temple-list">
        <span>寺院一覧を見る</span>
        <strong>{district.name}地区の登録寺院を確認</strong>
      </a>
      <a href={mapUrl} data-track-click="temple_map_click">
        <span>地図で位置を見る</span>
        <strong>地図ページをこの地区で絞り込み</strong>
      </a>
      <a href={searchUrl} data-track-click="temple_search_refine">
        <span>宗派・住所で比べる</span>
        <strong>検索ページで条件を変えて比較</strong>
      </a>
    </div>
  </section>

  <section id="area-temple-list" class="section area-results-section">
    <div class="area-results-heading">
      <div>
        <p class="eyebrow">Temple Results</p>
        <h2>登録寺院</h2>
      </div>
      <p class="small area-count-summary">
        {temples.length}件登録 / 写真掲載あり{templesWithPhoto.length}件 / 写真準備中{templesWithoutPhoto.length}件 / 現地確認待ち{unresearchedTemples.length}件
        {bottomListedTemples.length > 0 && <> / 掲載見合わせ{bottomListedTemples.length}件</>}
      </p>
    </div>
    {
      temples.length ? (
        <>
          {templeGroups.map((group) => (
            <div class:list={["area-temple-group", `area-temple-group--${group.kind}`]}>
              <div class="area-group-heading">
                <h3>{group.heading}</h3>
                <span class="small">{group.note} / {group.temples.length}件</span>
              </div>
              <div class:list={["area-result-grid", `area-result-grid--${group.kind}`]}>
                {group.temples.map((temple) => <TempleCard temple={temple} variant="area-result" />)}
              </div>
            </div>
          ))}
        </>
      ) : (
        <div class="empty">
          この地区の寺院データは現在登録されていません。追加確認できた寺院から掲載します。
        </div>
      )
    }
  </section>

  {monogatariDistrictUrl && (
    <section class="section">
      <div class="district-monogatari-block">
        <h2>この地区の歴史を磐田物語で読む</h2>
        <a class="button-link" href={monogatariDistrictUrl}>{district.name}地区の記事へ ── 磐田物語</a>
      </div>
    </section>
  )}
  {realEstateFunnel.enabled && (
    <section class="section">
      <div class="district-monogatari-block fudosan-text-panel">
        <h2>実家の整理</h2>
        <p>
          実家の土地・建物、相続登記、空き家の管理も確認したくなった方は、
          <a href={realEstateFunnel.link_url} target="_blank" rel="noopener noreferrer">ATAWI FUDOSANのふじがおか実家カルテ</a>
          から整理を始められます。
        </p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="related-districts-block">
      <div>
        <p class="eyebrow">Related Areas</p>
        <h2>隣接・関連地区へ</h2>
      </div>
      <div class="related-district-links">
        {relatedDistricts.map((item) => (
          <a href={`/areas/${item.slug}/`} data-track-click="temple_area_click">
            <strong>{item.name}</strong>
            <span>{item.summary}</span>
          </a>
        ))}
      </div>
    </div>
    <a class="button-link" href="/areas/">9地区一覧へ戻る</a>
  </section>
</BaseLayout>
