---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allSiteUpdates, HOME_UPDATE_LIMIT } from "../../lib/updates";
import UpdateDateMedia from "../../components/UpdateDateMedia.astro";

const laterUpdates = allSiteUpdates.slice(HOME_UPDATE_LIMIT);
---

<BaseLayout
  title="更新情報一覧 | ATAWI TEMPLE"
  description="ATAWI TEMPLEの寺院・研究・ブログの公開・更新情報を、トップページ掲載分に続く6件目から新しい順に掲載しています。"
>
  <section class="page-title">
    <p class="eyebrow">Updates</p>
    <h1>更新情報一覧</h1>
    <p>寺院・研究・ブログの公開・更新情報を、トップページの新着5件に続く6件目から新しい順に掲載しています。</p>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>6件目以降の更新</h2>
      <a href="/">トップページへ戻る</a>
    </div>
    {
      laterUpdates.length > 0 ? (
        <div class="update-list">
          {
            laterUpdates.map((update) => (
              <article class="update-item">
                <UpdateDateMedia date={update.date} href={update.href} title={update.title} thumbnail={update.thumbnail} />
                <div class="update-body">
                  <h3>
                    <a href={update.href}>{update.title}</a>
                  </h3>
                  <p>{update.summary}</p>
                  {update.temple_name && <span class="small">{update.temple_name} / {update.temple_area}</span>}
                </div>
              </article>
            ))
          }
        </div>
      ) : (
        <p class="empty">現在、トップページ掲載分以外の更新情報はありません。</p>
      )
    }
  </section>
</BaseLayout>
