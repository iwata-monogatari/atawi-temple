---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTokushuArticle, houyouRows, tokushuArticles } from "../../lib/editorial";

export function getStaticPaths() {
  return tokushuArticles.map((article) => ({ params: { slug: article.slug } }));
}

const article = getTokushuArticle(Astro.params.slug || "");
if (!article) return Astro.redirect("/tokushu/");

const faqJson = article.faq ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: article.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
}) : "";
---

<BaseLayout title={`${article.title}｜特集｜ATAWI TEMPLE`} description={article.description}>
  {faqJson && <script type="application/ld+json" is:inline set:html={faqJson} />}

  <article class="article-page">
    <header class="article-hero tokushu-hero">
      <p class="eyebrow">{article.category}</p>
      <h1>{article.title}</h1>
      <p class="article-subtitle">{article.subtitle}</p>
      <p class="small">更新日 {article.updated.replaceAll("-", ".")}</p>
    </header>

    <div class="article-layout">
      <main class="article-body">
        {
          article.sections.map((section, index) => (
            <section class="article-section">
              <p class="section-number">{String(index + 1).padStart(2, "0")}</p>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.figure && (
                <figure class="article-figure">
                  <img src={section.figure.src} alt={section.figure.alt} loading="lazy" decoding="async" />
                  <figcaption>{section.figure.caption}</figcaption>
                </figure>
              )}
              {section.bullets && (
                <ul class="check-list">
                  {section.bullets.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </section>
          ))
        }

        {article.slug === "houyou-sahou" && (
          <section class="article-section">
            <p class="section-number">Table</p>
            <h2>焼香の早見表</h2>
            <p>以下は目安です。宗派・寺院・地域により異なるため、菩提寺や会場の案内を優先してください。</p>
            <div class="table-wrap compact-table">
              <table>
                <thead>
                  <tr>
                    <th>宗派</th>
                    <th>焼香の目安</th>
                    <th>確認事項</th>
                  </tr>
                </thead>
                <tbody>
                  {houyouRows.map((row) => (
                    <tr>
                      <td>{row.sect}</td>
                      <td>{row.incense}</td>
                      <td>{row.note}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {article.faq && (
          <section class="article-section">
            <p class="section-number">FAQ</p>
            <h2>よくある確認</h2>
            <div class="faq-list">
              {article.faq.map((item) => (
                <article>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        <section class="article-section sources-panel">
          <p class="section-number">Sources</p>
          <h2>出典・確認先</h2>
          <ol class="source-records">
            {article.sources.map((source) => (
              <li>
                <span>参考</span>
                {source.url ? <a href={source.url}>{source.title}</a> : <strong>{source.title}</strong>}
                <p>{source.note}</p>
              </li>
            ))}
          </ol>
        </section>
      </main>

      <aside class="article-aside">
        <section class="side-panel">
          <h2>関連する入口</h2>
          <div class="side-link-list">
            {article.bridgeLinks.map((link) => (
              <a href={link.href} data-track-click={link.event}>{link.label}</a>
            ))}
          </div>
        </section>
        <section class="side-panel">
          <h2>寺院を探す</h2>
          <div class="side-link-list">
            <a href="/search/">寺院名・宗派で検索する</a>
            <a href="/areas/">9地区から探す</a>
            <a href="/sects/">宗派から探す</a>
          </div>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
