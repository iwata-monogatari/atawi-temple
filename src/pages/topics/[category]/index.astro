---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getPortalArticlesByCategory,
  getPortalCategory,
  portalCategories,
} from "../../../lib/portal-articles";

export function getStaticPaths() {
  return portalCategories.map((category) => ({ params: { category: category.key } }));
}

const category = getPortalCategory(Astro.params.category || "");
if (!category) return Astro.redirect("/topics/");
const articles = getPortalArticlesByCategory(category.key);
const previousCategory = portalCategories[category.position - 2];
const nextCategory = portalCategories[category.position];
const siteUrl = "https://temple.atawi.link";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "寺院", item: `${siteUrl}/temples/` },
      { "@type": "ListItem", position: 2, name: "法要・帰省・実家ガイド", item: `${siteUrl}/topics/` },
      { "@type": "ListItem", position: 3, name: category.label, item: `${siteUrl}/topics/${category.key}/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: category.label,
    description: category.description,
    url: `${siteUrl}/topics/${category.key}/`,
  },
];
---

<BaseLayout
  title={`${category.label}の記事一覧｜ATAWI TEMPLE`}
  description={`${category.description} ${category.count}本の記事から、今必要な確認を選べます。`}
  structuredData={structuredData}
>
  <article class="portal-index">
    <nav class="breadcrumbs" aria-label="パンくず">
      <a href="/temples/">寺院</a><span>›</span>
      <a href="/topics/">法要・帰省・実家ガイド</a><span>›</span>
      <span>{category.label}</span>
    </nav>
    <header class="portal-hero portal-hero--compact">
      <p class="eyebrow">Step {String(category.position).padStart(2, "0")}</p>
      <h1>{category.label}</h1>
      <p>{category.description}</p>
    </header>
    <section class="section">
      <div class="portal-article-grid">
        {articles.map((article, index) => (
          <a class="reading-card" href={`/topics/${article.category}/${article.slug}/`}>
            <span>{String(index + 1).padStart(2, "0")} / {category.count}</span>
            <h2>{article.title}</h2>
            <p>{article.description}</p>
          </a>
        ))}
      </div>
    </section>
    <nav class="portal-step-navigation" aria-label="前後のカテゴリ">
      {previousCategory ? <a href={`/topics/${previousCategory.key}/`}>← {previousCategory.label}</a> : <a href="/temples/">← 寺院を探す</a>}
      {nextCategory && <a href={`/topics/${nextCategory.key}/`}>{nextCategory.label} →</a>}
    </nav>
  </article>
</BaseLayout>
