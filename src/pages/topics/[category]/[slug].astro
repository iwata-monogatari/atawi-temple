---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RichGuideIllustration from "../../../components/RichGuideIllustration.astro";
import {
  getPortalArticle,
  getPortalArticlesByCategory,
  portalArticles,
  portalCategories,
} from "../../../lib/portal-articles";
import { priorityPortalSlugs } from "../../../lib/portal-priority-articles";

export function getStaticPaths() {
  return portalArticles.map((article) => ({
    params: { category: article.category, slug: article.slug },
  }));
}

const article = getPortalArticle(Astro.params.category || "", Astro.params.slug || "");
if (!article) return Astro.redirect("/topics/");
const isPriorityArticle = priorityPortalSlugs.includes(article.slug);
const category = portalCategories.find((item) => item.key === article.category)!;
const categoryArticles = getPortalArticlesByCategory(article.category);
const related = categoryArticles.filter((item) => item.slug !== article.slug).slice(0, 3);
const siteUrl = "https://temple.atawi.link";
const pageUrl = `${siteUrl}/topics/${article.category}/${article.slug}/`;
const breadcrumbItems = [
  { name: "寺院", url: `${siteUrl}/temples/` },
  { name: "法要", url: `${siteUrl}/topics/houyou/` },
  ...(category.position > 5 ? [{ name: "法要帰省", url: `${siteUrl}/topics/kisei/` }] : []),
  ...(category.position > 5 ? [{ name: category.label, url: `${siteUrl}/topics/${category.key}/` }] : category.key !== "houyou" ? [{ name: category.label, url: `${siteUrl}/topics/${category.key}/` }] : []),
  { name: article.title, url: pageUrl },
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.title,
    description: article.description,
    datePublished: article.updated,
    dateModified: article.updated,
    mainEntityOfPage: pageUrl,
    author: { "@type": "Organization", name: "ATAWI TEMPLE編集部" },
    publisher: {
      "@type": "Organization",
      name: "ATAWI TEMPLE",
      logo: { "@type": "ImageObject", url: `${siteUrl}/assets/brand/atawi-temple-mark.svg` },
    },
    citation: article.sources.map((source) => source.href.startsWith("/") ? `${siteUrl}${source.href}` : source.href),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: article.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout
  title={`${article.title}｜ATAWI TEMPLE`}
  description={article.description}
  structuredData={structuredData}
  ogType="article"
  publishedTime={`${article.updated}T00:00:00+09:00`}
  modifiedTime={`${article.updated}T00:00:00+09:00`}
>
  <article class="portal-article">
    <nav class="breadcrumbs" aria-label="パンくず">
      {breadcrumbItems.map((item, index) => (
        <><a href={item.url.replace(siteUrl, "")}>{item.name}</a>{index < breadcrumbItems.length - 1 && <span>›</span>}</>
      ))}
    </nav>
    <header class="article-hero">
      <p class="eyebrow">{article.categoryLabel}</p>
      {isPriorityArticle && <p class="priority-editorial-badge">重点個別編集記事</p>}
      <h1>{article.title}</h1>
      <p class="article-subtitle">{article.lead}</p>
      <p class="small">更新日 {article.updated.replaceAll("-", ".")}</p>
    </header>

    <div class="article-layout">
      <main class="article-body">
        <section class="article-section">
          <p class="section-number">Conclusion</p>
          <h2>結論</h2>
          <p>{article.conclusion}</p>
        </section>

        {article.longform ? article.longform.sections.map((section, index) => (
          <>
            <section class="article-section longform-section" data-longform-section={index + 1}>
              <p class="section-number">{String(index + 1).padStart(2, "0")}</p>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </section>
            {index < 3 && (() => {
              const illustration = article.longform!.illustrations[index];
              return <RichGuideIllustration illustration={illustration} titleId={`illustration-title-${article.slug}-${index}`} />;
            })()}
          </>
        )) : (
        <>
        <section class="article-section">
          <p class="section-number">01</p>
          <h2>{article.title}で最初にすること</h2>
          <p>{article.firstAction}</p>
          <p>確認した日、確認した人、情報の出どころを一緒に残してください。分からない項目は空欄のままで構いません。</p>
        </section>

        <section class="article-section">
          <p class="section-number">02</p>
          <h2>確認を進める3つの手順</h2>
          <ol class="article-steps">
            {article.steps.map((step) => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}
          </ol>
        </section>

        <section class="article-section">
          <p class="section-number">03</p>
          <h2>家族へ切り出す言葉</h2>
          <blockquote class="conversation-example">{article.conversationExample}</blockquote>
          <p>相手が話したくないときは、その日は確認を進めません。本人の希望とペースを優先します。</p>
        </section>
        </>
        )}

        <aside class="article-caution" aria-label="このテーマの注意点">
          <strong>このテーマの注意点</strong>
          <p>{article.caution}</p>
        </aside>

        <section class="article-section">
          <p class="section-number">Check</p>
          <h2>確認ポイント</h2>
          <ul class="check-list">
            {article.points.map((point) => <li>{point}</li>)}
          </ul>
        </section>

        <section class="article-section">
          <p class="section-number">FAQ</p>
          <h2>よくある確認</h2>
          <div class="faq-list">
            {article.faq.map((item) => (
              <article><h3>{item.question}</h3><p>{item.answer}</p></article>
            ))}
          </div>
        </section>

        <section class="article-section">
          <p class="section-number">Related</p>
          <h2>関連記事</h2>
          <div class="side-link-list">
            {related.map((item) => <a href={`/topics/${item.category}/${item.slug}/`}>{item.title}</a>)}
          </div>
        </section>

        <section class="article-section source-section">
          <p class="section-number">Sources</p>
          <h2>確認先・参考情報</h2>
          <p>制度や手続きは変更されることがあります。実際の判断は、次の公的・公式情報と個別の確認先を優先してください。</p>
          <ul class="source-list">
            {article.sources.map((source) => (
              <li>
                <a href={source.href} target={source.href.startsWith("http") ? "_blank" : undefined} rel={source.href.startsWith("http") ? "noopener noreferrer" : undefined}>{source.label}</a>
                <span>{source.note}</span>
              </li>
            ))}
          </ul>
          <p class="small">執筆・確認：ATAWI TEMPLE編集部　最終確認日：{article.updated.replaceAll("-", ".")}</p>
          {isPriorityArticle && <p class="small">この記事は、主題に直接対応する一次情報を確認し、手順・会話例・注意点を個別に編集しています。</p>}
          <p class="small"><a href="/editorial-policy/">編集方針</a>に基づき、宗派・法務・税務を一律に断定せず、確認先を示しています。</p>
        </section>

        <section class:list={["article-section", "portal-cta", `portal-cta--${article.cta}`]}>
          <p class="section-number">Next</p>
          <h2>{article.cta === "strong" ? "実家の情報を整理する" : article.cta === "medium" ? "帰省時の確認を記録する" : "次の記事へ進む"}</h2>
          {article.cta === "strong" ? (
            <>
              <p>実家カルテで現状を整理し、家族だけで確認しにくい項目が残った場合は、必要な方だけ富士ヶ丘サービスへ相談できます。</p>
              <div class="houyou-bridge-actions">
                <a class="button-link" href="/jikka-karute/" data-cv-event="karte-start">実家カルテを作る</a>
                <a class="button-link secondary-button" href="https://fudosan.atawi.link/from-temple/?utm_source=temple&utm_medium=referral&utm_campaign=jikka_karute&utm_content=article_cta" target="_blank" rel="noopener noreferrer" data-cv-event="consultation">相談方法を確認する<span class="external-mark">外部</span></a>
              </div>
            </>
          ) : article.cta === "medium" ? (
            <>
              <p>結論を出す前に、見たこと、聞いたこと、次に確認することを残しておきましょう。</p>
              <a class="button-link" href="/topics/jikka/jikka-30/">実家確認チェックリストを見る</a>
            </>
          ) : (
            <>
              <p>関連する記事を読み、次に確認することを一つ選んでください。</p>
              {article.next && <a class="button-link" href={article.next.href}>{article.next.label}</a>}
            </>
          )}
        </section>
      </main>

      <aside class="article-aside">
        <section class="side-panel">
          <h2>次に読む記事</h2>
          <div class="side-link-list">
            {article.previous && <a href={article.previous.href}>← {article.previous.label}</a>}
            {article.next && <a href={article.next.href}>{article.next.label} →</a>}
          </div>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
