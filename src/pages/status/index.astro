---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  allTemples,
  countTemplesByDistrict,
  countTemplesBySect,
  countTemplesByStatus,
  countTemplesWithPhotos,
  countUnassignedDistrictTemples,
  getStatusLabel,
} from "../../lib/temples";

import { allRefurbFacts, getGradeLabel } from "../../lib/refurb";

const statusCounts = countTemplesByStatus();
const refurbFacts = allRefurbFacts();
const gradeCounts = { T1: 0, T2: 0, T3: 0 } as Record<string, number>;
for (const facts of refurbFacts) {
  if (facts.grade in gradeCounts) gradeCounts[facts.grade] += 1;
}
const districtCounts = countTemplesByDistrict();
const sectCounts = countTemplesBySect();
const unknownDistrictCount = countUnassignedDistrictTemples();
const officialSourceCount = allTemples.filter((temple) =>
  temple.sources.some((source) => source.title.includes("静岡県知事所轄宗教法人名簿")),
).length;
const visitedCount = countTemplesWithPhotos();
const districtTotal = districtCounts.reduce((total, district) => total + district.count, 0) + unknownDistrictCount;
const sectTotal = sectCounts.reduce((total, sect) => total + sect.count, 0);
---

<BaseLayout
  title="調査状況｜ATAWI TEMPLE"
  description="ATAWI TEMPLEの寺院マスター登録件数、9地区別件数、現地訪問状況、詳細ページ公開状況を確認できます。"
>
  <section class="page-title">
    <p class="eyebrow">Research Status</p>
    <h1>調査状況</h1>
    <p>公式名簿をもとにした基礎情報の登録状況と、今後の現地・文献調査の進み具合を公開します。</p>
  </section>

  <section class="section">
    <div class="stats-grid">
      <article class="stat-card">
        <span>登録件数</span>
        <strong>{allTemples.length}</strong>
        <small>寺院・廃寺・寺院跡を含む</small>
      </article>
      <article class="stat-card">
        <span>公式名簿反映済み</span>
        <strong>{officialSourceCount}</strong>
        <small>静岡県知事所轄宗教法人名簿を参照</small>
      </article>
      <article class="stat-card">
        <span>現地写真掲載</span>
        <strong>{visitedCount}</strong>
        <small>写真データのある寺院を自動集計</small>
      </article>
      <article class="stat-card">
        <span>地区未確定</span>
        <strong>{unknownDistrictCount}</strong>
        <small>所在地確認後に9地区へ分類</small>
      </article>
    </div>
  </section>

  {refurbFacts.length > 0 && (
    <section class="section">
      <h2>ページ充実度（品質等級）</h2>
      <p class="small">
        2026年7月の全面改修で再判定した等級です。T1（充実）＝本文6,000字以上・出典12件以上、
        T2（標準）＝4,500字以上・出典8件以上、T3（基礎情報）＝2,500字以上・出典5件以上。
      </p>
      <div class="stats-grid">
        <article class="stat-card">
          <span>全面改修済み</span>
          <strong>{refurbFacts.length}</strong>
          <small>個別ページのある寺院のうち改修完了した件数</small>
        </article>
        {(["T1", "T2", "T3"] as const).map((grade) => (
          <article class="stat-card">
            <span>{grade}（{getGradeLabel(grade)}）</span>
            <strong>{gradeCounts[grade]}</strong>
            <small>機械検証（出典・字数・表記）を通過</small>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="section two-column">
    <div>
      <h2>状態別件数</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>状態</th>
              <th>件数</th>
            </tr>
          </thead>
          <tbody>
            {
              Object.entries(statusCounts).map(([status, count]) => (
                <tr>
                  <td>{getStatusLabel(status)}</td>
                  <td>{count}</td>
                </tr>
              ))
            }
            <tr>
              <td>状態別合計</td>
              <td>{Object.values(statusCounts).reduce((total, count) => total + count, 0)}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <div>
      <h2>9地区別件数</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>地区</th>
              <th>件数</th>
            </tr>
          </thead>
          <tbody>
            {
              districtCounts.map((district) => (
                <tr>
                  <td><a href={`/areas/${district.slug}/`}>{district.name}</a></td>
                  <td>{district.count}</td>
                </tr>
              ))
            }
            <tr>
              <td>地区未確定</td>
              <td>{unknownDistrictCount}</td>
            </tr>
            <tr>
              <td>地区別合計</td>
              <td>{districtTotal}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>宗派・関連法人別件数</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>分類</th>
            <th>件数</th>
          </tr>
        </thead>
        <tbody>
          {
            sectCounts.map((sect) => (
              <tr>
                <td><a href={`/sects/${sect.slug}/`}>{sect.name}</a></td>
                <td>{sect.count}</td>
              </tr>
            ))
          }
          <tr>
            <td>宗派・関連法人別合計</td>
            <td>{sectTotal}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section notice">
    <h2>件数の考え方</h2>
    <p>
      現在の件数は、静岡県知事所轄宗教法人名簿に掲載された磐田市内の寺院・関連宗教法人を基礎にしています。
      廃寺、旧寺院跡、札所、堂宇、文化財、現地写真、由緒は、行政資料、宗派名簿、郷土資料、現地確認を照合しながら追加します。
    </p>
  </section>
</BaseLayout>
