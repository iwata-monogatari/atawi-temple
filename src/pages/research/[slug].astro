---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getResearchArticle, researchArticles } from "../../lib/research-articles";
import { getTempleBySlug } from "../../lib/temples";

export function getStaticPaths() {
  return researchArticles.map((article) => ({ params: { slug: article.slug } }));
}

const article = getResearchArticle(Astro.params.slug || "");
if (!article) return Astro.redirect("/research/");
const relatedTemple = article.templeSlug ? getTempleBySlug(article.templeSlug) : undefined;
const siteUrl = "https://temple.atawi.link";

const author = {
  "@type": "Person",
  name: "大石浩之",
  jobTitle: "代表取締役",
  worksFor: {
    "@type": "Organization",
    name: "富士ヶ丘サービス株式会社",
  },
};

const structuredData = [{
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: article.title,
  description: article.description,
  datePublished: article.published,
  dateModified: article.updated,
  inLanguage: "ja",
  author,
  publisher: {
    "@type": "Organization",
    name: "ATAWI TEMPLE",
    url: "https://temple.atawi.link/",
  },
  keywords: article.keywords.join(", "),
}, {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "HOME", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "研究・地域史", item: `${siteUrl}/research/` },
    { "@type": "ListItem", position: 3, name: article.series, item: `${siteUrl}/research/` },
    { "@type": "ListItem", position: 4, name: article.title, item: `${siteUrl}/research/${article.slug}/` },
  ],
}];
---

<BaseLayout
  title={`${article.title}｜研究紀要｜ATAWI TEMPLE`}
  description={article.description}
  ogImage={article.sections.find((section) => section.figure)?.figure?.src}
  hideSeasonalBanner={true}
  structuredData={structuredData}
>
  <article class="research-page">
    <nav class="breadcrumbs" aria-label="パンくず"><a href="/">HOME</a><span>›</span><a href="/research/">研究・地域史</a><span>›</span><span>{article.series}</span><span>›</span><span>{article.title}</span></nav>
    <header class="research-hero">
      <p class="research-journal">ATAWI TEMPLE 地域寺院研究紀要</p>
      <h1>{article.title}</h1>
      <p class="article-subtitle">{article.subtitle}</p>
      <p class="research-author">大石浩之<sup>1</sup></p>
      <p class="research-affiliation"><sup>1</sup> 富士ヶ丘サービス株式会社 代表取締役</p>
      <dl class="research-meta">
        <div><dt>公開日</dt><dd>{article.published.replaceAll("-", ".")}</dd></div>
        <div><dt>資料検証</dt><dd>{article.verificationStatus}</dd></div>
      </dl>
    </header>

    <main class="research-body">
        <section class="research-abstract" aria-labelledby="abstract-title">
          <h2 id="abstract-title">要旨</h2>
          <p>{article.abstract}</p>
          <p class="small"><strong>キーワード：</strong>{article.keywords.join("／")}</p>
        </section>

        <nav class="research-toc" aria-label="論文目次">
          <h2>目次</h2>
          <ol>
            {article.sections.map((section, index) => (
              <li><a href={`#section-${index + 1}`}>{section.heading}</a></li>
            ))}
          </ol>
        </nav>

        {article.sections.map((section, index) => (
          <section class="research-section" id={`section-${index + 1}`}>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.figure && (
              <figure class="article-figure">
                <img
                  src={section.figure.src}
                  alt={section.figure.alt}
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{section.figure.caption}</figcaption>
              </figure>
            )}
          </section>
        ))}

        <section class="research-references">
          <h2>参考文献・資料</h2>
          <ol>
            {article.sources.map((source, index) => (
              <li>
                <span class="reference-number">[{index + 1}]</span>
                {source.publisher}「<a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>」。
                <span>{source.note} 最終閲覧日：{source.accessed}。</span>
              </li>
            ))}
          </ol>
        </section>

        {relatedTemple && (
          <section class="research-related-temple">
            <p class="eyebrow">Temple Database</p>
            <h2>この研究で扱った寺院</h2>
            <p>所在地、宗派、文化財、出典などの基礎情報は寺院データベースで確認できます。</p>
            <a class="button-link secondary-button" href={`/temples/${relatedTemple.slug}/`}>{relatedTemple.name}について基本情報を見る →</a>
          </section>
        )}

        <section class="author-note">
          <h2>著者情報</h2>
          <p>
            大石浩之。富士ヶ丘サービス株式会社代表取締役。静岡県磐田市を拠点として介護事業および不動産事業を運営する一方、ATAWI TEMPLEにおいて地域寺院資料の収集・整理・公開に取り組む。本論文は寺院・宗派の公式見解ではなく、表示した資料に基づく著者の研究成果である。
          </p>
          <p>
            資料の追加および記載の訂正は、<a href="/correction/">情報提供・訂正窓口</a>で受け付けている。
          </p>
        </section>
    </main>
  </article>
</BaseLayout>
