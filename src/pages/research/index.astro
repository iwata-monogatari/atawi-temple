---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { researchArticles } from "../../lib/research-articles";
import { getDistrictName, getTempleBySlug } from "../../lib/temples";

const normalizedArticles = researchArticles
  .map((article) => ({
    ...article,
    temple: article.templeSlug ? getTempleBySlug(article.templeSlug) : undefined,
    districtId: article.templeSlug ? getTempleBySlug(article.templeSlug)?.district_id || "unassigned" : "general",
    districtName: article.templeSlug
      ? getDistrictName(getTempleBySlug(article.templeSlug)?.district_id || "unassigned")
      : "全市・総合",
  }))
  .sort((a, b) => b.updated.localeCompare(a.updated) || a.title.localeCompare(b.title, "ja"));

const templeGroups = Array.from(
  normalizedArticles.reduce((groups, article) => {
    const key = article.templeSlug || "general";
    const label = article.temple?.name || "磐田の寺院・総合研究";
    const current = groups.get(key) || {
      key,
      label,
      districtId: article.districtId,
      districtName: article.districtName,
      articles: [] as typeof normalizedArticles,
    };
    current.articles.push(article);
    groups.set(key, current);
    return groups;
  }, new Map<string, {
    key: string;
    label: string;
    districtId: string;
    districtName: string;
    articles: typeof normalizedArticles;
  }>())
  .values(),
).sort((a, b) => {
  if (a.key === "general") return -1;
  if (b.key === "general") return 1;
  return a.label.localeCompare(b.label, "ja");
});

const seriesOptions = Array.from(new Set(normalizedArticles.map((article) => article.series)));
const districtOptions = Array.from(
  new Map(
    normalizedArticles.map((article) => [
      article.districtId,
      { id: article.districtId, name: article.districtName },
    ]),
  ).values(),
).sort((a, b) => a.name.localeCompare(b.name, "ja"));
---

<BaseLayout
  title="研究論文一覧 | ATAWI TEMPLE"
  description="磐田市の寺院史、文化財、地域社会を、公開資料と現地記録に基づいて検証するATAWI TEMPLEの研究論文一覧です。寺院名・題名・キーワードから検索できます。"
  hideSeasonalBanner={true}
>
  <nav class="breadcrumbs research-index-breadcrumbs" aria-label="パンくず"><a href="/">HOME</a><span>›</span><span>研究・地域史</span></nav>
  <section class="research-index-hero">
    <div>
      <p class="eyebrow">ATAWI TEMPLE RESEARCH</p>
      <h1>研究論文一覧</h1>
      <p>寺院ごとに論文を整理し、題名・寺院名・キーワードから検索できます。伝承、確認事実、研究上の推定を区別して公開しています。</p>
      <p>
        <a href="#general">総合論文だけを読む</a>
        <span aria-hidden="true"> ／ </span>
        <a href="/editorial-progress/">論文制作の進捗ダッシュボードを見る</a>
      </p>
    </div>
    <dl class="research-index-stats" aria-label="研究論文の公開状況">
      <div><dt>公開論文</dt><dd>{normalizedArticles.length}<span>本</span></dd></div>
      <div><dt>対象寺院</dt><dd>{templeGroups.filter((group) => group.key !== "general").length}<span>寺院</span></dd></div>
      <div><dt>最終更新</dt><dd class="date">{normalizedArticles[0]?.updated.replaceAll("-", ".")}</dd></div>
    </dl>
  </section>

  <section class="research-index-tools" aria-label="研究論文を絞り込む">
    <div class="research-search-field">
      <label for="research-query">論文を検索</label>
      <input id="research-query" type="search" placeholder="寺院名・題名・キーワードを入力" autocomplete="off" data-research-query />
    </div>
    <div>
      <label for="research-temple">寺院から選ぶ</label>
      <select id="research-temple" data-research-temple>
        <option value="">すべての寺院</option>
        {templeGroups.map((group) => <option value={group.key}>{group.label}（{group.articles.length}）</option>)}
      </select>
    </div>
    <div>
      <label for="research-district">地区から選ぶ</label>
      <select id="research-district" data-research-district>
        <option value="">すべての地区</option>
        {districtOptions.map((district) => (
          <option value={district.id}>
            {district.name}（{normalizedArticles.filter((article) => article.districtId === district.id).length}）
          </option>
        ))}
      </select>
    </div>
    <div>
      <label for="research-series">研究区分</label>
      <select id="research-series" data-research-series>
        <option value="">すべての区分</option>
        {seriesOptions.map((series) => <option value={series}>{series}</option>)}
      </select>
    </div>
    <button type="button" class="research-filter-reset" data-research-reset>条件を解除</button>
    <p class="research-result-count" aria-live="polite"><strong data-research-count>{normalizedArticles.length}</strong>本を表示</p>
  </section>

  <section class="research-index-results" data-research-results>
    {templeGroups.map((group) => (
      <section
        class="research-temple-group"
        id={group.key === "general" ? "general" : undefined}
        data-research-group={group.key}
      >
        <header>
          <div>
            <p class="eyebrow">TEMPLE RESEARCH</p>
            <h2>{group.label}</h2>
            <p class="research-group-district">{group.districtName}地区</p>
          </div>
          {group.key !== "general" && <a href={`/temples/${group.key}/`}>寺院詳細を見る</a>}
        </header>
        <div class="research-article-list">
          {group.articles.map((article, articleIndex) => (
            <article
              class="research-index-card"
              data-research-card
              data-general-overflow={group.key === "general" && articleIndex >= 4 ? "true" : undefined}
              data-temple={group.key}
              data-district={article.districtId}
              data-series={article.series}
              data-search={`${group.label} ${article.title} ${article.subtitle} ${article.description} ${article.keywords.join(" ")}`.toLowerCase()}
              hidden={group.key === "general" && articleIndex >= 4}
            >
              <div class="research-card-meta">
                <span>{article.series}</span>
                <time datetime={article.updated}>{article.updated.replaceAll("-", ".")}</time>
              </div>
              <h3><a href={`/research/${article.slug}/`}>{article.title}</a></h3>
              <p class="research-card-subtitle">{article.subtitle}</p>
              <p>{article.description}</p>
              <ul aria-label="キーワード">
                {article.keywords.slice(0, 5).map((keyword) => <li>{keyword}</li>)}
              </ul>
              <div class="research-card-footer">
                <span>{article.verificationStatus}</span>
                <a href={`/research/${article.slug}/`}>論文を読む</a>
              </div>
            </article>
          ))}
        </div>
        {group.key === "general" && group.articles.length > 4 && (
          <button
            type="button"
            class="research-general-toggle"
            aria-expanded="false"
            data-general-toggle
            data-collapsed-label={`残り${group.articles.length - 4}本の総合論文を表示`}
          >
            残り{group.articles.length - 4}本の総合論文を表示
          </button>
        )}
      </section>
    ))}
    <div class="research-empty" data-research-empty hidden>
      <h2>該当する論文がありません</h2>
      <p>検索語を短くするか、絞り込み条件を解除してください。</p>
    </div>
  </section>

  <script>
    const queryInput = document.querySelector<HTMLInputElement>("[data-research-query]");
    const templeSelect = document.querySelector<HTMLSelectElement>("[data-research-temple]");
    const districtSelect = document.querySelector<HTMLSelectElement>("[data-research-district]");
    const seriesSelect = document.querySelector<HTMLSelectElement>("[data-research-series]");
    const resetButton = document.querySelector<HTMLButtonElement>("[data-research-reset]");
    const count = document.querySelector<HTMLElement>("[data-research-count]");
    const empty = document.querySelector<HTMLElement>("[data-research-empty]");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-research-card]"));
    const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-research-group]"));
    const generalOverflow = Array.from(document.querySelectorAll<HTMLElement>("[data-general-overflow]"));
    const generalToggle = document.querySelector<HTMLButtonElement>("[data-general-toggle]");
    let generalExpanded = generalToggle?.getAttribute("aria-expanded") === "true";

    function normalize(value: string) {
      return value.toLowerCase().normalize("NFKC").replace(/\s+/g, " ").trim();
    }

    function applyFilters() {
      const query = normalize(queryInput?.value || "");
      const temple = templeSelect?.value || "";
      const district = districtSelect?.value || "";
      const series = seriesSelect?.value || "";
      const filtersActive = Boolean(query || temple || district || series);
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesQuery = !query || normalize(card.dataset.search || "").includes(query);
        const matchesTemple = !temple || card.dataset.temple === temple;
        const matchesDistrict = !district || card.dataset.district === district;
        const matchesSeries = !series || card.dataset.series === series;
        const matches = matchesQuery && matchesTemple && matchesDistrict && matchesSeries;
        const collapsed = card.dataset.generalOverflow === "true" && !filtersActive && !generalExpanded;
        card.hidden = !matches || collapsed;
        if (matches) visibleCount += 1;
      });

      groups.forEach((group) => {
        group.hidden = !Array.from(group.querySelectorAll<HTMLElement>("[data-research-card]")).some((card) => {
          const matches = !card.hidden;
          const collapsedGeneral = card.dataset.generalOverflow === "true" && !filtersActive && !generalExpanded;
          return matches || collapsedGeneral;
        });
      });
      if (generalToggle) generalToggle.hidden = filtersActive || generalOverflow.length === 0;
      if (count) count.textContent = String(visibleCount);
      if (empty) empty.hidden = visibleCount !== 0;
    }

    queryInput?.addEventListener("input", applyFilters);
    templeSelect?.addEventListener("change", applyFilters);
    districtSelect?.addEventListener("change", applyFilters);
    seriesSelect?.addEventListener("change", applyFilters);
    generalToggle?.addEventListener("click", () => {
      generalExpanded = !generalExpanded;
      generalToggle.setAttribute("aria-expanded", String(generalExpanded));
      generalToggle.textContent = generalExpanded
        ? "総合論文を4本だけ表示"
        : generalToggle.dataset.collapsedLabel || "残りの総合論文を表示";
      applyFilters();
    });
    resetButton?.addEventListener("click", () => {
      if (queryInput) queryInput.value = "";
      if (templeSelect) templeSelect.value = "";
      if (districtSelect) districtSelect.value = "";
      if (seriesSelect) seriesSelect.value = "";
      applyFilters();
      queryInput?.focus();
    });
  </script>
</BaseLayout>
