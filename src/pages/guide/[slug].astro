---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGuideArticle, guideArticles, jikkaUrl } from "../../lib/editorial";

export function getStaticPaths() {
  return guideArticles.map((article) => ({ params: { slug: article.slug } }));
}

const article = getGuideArticle(Astro.params.slug || "");
if (!article) return Astro.redirect("/guide/");

const faqJson = article.faq ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: article.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
}) : "";
---

<BaseLayout title={`${article.title}｜ATAWI TEMPLE`} description={article.description}>
  {faqJson && <script type="application/ld+json" is:inline set:html={faqJson} />}

  <article class="article-page">
    <header class="article-hero">
      <p class="eyebrow">{article.category}</p>
      <h1>{article.title}</h1>
      <p class="article-subtitle">{article.subtitle}</p>
      <p class="small">更新日 {article.updated.replaceAll("-", ".")}</p>
    </header>

    <div class="article-layout">
      <main class="article-body">
        {
          article.sections.map((section, index) => (
            <section class="article-section">
              <p class="section-number">{String(index + 1).padStart(2, "0")}</p>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && (
                <ul class="check-list">
                  {section.bullets.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </section>
          ))
        }

        {article.faq && (
          <section class="article-section">
            <p class="section-number">FAQ</p>
            <h2>よくある確認</h2>
            <div class="faq-list">
              {article.faq.map((item) => (
                <article>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        <section class="article-section sources-panel">
          <p class="section-number">Sources</p>
          <h2>出典・確認先</h2>
          <ol class="source-records">
            {article.sources.map((source) => (
              <li>
                <span>参考</span>
                {source.url ? <a href={source.url}>{source.title}</a> : <strong>{source.title}</strong>}
                <p>{source.note}</p>
              </li>
            ))}
          </ol>
        </section>
      </main>

      <aside class="article-aside">
        <section class="side-panel">
          <h2>次に読む</h2>
          <div class="side-link-list">
            {article.bridgeLinks.map((link) => (
              <a href={link.href} data-track-click={link.event}>{link.label}</a>
            ))}
          </div>
        </section>
        <section class="side-panel conversion-panel">
          <span>運営元による相談窓口</span>
          <h2>ふじがおか実家カルテ</h2>
          <p>売ると決めていなくても、名義・相続登記・荷物・建物・土地を分けて整理できます。</p>
          <a
            class="button-link"
            href={jikkaUrl("guide", article.slug)}
            data-track-click="guide_to_jikka_click"
          >ふじがおか実家カルテを見る</a>
          <p class="small">本相談窓口はサイト運営元によるもので、掲載寺院とは関係ありません。</p>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
