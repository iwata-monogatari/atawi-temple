---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fromTempleUrl, getGuideArticle, publicGuideArticles } from "../../lib/editorial";

export function getStaticPaths() {
  return publicGuideArticles.map((article) => ({ params: { slug: article.slug } }));
}

const article = getGuideArticle(Astro.params.slug || "");
if (!article) return Astro.redirect("/guide/");
const guideViewEvent = article.slug === "houyou-kisei" ? "kisei_guide_view" : "";
const guideConsultUrl = fromTempleUrl(`guide_${article.slug}_bottom`);

const faqJson = article.faq ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: article.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
}) : "";
---

<BaseLayout title={`${article.title}｜ATAWI TEMPLE`} description={article.description}>
  {faqJson && <script type="application/ld+json" is:inline set:html={faqJson} />}

  <article class="article-page">
    <header class="article-hero">
      <p class="eyebrow">{article.category}</p>
      <h1>{article.title}</h1>
      <p class="article-subtitle">{article.subtitle}</p>
      <p class="small">更新日 {article.updated.replaceAll("-", ".")}</p>
    </header>

    <div class="article-layout">
      <main class="article-body">
        {
          article.sections.map((section, index) => (
            <section class="article-section">
              <p class="section-number">{String(index + 1).padStart(2, "0")}</p>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {section.bullets && (
                <ul class="check-list">
                  {section.bullets.map((item) => <li>{item}</li>)}
                </ul>
              )}
              {section.cards && (
                <div class="section-card-grid">
                  {section.cards.map((card) => (
                    <article class="section-card">
                      <h3>{card.heading}</h3>
                      <p>{card.body}</p>
                    </article>
                  ))}
                </div>
              )}
              {section.cta && (
                <div
                  class="article-section-cta"
                  data-fujigaoka-intro={section.cta.event === "to_fudosan_click" ? "true" : undefined}
                >
                  <a
                    class="button-link"
                    href={section.cta.href}
                    data-track-click={section.cta.event}
                    target={section.cta.external ? "_blank" : undefined}
                    rel={section.cta.external ? "noopener noreferrer" : undefined}
                  >
                    {section.cta.label}
                    {section.cta.external && <span class="external-mark">外部</span>}
                  </a>
                  {section.cta.note && <p>{section.cta.note}</p>}
                </div>
              )}
              {section.note && <p class="external-service-note">{section.note}</p>}
            </section>
          ))
        }

        {article.faq && (
          <section class="article-section">
            <p class="section-number">FAQ</p>
            <h2>よくある確認</h2>
            <div class="faq-list">
              {article.faq.map((item) => (
                <article>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        <section class="article-section sources-panel">
          <p class="section-number">Sources</p>
          <h2>出典・確認先</h2>
          <ol class="source-records">
            {article.sources.map((source) => (
              <li>
                <span>参考</span>
                {source.url ? <a href={source.url}>{source.title}</a> : <strong>{source.title}</strong>}
                <p>{source.note}</p>
              </li>
            ))}
          </ol>
        </section>

        <section class="article-section article-consult-panel">
          <p class="section-number">Check</p>
          <h2>実家・お墓まわりを確認だけ相談する</h2>
          <p>
            寺院、墓、仏壇、位牌の確認と、実家の名義・道路・空き家管理の確認は別の作業です。
            必要な方だけ、運営元の関連サービスで住所から分かる範囲を整理できます。
          </p>
          <div class="article-section-cta">
            <a
              class="button-link secondary-button"
              href={guideConsultUrl}
              data-track-click="to_fudosan_click"
              target="_blank"
              rel="noopener noreferrer"
            >
              実家・お墓まわりの確認だけ相談する<span class="external-mark">外部</span>
            </a>
            <p>査定ではありません。掲載寺院との提携・紹介関係もありません。寺院への法要・供養相談は寺院へ直接確認してください。</p>
          </div>
        </section>
      </main>

      <aside class="article-aside">
        <section class="side-panel">
          <h2>次に読む</h2>
          <div class="side-link-list">
            {article.bridgeLinks.map((link) => (
              <a
                href={link.href}
                data-track-click={link.event}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
              >{link.label}</a>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </article>
  <script is:inline define:vars={{ guideViewEvent }}>
    // @ts-nocheck
    (function () {
      function trackerEndpoint() {
        var tracker = document.querySelector("script[data-fujigaoka-analytics]");
        if (!tracker || !tracker.src || location.hostname !== "temple.atawi.link") return null;
        return {
          url: new URL("/api/click", tracker.src).href,
          siteId: tracker.getAttribute("data-site") || "atawi-temple",
        };
      }

      function sendEvent(eventName) {
        var endpoint = trackerEndpoint();
        if (!endpoint || !eventName) return;
        var payload = JSON.stringify({
          site_id: endpoint.siteId,
          path: location.pathname + location.search,
          url: location.href,
          referrer: document.referrer || "",
          event_name: eventName,
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon(endpoint.url, new Blob([payload], { type: "application/json" }));
          return;
        }
        if (window.fetch) {
          fetch(endpoint.url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: payload,
            mode: "cors",
            credentials: "omit",
            keepalive: true,
          }).catch(function () {});
        }
      }

      window.addEventListener("load", function () {
        sendEvent(guideViewEvent);
        var intro = document.querySelector("[data-fujigaoka-intro]");
        if (!intro) return;
        if (!("IntersectionObserver" in window)) {
          sendEvent("fujigaoka_intro_view");
          return;
        }
        var seen = false;
        var observer = new IntersectionObserver(function (entries) {
          if (seen) return;
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            seen = true;
            sendEvent("fujigaoka_intro_view");
            observer.disconnect();
          });
        }, { threshold: 0.4 });
        observer.observe(intro);
      });
    })();
  </script>
</BaseLayout>
