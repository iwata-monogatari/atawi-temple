---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publicGuideArticles } from "../../lib/editorial";
---

<BaseLayout
  title="檀家・実家じまいの基礎ガイド｜ATAWI TEMPLE"
  description="磐田のお寺を調べる方へ。檀家、法要、帰省時の実家確認を中立に整理します。"
>
  <section class="page-title">
    <p class="eyebrow">Guide</p>
    <h1>檀家・実家じまいの基礎ガイド</h1>
    <p class="lead">寺院情報を調べたあと、家族で何を確認すればよいか。檀家、法要、実家の管理を、売却ありきではなく順番に整理します。</p>
  </section>

  <section class="section">
    <div class="article-card-grid">
      {
        publicGuideArticles.map((article) => (
          <a class="reading-card" href={`/guide/${article.slug}/`}>
            <span>{article.category}</span>
            <h2>{article.title}</h2>
            <p>{article.subtitle}</p>
            <small>更新 {article.updated.replaceAll("-", ".")}</small>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
