---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publicGuideArticles } from "../../lib/editorial";

const templeGuideArticles = publicGuideArticles.filter((article) => article.slug !== "kisei-check");
---

<BaseLayout
  title="磐田市の菩提寺・墓じまい・永代供養ガイド｜ATAWI TEMPLE"
  description="磐田市で菩提寺を確認したい方、墓じまい・永代供養・法要前の確認をしたい方へ。寺院、墓、仏壇、実家の確認事項を中立に整理します。"
>
  <section class="page-title">
    <p class="eyebrow">Guide</p>
    <h1>菩提寺・墓じまい・永代供養の確認ガイド</h1>
    <p class="lead">寺院情報を調べる方へ。菩提寺、法要、檀家、墓じまい、永代供養、実家まわりの確認事項を、煽らず順番に整理します。</p>
  </section>

  <section class="section">
    <div class="article-card-grid">
      {
        templeGuideArticles.map((article) => (
          <a class="reading-card" href={`/guide/${article.slug}/`}>
            <span>{article.category}</span>
            <h2>{article.title}</h2>
            <p>{article.subtitle}</p>
            <small>更新 {article.updated.replaceAll("-", ".")}</small>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
